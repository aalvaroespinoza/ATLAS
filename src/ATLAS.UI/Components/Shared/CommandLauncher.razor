    private void ClearQuery()
    {
        query = string.Empty;
        searchResults.Clear();
        isInContextMenu = false;
    }

    private async Task Close()
    {
        IsOpen = false;
        query = string.Empty;
        searchResults.Clear();
        isInContextMenu = false;
        aiResponse = null;
        executionFeedback = null;
        await IsOpenChanged.InvokeAsync(false);
    }
}
