@namespace ATLAS.UI.Components.Shared
@using ATLAS.Core.Commands
@using ATLAS.Core.Entities
@using ATLAS.Core.Repositories
@using ATLAS.UI.Components.Common
@inject ICommandRegistry CommandRegistry
@inject INoteRepository NoteRepository
@inject IHabitRepository HabitRepository
@inject IRoadmapRepository RoadmapRepository
@inject ITransactionRepository TransactionRepository
@inject NavigationManager NavigationManager

@if (IsOpen)
{
    <!-- Backdrop Blur & Overlay -->
    <div class="fixed inset-0 z-50 flex items-start justify-center pt-16 md:pt-20 bg-black/75 backdrop-blur-md select-none animate-atlas-in" @onclick="Close">
        
        <!-- Modal Card (Raycast-Style Dark Glassmorphism) -->
        <div class="w-full max-w-2xl atlas-floating rounded-2xl overflow-hidden flex flex-col shadow-floating border border-white/[0.12]" @onclick:stopPropagation="true">
            
            <!-- 1. Top Search & Command Input Bar -->
            <div class="flex items-center gap-3 px-4 py-3.5 border-b border-white/[0.08] bg-[#0d111c]/90">
                <div class="w-7 h-7 rounded-xl bg-violet-500/15 border border-violet-500/30 flex items-center justify-center text-violet-300 font-mono text-xs font-bold shrink-0 shadow-glow-purple">
                    @if (query.TrimStart().StartsWith('?'))
                    {
                        <span>✨</span>
                    }
                    else if (query.TrimStart().StartsWith('/'))
                    {
                        <span>/</span>
                    }
                    else
                    {
                        <span>⌘</span>
                    }
                </div>
                
                <input 
                    @ref="inputElement"
                    type="text" 
                    value="@query"
                    @oninput="HandleInputChanged"
                    @onkeydown="HandleKeyDown"
                    placeholder="@GetInputPlaceholder()" 
                    class="w-full bg-transparent border-0 text-slate-100 text-sm placeholder-slate-500 focus:outline-none focus:ring-0 font-sans" />

                <!-- Mode Indicator Badge -->
                @if (query.TrimStart().StartsWith('?'))
                {
                    <AtlasBadge Variant="purple" Dot="true" Text="Modo IA" Class="hidden sm:inline-flex shrink-0" />
                }
                else if (query.TrimStart().StartsWith('/'))
                {
                    <AtlasBadge Variant="orange" Dot="true" Text="Comando" Class="hidden sm:inline-flex shrink-0" />
                }

                @if (isRunning)
                {
                    <svg class="animate-spin w-4 h-4 text-violet-400 shrink-0" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                    </svg>
                }
                else if (!string.IsNullOrWhiteSpace(query))
                {
                    <button type="button" @onclick="ClearQuery" class="text-slate-500 hover:text-white text-xs px-1 cursor-pointer">
                        ✕
                    </button>
                }
            </div>

            <!-- 2. Execution Feedback Banner (Error / Completed State) -->
            @if (!string.IsNullOrWhiteSpace(executionFeedback))
            {
                <div class="px-4 py-2.5 border-b border-white/[0.08] flex items-center justify-between text-xs font-medium animate-atlas-in @(isFeedbackSuccess ? "bg-emerald-500/15 text-emerald-300 border-emerald-500/30" : "bg-rose-500/15 text-rose-300 border-rose-500/30")">
                    <span class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full @(isFeedbackSuccess ? "bg-emerald-400 shadow-sm shadow-emerald-400" : "bg-rose-400 shadow-sm shadow-rose-400")"></span>
                        <span>@executionFeedback</span>
                    </span>
                    <button type="button" @onclick="() => executionFeedback = null" class="text-slate-400 hover:text-white text-xs cursor-pointer">✕</button>
                </div>
            }

            <!-- 3. AI Inline Answer Box (if prompt answered) -->
            @if (!string.IsNullOrWhiteSpace(aiResponse))
            {
                <div class="p-4 border-b border-white/[0.08] bg-[#0c101a] text-xs text-slate-200 leading-relaxed max-h-64 overflow-y-auto space-y-2 animate-atlas-in">
                    <div class="text-[10.5px] font-mono uppercase tracking-wider text-violet-400 font-semibold flex items-center justify-between">
                        <span class="flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-violet-400 shadow-glow-purple"></span>
                            <span>Respuesta ATLAS AI (Gemini):</span>
                        </span>
                        <button type="button" @onclick="() => aiResponse = null" class="text-slate-500 hover:text-slate-200 text-xs cursor-pointer">✕</button>
                    </div>
                    <div class="whitespace-pre-wrap font-sans text-slate-200 pl-4 border-l border-violet-500/30">
                        @aiResponse
                    </div>
                </div>
            }

            <!-- 4. Result List / Context Sub-menu -->
            <div class="max-h-80 overflow-y-auto p-2 space-y-1 scrollbar-none">
                
                @if (isInContextMenu && activeContextItem != null)
                {
                    <!-- CONTEXT ACTIONS SUB-MENU (Raycast Tab / Ctrl+K Action Menu) -->
                    <div class="p-2 space-y-1 animate-atlas-in">
                        <div class="px-2 py-1 flex items-center justify-between text-[11px] font-mono text-slate-400 border-b border-white/[0.06] pb-2 mb-1.5">
                            <span class="truncate">Acciones para: <strong class="text-white">@activeContextItem.Title</strong></span>
                            <span class="text-[10px] text-slate-500">Esc para volver</span>
                        </div>

                        @if (activeContextItem.ContextActions != null)
                        {
                            @for (int i = 0; i < activeContextItem.ContextActions.Count; i++)
                            {
                                var action = activeContextItem.ContextActions[i];
                                var isSel = i == contextSelectedIndex;
                                
                                <div 
                                    @onclick="() => ExecuteContextAction(action)"
                                    class="px-3.5 py-2.5 rounded-xl text-xs flex items-center justify-between cursor-pointer transition-all duration-120 @(isSel ? "bg-violet-500/15 text-white border border-violet-500/35 font-semibold shadow-sm shadow-violet-500/20" : "text-slate-300 hover:bg-white/[0.04] border border-transparent")">
                                    <span class="truncate">@action.Title</span>
                                    <kbd class="px-1.5 py-0.5 rounded-md bg-white/[0.06] text-[10px] font-mono text-slate-400">@action.Shortcut</kbd>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <!-- STATE 1: Initial Empty Suggestions -->
                    @if (searchResults.Count == 0 && string.IsNullOrWhiteSpace(query))
                    {
                        <div class="p-2 space-y-2">
                            <!-- Quick Chips -->
                            <div class="flex flex-wrap gap-2 pb-2">
                                <button type="button" @onclick="@(() => { query = "? "; })" class="px-2.5 py-1 rounded-full bg-violet-500/15 hover:bg-violet-500/25 text-violet-300 border border-violet-500/30 text-[11px] font-medium transition-all cursor-pointer">
                                    ✨ Preguntar a IA
                                </button>
                                <button type="button" @onclick="@(() => { query = "/expense "; })" class="px-2.5 py-1 rounded-full bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-300 border border-cyan-500/30 text-[11px] font-medium transition-all cursor-pointer">
                                    💳 Registrar Gasto
                                </button>
                                <button type="button" @onclick="@(() => { query = "/note "; })" class="px-2.5 py-1 rounded-full bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/30 text-[11px] font-medium transition-all cursor-pointer">
                                    ⚡ Capturar Nota
                                </button>
                            </div>

                            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block px-2 pt-1 font-semibold">Acciones sugeridas:</span>
                            @for (int i = 0; i < initialSuggestions.Count; i++)
                            {
                                var item = initialSuggestions[i];
                                var isSelected = i == selectedIndex;
                                <div 
                                    @onclick="item.PrimaryAction"
                                    class="px-3.5 py-2.5 rounded-xl text-xs flex items-center justify-between cursor-pointer transition-all duration-120 @(isSelected ? "bg-violet-500/15 text-white border border-violet-500/35 font-medium shadow-sm shadow-violet-500/20" : "text-slate-300 hover:bg-white/[0.04] border border-transparent")">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <AtlasBadge Variant="@item.BadgeVariant">@item.Category</AtlasBadge>
                                        <span class="font-medium text-slate-200 truncate">@item.Title</span>
                                    </div>
                                    <span class="text-[10.5px] font-mono text-slate-500">@item.Subtitle</span>
                                </div>
                            }
                        </div>
                    }
                    <!-- STATE 2: Fallback Action (Instant Note Capture) -->
                    else if (searchResults.Count == 0 && !string.IsNullOrWhiteSpace(query) && !query.TrimStart().StartsWith('?'))
                    {
                        <div class="p-2">
                            <div 
                                @onclick="ExecuteFallbackCaptureAsync"
                                class="px-4 py-3 rounded-xl bg-violet-500/10 text-xs flex items-center justify-between text-slate-200 border border-violet-500/25 hover:bg-violet-500/20 cursor-pointer transition-all shadow-sm">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <span class="text-violet-400 font-mono font-bold text-sm">↵</span>
                                    <span>Capturar como nueva nota: <strong class="text-white font-medium truncate">"@query"</strong></span>
                                </div>
                                <kbd class="px-1.5 py-0.5 rounded-md bg-violet-500/20 text-[10px] font-mono text-violet-300 border border-violet-400/30">Enter</kbd>
                            </div>
                        </div>
                    }
                    <!-- STATE 3: Grouped Search Results -->
                    else
                    {
                        @for (int i = 0; i < searchResults.Count; i++)
                        {
                            var index = i;
                            var item = searchResults[i];
                            var isSelected = index == selectedIndex;

                            <div 
                                @onclick="() => ExecuteResultItem(item)"
                                class="px-3.5 py-2.5 rounded-xl text-xs flex items-center justify-between cursor-pointer transition-all duration-120 @(isSelected ? "bg-violet-500/15 text-white border border-violet-500/35 font-medium shadow-sm shadow-violet-500/20" : "text-slate-300 hover:bg-white/[0.03] border border-transparent")">
                                
                                <div class="flex items-center gap-2.5 min-w-0 flex-1">
                                    <AtlasBadge Variant="@item.BadgeVariant">@item.Category</AtlasBadge>
                                    <span class="truncate @(isSelected ? "text-white font-semibold" : "text-slate-200")">
                                        @item.Title
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                    {
                                        <span class="text-[11px] text-slate-500 truncate hidden sm:inline">
                                            • @item.Subtitle
                                        </span>
                                    }
                                </div>

                                <div class="flex items-center gap-2 shrink-0 pl-2">
                                    @if (item.ContextActions != null && item.ContextActions.Count > 0)
                                    {
                                        <button 
                                            type="button" 
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenContextMenu(item)"
                                            class="text-[9.5px] font-mono px-1.5 py-0.5 rounded bg-white/[0.06] text-slate-400 hover:text-white hover:bg-white/[0.1] transition-colors cursor-pointer">
                                            Acciones (Tab)
                                        </button>
                                    }

                                    @if (isSelected)
                                    {
                                        <kbd class="px-1.5 py-0.5 rounded-md bg-violet-500/20 text-[10px] font-mono text-violet-200 border border-violet-400/30">↵</kbd>
                                    }
                                </div>
                            </div>
                        }
                    }
                }

            </div>

            <!-- 5. Footer Bar with Raycast-Style Cheatsheet -->
            <div class="px-4 py-2.5 border-t border-white/[0.06] bg-[#0c101a] flex items-center justify-between text-[11px] text-slate-400 font-mono select-none">
                <div class="flex items-center gap-3">
                    <span><kbd class="px-1.5 py-0.5 rounded bg-white/[0.06] text-slate-300 text-[10px]">↑</kbd> <kbd class="px-1.5 py-0.5 rounded bg-white/[0.06] text-slate-300 text-[10px]">↓</kbd> Navegar</span>
                    <span><kbd class="px-1.5 py-0.5 rounded bg-white/[0.06] text-slate-300 text-[10px]">↵</kbd> Ejecutar</span>
                    <span><kbd class="px-1.5 py-0.5 rounded bg-white/[0.06] text-slate-300 text-[10px]">Tab</kbd> Acciones</span>
                    <span><kbd class="px-1.5 py-0.5 rounded bg-white/[0.06] text-slate-300 text-[10px]">?</kbd> IA</span>
                </div>
                <span class="text-violet-400/80 font-bold">Ctrl+Space</span>
            </div>

        </div>

    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private ElementReference inputElement;
    private string query = string.Empty;
    private int selectedIndex = 0;
    private int contextSelectedIndex = 0;
    private bool isRunning;
    private string? executionFeedback;
    private bool isFeedbackSuccess;
    private string? aiResponse;

    // Submenu Context State
    private bool isInContextMenu = false;
    private LauncherResultItem? activeContextItem;

    // Models
    public record ContextActionItem(string Title, string Shortcut, Func<Task> Action);
    public record LauncherResultItem(
        string Id,
        string Title,
        string Subtitle,
        string Category,
        string BadgeVariant,
        Func<Task> PrimaryAction,
        List<ContextActionItem>? ContextActions = null
    );

    private List<ICommand> allCommands = [];
    private List<LauncherResultItem> searchResults = [];
    private List<LauncherResultItem> initialSuggestions = [];

    protected override void OnInitialized()
    {
        allCommands = CommandRegistry.GetAllCommands().ToList();
        BuildInitialSuggestions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen)
        {
            try
            {
                await inputElement.FocusAsync();
            }
            catch { }
        }
    }

    private string GetInputPlaceholder()
    {
        if (isInContextMenu) return "Elegí una acción...";
        return "¿Qué querés hacer o buscar?... (Escribí texto, '?' para IA o '/expense')";
    }

    private void BuildInitialSuggestions()
    {
        initialSuggestions = new List<LauncherResultItem>
        {
            new LauncherResultItem("capture.note", "Capturar Nota Rápida", "Guardar pensamiento en SQLite", "Comando", "purple", () => { query = "/note "; return Task.CompletedTask; }),
            new LauncherResultItem("ai.ask", "Preguntar a Gemini AI", "Escribí '? <tu consulta>'", "IA", "purple", () => { query = "? "; return Task.CompletedTask; }),
            new LauncherResultItem("habit.complete", "Ver Hábitos & Metas", "Registrar progreso del día", "Hábito", "emerald", () => { NavigationManager.NavigateTo("habits-goals"); return Close(); }),
            new LauncherResultItem("finance.add", "Registrar Gasto", "Formato: /expense <monto> <desc>", "Finanza", "cyan", () => { query = "/expense "; return Task.CompletedTask; }),
            new LauncherResultItem("knowledge.search", "Explorador Universal", "Búsqueda en Segundo Cerebro", "Búsqueda", "neutral", () => { NavigationManager.NavigateTo("search"); return Close(); })
        };
    }

    private async Task HandleInputChanged(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? string.Empty;
        selectedIndex = 0;
        isInContextMenu = false;
        await PerformSearchAsync();
    }

    private async Task PerformSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            searchResults.Clear();
            return;
        }

        var trimmed = query.Trim();
        var results = new List<LauncherResultItem>();

        // 1. If starts with '?', AI query mode
        if (trimmed.StartsWith("?"))
        {
            searchResults.Clear();
            return;
        }

        // 2. Search matching Commands
        var matchingCmds = allCommands
            .Where(c => c.Id.Contains(trimmed, StringComparison.OrdinalIgnoreCase) ||
                        c.Name.Contains(trimmed, StringComparison.OrdinalIgnoreCase) ||
                        c.Description.Contains(trimmed, StringComparison.OrdinalIgnoreCase))
            .Take(3);

        foreach (var cmd in matchingCmds)
        {
            var cmdId = cmd.Id;
            results.Add(new LauncherResultItem(
                cmd.Id,
                cmd.Name,
                cmd.Description,
                "Comando",
                "purple",
                () => ExecuteCommandDirectAsync(cmdId)
            ));
        }

        // 3. Search matching Notes (SQLite)
        try
        {
            var notes = await NoteRepository.SearchAsync(trimmed, 3);
            foreach (var note in notes)
            {
                var title = !string.IsNullOrWhiteSpace(note.Title) ? note.Title : (note.Content.Length > 40 ? note.Content[..40] + "..." : note.Content);
                var noteObj = note;

                results.Add(new LauncherResultItem(
                    note.Id,
                    title,
                    note.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm"),
                    "Nota",
                    "neutral",
                    () => { NavigationManager.NavigateTo($"search?q={Uri.EscapeDataString(noteObj.Title ?? noteObj.Content)}"); return Close(); },
                    new List<ContextActionItem>
                    {
                        new ContextActionItem("✨ Resumir con Gemini", "↵", async () => await SummarizeNoteAsync(noteObj)),
                        new ContextActionItem("↗ Abrir en Segundo Cerebro", "↵", () => { NavigationManager.NavigateTo("search"); return Close(); })
                    }
                ));
            }
        }
        catch { }

        // 4. Search matching Habits (SQLite)
        try
        {
            var habits = await HabitRepository.GetAllAsync();
            var matchingHabits = habits.Where(h => h.Name.Contains(trimmed, StringComparison.OrdinalIgnoreCase)).Take(2);
            foreach (var habit in matchingHabits)
            {
                var hObj = habit;
                results.Add(new LauncherResultItem(
                    habit.Id,
                    habit.Name,
                    $"Frecuencia: {habit.Frequency}",
                    "Hábito",
                    "emerald",
                    async () => await CompleteHabitFromLauncher(hObj.Id, hObj.Name),
                    new List<ContextActionItem>
                    {
                        new ContextActionItem("✓ Marcar completado hoy", "↵", async () => await CompleteHabitFromLauncher(hObj.Id, hObj.Name)),
                        new ContextActionItem("↗ Ver en Metas & Hábitos", "↵", () => { NavigationManager.NavigateTo("habits-goals"); return Close(); })
                    }
                ));
            }
        }
        catch { }

        // 5. Search matching Roadmaps (SQLite)
        try
        {
            var roadmaps = await RoadmapRepository.GetAllAsync();
            var matchingRoadmaps = roadmaps.Where(r => r.Title.Contains(trimmed, StringComparison.OrdinalIgnoreCase)).Take(2);
            foreach (var roadmap in matchingRoadmaps)
            {
                results.Add(new LauncherResultItem(
                    roadmap.Id,
                    roadmap.Title,
                    $"Progreso: {roadmap.ProgressPercentage}%",
                    "Roadmap",
                    "orange",
                    () => { NavigationManager.NavigateTo("habits-goals"); return Close(); }
                ));
            }
        }
        catch { }

        searchResults = results;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (isInContextMenu)
            {
                isInContextMenu = false;
                activeContextItem = null;
                return;
            }
            if (!string.IsNullOrWhiteSpace(query))
            {
                query = string.Empty;
                searchResults.Clear();
                return;
            }
            await Close();
            return;
        }

        // Submenu navigation
        if (isInContextMenu && activeContextItem?.ContextActions != null)
        {
            var maxIdx = activeContextItem.ContextActions.Count - 1;
            if (e.Key == "ArrowDown")
            {
                contextSelectedIndex = contextSelectedIndex < maxIdx ? contextSelectedIndex + 1 : 0;
                return;
            }
            if (e.Key == "ArrowUp")
            {
                contextSelectedIndex = contextSelectedIndex > 0 ? contextSelectedIndex - 1 : maxIdx;
                return;
            }
            if (e.Key == "Enter")
            {
                if (activeContextItem.ContextActions.Count > contextSelectedIndex)
                {
                    await ExecuteContextAction(activeContextItem.ContextActions[contextSelectedIndex]);
                }
                return;
            }
            return;
        }

        // Main List navigation
        var activeListCount = searchResults.Count > 0 ? searchResults.Count : (string.IsNullOrWhiteSpace(query) ? initialSuggestions.Count : 0);

        if (e.Key == "ArrowDown" && activeListCount > 0)
        {
            selectedIndex = (selectedIndex + 1) % activeListCount;
            return;
        }

        if (e.Key == "ArrowUp" && activeListCount > 0)
        {
            selectedIndex = (selectedIndex - 1 + activeListCount) % activeListCount;
            return;
        }

        // Tab or Ctrl+K triggers context submenu
        if (e.Key == "Tab" || (e.CtrlKey && (e.Key == "k" || e.Key == "K")))
        {
            if (searchResults.Count > selectedIndex && searchResults[selectedIndex].ContextActions?.Count > 0)
            {
                OpenContextMenu(searchResults[selectedIndex]);
            }
            return;
        }

        // Enter submits current selection, command or AI prompt
        if (e.Key == "Enter")
        {
            var trimmed = query.Trim();

            // 1. AI Prompt Dispatch
            if (trimmed.StartsWith("?"))
            {
                await ExecuteAiPromptAsync(trimmed[1..].Trim());
                return;
            }

            // 2. Direct /expense or /gasto command
            if (trimmed.StartsWith("/expense", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("/gasto", StringComparison.OrdinalIgnoreCase))
            {
                await ExecuteExpenseAsync(trimmed);
                return;
            }

            // 3. Direct /note or /nota command
            if (trimmed.StartsWith("/note", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("/nota", StringComparison.OrdinalIgnoreCase))
            {
                var content = trimmed.Contains(' ') ? trimmed[(trimmed.IndexOf(' ') + 1)..] : trimmed;
                await ExecuteCaptureNoteAsync(content);
                return;
            }

            // 4. Highlighted result execution
            if (searchResults.Count > selectedIndex)
            {
                await ExecuteResultItem(searchResults[selectedIndex]);
                return;
            }

            // 5. Initial suggestion execution
            if (string.IsNullOrWhiteSpace(query) && initialSuggestions.Count > selectedIndex)
            {
                await initialSuggestions[selectedIndex].PrimaryAction();
                return;
            }

            // 6. Fallback quick capture
            if (!string.IsNullOrWhiteSpace(query))
            {
                await ExecuteFallbackCaptureAsync();
                return;
            }
        }
    }

    private void OpenContextMenu(LauncherResultItem item)
    {
        activeContextItem = item;
        contextSelectedIndex = 0;
        isInContextMenu = true;
    }

    private async Task ExecuteContextAction(ContextActionItem action)
    {
        isInContextMenu = false;
        activeContextItem = null;
        await action.Action();
    }

    private async Task ExecuteResultItem(LauncherResultItem item)
    {
        await item.PrimaryAction();
    }

    private async Task ExecuteFallbackCaptureAsync()
    {
        await ExecuteCaptureNoteAsync(query.Trim());
    }

    private async Task ExecuteCaptureNoteAsync(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return;

        isRunning = true;
        try
        {
            var result = await CommandRegistry.ExecuteAsync(CaptureNoteCommand.CommandId, new Dictionary<string, object?>
            {
                ["content"] = content,
                ["source"] = "command_launcher"
            });

            isFeedbackSuccess = result.IsSuccess;
            executionFeedback = result.IsSuccess ? "Nota guardada en SQLite local." : (result.ErrorMessage ?? "Error al guardar");
            if (result.IsSuccess) query = string.Empty;
        }
        catch (Exception ex)
        {
            isFeedbackSuccess = false;
            executionFeedback = ex.Message;
        }
        finally
        {
            isRunning = false;
        }
    }

    private async Task ExecuteExpenseAsync(string text)
    {
        isRunning = true;
        try
        {
            var result = await CommandRegistry.ExecuteAsync(FinanceAddTransactionCommand.CommandId, new Dictionary<string, object?>
            {
                ["text"] = text
            });

            isFeedbackSuccess = result.IsSuccess;
            executionFeedback = result.IsSuccess ? "Gasto registrado exitosamente." : (result.ErrorMessage ?? "Error al registrar gasto");
            if (result.IsSuccess) query = string.Empty;
        }
        catch (Exception ex)
        {
            isFeedbackSuccess = false;
            executionFeedback = ex.Message;
        }
        finally
        {
            isRunning = false;
        }
    }

    private async Task ExecuteAiPromptAsync(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt)) return;

        isRunning = true;
        try
        {
            var result = await CommandRegistry.ExecuteAsync(AiAskCommand.CommandId, new Dictionary<string, object?>
            {
                ["question"] = prompt
            });

            if (result.IsSuccess && result.Data is string answer)
            {
                aiResponse = answer;
                executionFeedback = null;
            }
            else
            {
                isFeedbackSuccess = false;
                executionFeedback = result.ErrorMessage ?? "No se pudo obtener respuesta de IA.";
            }
        }
        catch (Exception ex)
        {
            isFeedbackSuccess = false;
            executionFeedback = ex.Message;
        }
        finally
        {
            isRunning = false;
        }
    }

    private async Task ExecuteCommandDirectAsync(string commandId)
    {
        isRunning = true;
        try
        {
            var result = await CommandRegistry.ExecuteAsync(commandId, new Dictionary<string, object?>());
            isFeedbackSuccess = result.IsSuccess;
            executionFeedback = result.IsSuccess ? $"Comando '{commandId}' ejecutado." : (result.ErrorMessage ?? "Error");
        }
        catch (Exception ex)
        {
            isFeedbackSuccess = false;
            executionFeedback = ex.Message;
        }
        finally
        {
            isRunning = false;
        }
    }

