@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ICommandRegistry CommandRegistry

<div class="flex h-screen w-screen bg-[#090b10] text-slate-100 antialiased overflow-hidden font-sans select-none p-3 gap-3"
     tabindex="0"
     @onkeydown="HandleGlobalKeyDown">
    
    <!-- 1. FLOATING PERSONAL DOCK (Left Island) -->
    <AtlasPersonalDock 
        @bind-IsExpanded="isDockExpanded"
        OnQuickCapture="() => isQuickCaptureOpen = true"
        OnCommandLauncher="() => isLauncherOpen = true" />

    <!-- 2. MAIN APPLICATION WORKSPACE (Floating Canvas Island) -->
    <div class="flex-1 flex flex-col min-w-0 h-[calc(100vh-24px)] rounded-2xl bg-[#0e121b] border border-white/[0.07] overflow-hidden shadow-xl shadow-black/50">
        
        <!-- Minimalist Header (38px) -->
        <header class="h-[38px] shrink-0 px-5 flex items-center justify-between border-b border-white/[0.06] bg-[#0c1017]">
            
            <!-- Left: Breadcrumb / Spatial Context -->
            <div class="flex items-center gap-2 text-[11px] font-mono text-slate-400">
                <span class="text-slate-600 hidden sm:inline">atlas /</span>
                <span class="text-slate-200 font-medium tracking-tight">@GetContextPath()</span>
            </div>
            
            <!-- Center/Right: Quick Search / Command Pill Trigger -->
            <div class="flex items-center gap-3">
                <button 
                    type="button"
                    @onclick="() => isLauncherOpen = true"
                    class="flex items-center gap-2 px-3 py-1 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] active:bg-white/[0.10] border border-white/[0.06] text-[11px] font-mono text-slate-400 hover:text-slate-200 transition-colors cursor-pointer atlas-clickable group"
                    title="Abrir Centro de Comandos (Ctrl+Space)">
                    <svg class="w-3 h-3 text-indigo-400 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span class="hidden sm:inline">Comandos o búsqueda</span>
                    <kbd class="px-1 py-0.2 rounded bg-white/[0.06] text-[9px] text-slate-300 font-mono">Ctrl+Space</kbd>
                </button>

                <div class="hidden sm:flex items-center gap-1.5 text-[10px] font-mono text-slate-500 pl-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>local</span>
                </div>
            </div>

        </header>

        <!-- Scrollable View Canvas (Optimal Reading Width & Rhythm) -->
        <main class="flex-1 overflow-y-auto overflow-x-hidden p-6 md:p-8">
            <div class="max-w-4xl mx-auto">
                @Body
            </div>
        </main>

    </div>

    <!-- 3. UNIVERSAL COMMAND LAUNCHER MODAL -->
    <CommandLauncher @bind-IsOpen="isLauncherOpen" />

    <!-- 4. QUICK CAPTURE MODAL OVERLAY (⚡) -->
    @if (isQuickCaptureOpen)
    {
        <div class="fixed inset-0 z-50 flex items-start justify-center pt-24 bg-black/60 backdrop-blur-sm animate-atlas-in" @onclick="() => isQuickCaptureOpen = false">
            <div class="w-full max-w-lg atlas-elevated rounded-2xl p-5 space-y-4 shadow-2xl shadow-black" @onclick:stopPropagation="true">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-5 h-5 rounded-lg bg-indigo-500/20 flex items-center justify-center text-indigo-300 text-xs">
                            ⚡
                        </div>
                        <h3 class="text-xs font-semibold text-white">Captura Rápida de Pensamiento</h3>
                    </div>
                    <kbd class="px-1.5 py-0.5 rounded text-[9.5px] font-mono text-slate-500">Esc</kbd>
                </div>

                <textarea 
                    @bind="quickCaptureText" 
                    rows="3" 
                    placeholder="Escribí una idea, nota o recordatorio..." 
                    class="w-full p-3 rounded-xl bg-white/[0.03] border border-white/[0.08] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/30 transition-all font-sans resize-none"></textarea>

                <div class="flex items-center justify-between pt-1">
                    <span class="text-[10px] font-mono text-slate-500">Guardado directo en SQLite local</span>
                    <div class="flex items-center gap-2">
                        <AtlasButton Variant="ghost" Size="sm" OnClick="() => isQuickCaptureOpen = false">Cancelar</AtlasButton>
                        <AtlasButton Variant="primary" Size="sm" ShortcutText="↵" OnClick="SubmitQuickCapture" IsLoading="isCapturing">Guardar Nota</AtlasButton>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private bool isLauncherOpen;
    private bool isQuickCaptureOpen;
    private bool isDockExpanded = false;
    private string quickCaptureText = string.Empty;
    private bool isCapturing;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += (s, e) => StateHasChanged();
    }

    private string GetContextPath()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(relative)) return "inicio";
        if (relative.StartsWith("search") || relative.StartsWith("brain") || relative.StartsWith("capture")) return "segundo-cerebro";
        if (relative.StartsWith("habits-goals")) return "habitos-metas";
        if (relative.StartsWith("finance")) return "finanzas";
        if (relative.StartsWith("settings")) return "ajustes";
        if (relative.StartsWith("dock-prototype")) return "prototipo-dock";
        if (relative.StartsWith("design-system")) return "design-system";
        return relative;
    }

    private async Task SubmitQuickCapture()
    {
        if (string.IsNullOrWhiteSpace(quickCaptureText) || isCapturing) return;

        isCapturing = true;
        try
        {
            await CommandRegistry.ExecuteAsync(CaptureNoteCommand.CommandId, new Dictionary<string, object?>
            {
                ["content"] = quickCaptureText.Trim(),
                ["source"] = "quick_capture"
            });
            quickCaptureText = string.Empty;
            isQuickCaptureOpen = false;
        }
        catch { }
        finally
        {
            isCapturing = false;
        }
    }

    private void HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        // 1. Command Launcher Toggle (Ctrl+Space / Ctrl+K)
        if ((e.CtrlKey && e.Key == " ") || (e.CtrlKey && (e.Key == "k" || e.Key == "K")))
        {
            isLauncherOpen = !isLauncherOpen;
            return;
        }

        // 2. Quick Capture (Ctrl+N)
        if (e.CtrlKey && (e.Key == "n" || e.Key == "N"))
        {
            isQuickCaptureOpen = !isQuickCaptureOpen;
            return;
        }

        // 3. Toggle Dock Expand/Compact (Alt+D)
        if (e.AltKey && (e.Key == "d" || e.Key == "D"))
        {
            isDockExpanded = !isDockExpanded;
            return;
        }

        // 4. Alt + Number Navigation (Alt+1 to Alt+5)
        if (e.AltKey)
        {
            switch (e.Key)
            {
                case "1": NavigationManager.NavigateTo(""); break;
                case "2": NavigationManager.NavigateTo("search"); break;
                case "3": NavigationManager.NavigateTo("habits-goals"); break;
                case "4": NavigationManager.NavigateTo("finance"); break;
                case "5": NavigationManager.NavigateTo("settings"); break;
            }
        }
    }
}
