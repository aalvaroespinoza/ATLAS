@inherits LayoutComponentBase

<div class="flex h-screen w-screen bg-[#090d16] text-slate-100 antialiased overflow-hidden font-sans">
    
    <!-- Sticky Glassmorphic Sidebar -->
    <NavMenu />

    <!-- Main Content Canvas -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden bg-gradient-to-br from-slate-950 via-[#090d16] to-slate-950">
        
        <!-- Top App Bar with Subtle Accent Glow -->
        <header class="h-14 shrink-0 px-8 flex items-center justify-between border-b border-slate-800/60 bg-slate-950/40 backdrop-blur-xl">
            <div class="flex items-center gap-3 text-xs text-slate-400">
                <span class="w-2 h-2 rounded-full bg-sky-400/80"></span>
                <span class="font-medium tracking-wide text-slate-300 uppercase text-[10px]">ATLAS Personal Workspace</span>
            </div>
            
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-900/60 border border-slate-800 text-[11px] text-slate-400">
                    <span class="text-slate-500">Acceso rápido:</span>
                    <kbd class="font-mono text-[10px] text-slate-300 font-semibold">Ctrl + Space</kbd>
                </div>
            </div>
        </header>

        <!-- Scrollable Dynamic View Area -->
        <main class="flex-1 overflow-y-auto overflow-x-hidden p-8">
            <div class="max-w-6xl mx-auto">
                @Body
            </div>
        </main>

    </div>

</div>
