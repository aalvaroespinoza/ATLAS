@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ICommandRegistry CommandRegistry
@inject IJSRuntime JSRuntime
@inject ATLAS.Storage.Database.DatabaseInitializer DatabaseInitializer

<div class="flex h-screen w-screen atlas-canvas text-slate-100 antialiased overflow-hidden font-sans select-none p-3 gap-3"
     tabindex="0">
    
    <!-- 1. FLOATING PERSONAL DOCK (Left Island) -->
    <AtlasPersonalDock 
        @bind-IsExpanded="isDockExpanded"
        OnQuickCapture="() => isQuickCaptureOpen = true"
        OnCommandLauncher="() => isLauncherOpen = true" />

    <!-- 2. MAIN APPLICATION WORKSPACE (Floating Canvas Island) -->
    <div class="flex-1 flex flex-col min-w-0 h-[calc(100vh-24px)] rounded-2xl bg-[#0c101a]/95 border border-white/[0.08] overflow-hidden shadow-2xl shadow-black/80 relative z-10">
        
        @if (!isDbReady)
        {
            <div class="flex-1 flex items-center justify-center">
                <div class="flex flex-col items-center gap-4">
                    <svg class="animate-spin w-8 h-8 text-violet-500/50" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                    </svg>
                    <span class="text-xs text-slate-500 animate-pulse font-mono tracking-widest uppercase">Iniciando ATLAS OS...</span>
                </div>
            </div>
        }
        else
        {
            <!-- Scrollable View Canvas (Optimal Reading Width & Rhythm) -->
            <main class="flex-1 overflow-y-auto overflow-x-hidden p-6 pb-24 md:p-8 md:pb-24">
                <div class="max-w-5xl mx-auto">
                    @Body
                </div>
            </main>
        }

    </div>

    <!-- 3. UNIVERSAL COMMAND LAUNCHER MODAL -->
    @if (isDbReady)
    {
        <CommandLauncher @bind-IsOpen="isLauncherOpen" />
    }

    <!-- 4. QUICK CAPTURE MODAL OVERLAY (⚡) -->
    @if (isQuickCaptureOpen && isDbReady)
    {
        <div class="fixed inset-0 z-50 flex items-start justify-center pt-24 bg-black/70 backdrop-blur-md animate-atlas-in" @onclick="() => isQuickCaptureOpen = false">
            <div class="w-full max-w-lg atlas-elevated rounded-2xl p-5 space-y-4 shadow-floating" @onclick:stopPropagation="true">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-lg bg-violet-500/20 border border-violet-500/30 flex items-center justify-center text-violet-300 text-xs shadow-glow-purple">
                            ⚡
                        </div>
                        <h3 class="text-xs font-semibold text-white">Captura Rápida de Pensamiento</h3>
                    </div>
                    <kbd class="px-1.5 py-0.5 rounded text-[9.5px] font-mono text-slate-500 bg-white/[0.06]">Esc</kbd>
                </div>

                <textarea 
                    @bind="quickCaptureText" 
                    rows="3" 
                    placeholder="Escribí una idea, nota o recordatorio..." 
                    class="w-full p-3.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-violet-500/50 focus:ring-1 focus:ring-violet-500/30 transition-all font-sans resize-none"></textarea>

                <div class="flex items-center justify-between pt-1">
                    <span class="text-[10px] font-mono text-slate-500">Guardado directo en SQLite local</span>
                    <div class="flex items-center gap-2">
                        <AtlasButton Variant="ghost" Size="sm" OnClick="() => isQuickCaptureOpen = false">Cancelar</AtlasButton>
                        <AtlasButton Variant="primary" Size="sm" ShortcutText="↵" OnClick="SubmitQuickCapture" IsLoading="isCapturing">Guardar Nota</AtlasButton>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private bool isLauncherOpen;
    private bool isQuickCaptureOpen;
    private bool isDockExpanded = false;
    private string quickCaptureText = string.Empty;
    private bool isCapturing;

    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private bool isDbReady = false;

    protected override async Task OnInitializedAsync()
    {
        await DatabaseInitializer.InitializeAsync();
        isDbReady = true;
        NavigationManager.LocationChanged += (s, e) => StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("atlasKeyboard.init", _dotNetRef);
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    private async Task SubmitQuickCapture()
    {
        if (string.IsNullOrWhiteSpace(quickCaptureText) || isCapturing) return;

        isCapturing = true;
        try
        {
            await CommandRegistry.ExecuteAsync(CaptureNoteCommand.CommandId, new Dictionary<string, object?>
            {
                ["content"] = quickCaptureText.Trim(),
                ["source"] = "quick_capture"
            });
            quickCaptureText = string.Empty;
            isQuickCaptureOpen = false;
        }
        catch { }
        finally
        {
            isCapturing = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void HandleShortcut(string shortcut)
    {
        switch (shortcut)
        {
            case "ctrl+space":
            case "ctrl+k":
                isLauncherOpen = !isLauncherOpen;
                StateHasChanged();
                break;
            case "ctrl+n":
                isQuickCaptureOpen = !isQuickCaptureOpen;
                StateHasChanged();
                break;
            case "alt+d":
                isDockExpanded = !isDockExpanded;
                StateHasChanged();
                break;
            case "alt+1": NavigationManager.NavigateTo(""); break;
            case "alt+2": NavigationManager.NavigateTo("search"); break;
            case "alt+3": NavigationManager.NavigateTo("capture"); break;
            case "alt+4": NavigationManager.NavigateTo("habits-goals"); break;
            case "alt+5": NavigationManager.NavigateTo("finance"); break;
            case "alt+6": NavigationManager.NavigateTo("settings"); break;
        }
    }
}
