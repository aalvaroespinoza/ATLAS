@namespace ATLAS.UI.Components.Common
@inject NavigationManager NavigationManager

<!-- Personal Dock Container (Refined Floating Island) -->
<aside 
    class="flex flex-col justify-between p-2.5 rounded-2xl bg-[#10141e] border border-white/[0.08] shadow-2xl shadow-black/80 transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] select-none shrink-0 h-[calc(100vh-24px)] my-auto @(IsExpanded ? "w-52" : "w-14") @Class">
    
    <!-- TOP: Brand & Quick Action Hub -->
    <div class="space-y-4">
        
        <!-- Brand / Expand Toggle (Sleek Monogram) -->
        <div class="flex items-center justify-between px-1">
            <button 
                type="button" 
                @onclick="ToggleExpand"
                class="w-full flex items-center gap-2.5 p-1.5 rounded-xl hover:bg-white/[0.05] active:scale-95 transition-all cursor-pointer group"
                title="@(IsExpanded ? "Contraer Dock (Alt+D)" : "Expandir Dock (Alt+D)")">
                
                <!-- Animated Monogram -->
                <div class="w-7 h-7 rounded-xl bg-indigo-600/90 border border-indigo-400/30 flex items-center justify-center text-white font-mono font-bold text-xs shadow-md shadow-indigo-500/25 group-hover:bg-indigo-500 transition-colors shrink-0">
                    A
                </div>

                @if (IsExpanded)
                {
                    <div class="flex items-center justify-between flex-1 min-w-0 animate-atlas-in">
                        <div class="flex flex-col text-left">
                            <span class="text-xs font-bold tracking-tight text-white leading-tight">ATLAS</span>
                            <span class="text-[9px] font-mono text-indigo-300">personal os</span>
                        </div>
                        <span class="text-[10px] text-slate-500 group-hover:text-slate-300 transition-colors">◀</span>
                    </div>
                }
            </button>
        </div>

        <!-- QUICK ACTION TOOLS (Tactile Hero Pills) -->
        <div class="space-y-1.5 px-0.5">
            
            <!-- Quick Capture Trigger (⚡) -->
            <AtlasTooltip Text="Captura Rápida" Shortcut="Ctrl+N" Position="right">
                <button 
                    type="button"
                    @onclick="TriggerQuickCapture"
                    class="w-full flex items-center gap-2.5 px-2 py-2 rounded-xl bg-indigo-500/10 hover:bg-indigo-500/20 active:bg-indigo-500/30 border border-indigo-500/25 text-indigo-200 hover:text-white transition-all cursor-pointer atlas-clickable group">
                    <div class="w-5 h-5 flex items-center justify-center text-indigo-300 group-hover:scale-110 transition-transform shrink-0">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    @if (IsExpanded)
                    {
                        <div class="flex items-center justify-between flex-1 min-w-0 animate-atlas-in">
                            <span class="text-xs font-semibold truncate">Capturar</span>
                            <kbd class="text-[9px] font-mono text-indigo-300 opacity-60">Ctrl+N</kbd>
                        </div>
                    }
                </button>
            </AtlasTooltip>

            <!-- Command Launcher Trigger (⌘) -->
            <AtlasTooltip Text="Comandos & Búsqueda" Shortcut="Ctrl+Space" Position="right">
                <button 
                    type="button"
                    @onclick="TriggerCommandLauncher"
                    class="w-full flex items-center gap-2.5 px-2 py-2 rounded-xl bg-white/[0.03] hover:bg-white/[0.08] active:bg-white/[0.12] border border-white/[0.06] text-slate-300 hover:text-white transition-all cursor-pointer atlas-clickable group">
                    <div class="w-5 h-5 flex items-center justify-center text-slate-400 group-hover:text-slate-200 group-hover:scale-110 transition-transform shrink-0 font-mono text-xs font-bold">
                        ⌘
                    </div>
                    @if (IsExpanded)
                    {
                        <div class="flex items-center justify-between flex-1 min-w-0 animate-atlas-in">
                            <span class="text-xs font-medium truncate">Comandos</span>
                            <kbd class="text-[9px] font-mono text-slate-500">Space</kbd>
                        </div>
                    }
                </button>
            </AtlasTooltip>

        </div>

        <!-- CENTER: CURATED 4 CORE SPACES (Pure Spatial Rhythm, No Harsh Divider Borders) -->
        <nav class="space-y-1 pt-1" aria-label="Espacios personales">
            
            <!-- 1. Inicio -->
            <AtlasTooltip Text="Inicio" Shortcut="Alt+1" Position="right">
                <NavLink href="" Match="NavLinkMatch.All" class="group flex items-center gap-2.5 px-2 py-2 rounded-xl text-xs font-medium transition-all text-slate-400 hover:text-slate-100 hover:bg-white/[0.04] [&.active]:bg-indigo-500/15 [&.active]:text-indigo-200 [&.active]:border [&.active]:border-indigo-500/30 [&.active]:font-semibold">
                    <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                        <svg class="w-4 h-4 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                    </div>
                    @if (IsExpanded)
                    {
                        <div class="flex items-center justify-between flex-1 min-w-0 animate-atlas-in">
                            <span class="truncate">Inicio</span>
                            <kbd class="text-[9px] font-mono opacity-40 group-hover:opacity-100">1</kbd>
                        </div>
                    }
                </NavLink>
            </AtlasTooltip>

            <!-- 2. Segundo Cerebro -->
            <AtlasTooltip Text="Segundo Cerebro" Shortcut="Alt+2" Position="right">
                <NavLink href="search" class="group flex items-center gap-2.5 px-2 py-2 rounded-xl text-xs font-medium transition-all text-slate-400 hover:text-slate-100 hover:bg-white/[0.04] [&.active]:bg-indigo-500/15 [&.active]:text-indigo-200 [&.active]:border [&.active]:border-indigo-500/30 [&.active]:font-semibold">
                    <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                        <svg class="w-4 h-4 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    @if (IsExpanded)
                    {
                        <div class="flex items-center justify-between flex-1 min-w-0 animate-atlas-in">
                            <span class="truncate">Segundo Cerebro</span>
                            <kbd class="text-[9px] font-mono opacity-40 group-hover:opacity-100">2</kbd>
                        </div>
                    }
                </NavLink>
            </AtlasTooltip>

            <!-- 3. Hábitos & Metas -->
            <AtlasTooltip Text="Hábitos & Metas" Shortcut="Alt+3" Position="right">
                <NavLink href="habits-goals" class="group flex items-center gap-2.5 px-2 py-2 rounded-xl text-xs font-medium transition-all text-slate-400 hover:text-slate-100 hover:bg-white/[0.04] [&.active]:bg-indigo-500/15 [&.active]:text-indigo-200 [&.active]:border [&.active]:border-indigo-500/30 [&.active]:font-semibold">
                    <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                        <svg class="w-4 h-4 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138z" />
                        </svg>
                    </div>
                    @if (IsExpanded)
                    {
                        <div class="flex items-center justify-between flex-1 min-w-0 animate-atlas-in">
                            <span class="truncate">Hábitos & Metas</span>
                            <kbd class="text-[9px] font-mono opacity-40 group-hover:opacity-100">3</kbd>
                        </div>
                    }
                </NavLink>
            </AtlasTooltip>

            <!-- 4. Finanzas -->
            <AtlasTooltip Text="Finanzas" Shortcut="Alt+4" Position="right">
                <NavLink href="finance" class="group flex items-center gap-2.5 px-2 py-2 rounded-xl text-xs font-medium transition-all text-slate-400 hover:text-slate-100 hover:bg-white/[0.04] [&.active]:bg-indigo-500/15 [&.active]:text-indigo-200 [&.active]:border [&.active]:border-indigo-500/30 [&.active]:font-semibold">
                    <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                        <svg class="w-4 h-4 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    @if (IsExpanded)
                    {
                        <div class="flex items-center justify-between flex-1 min-w-0 animate-atlas-in">
                            <span class="truncate">Finanzas</span>
                            <kbd class="text-[9px] font-mono opacity-40 group-hover:opacity-100">4</kbd>
                        </div>
                    }
                </NavLink>
            </AtlasTooltip>

        </nav>
    </div>

    <!-- BOTTOM: Settings, Profile & Status -->
    <div class="space-y-1.5 pt-2">
        
        <!-- Settings NavLink -->
        <AtlasTooltip Text="Configuración" Shortcut="Alt+5" Position="right">
            <NavLink href="settings" class="group flex items-center gap-2.5 px-2 py-2 rounded-xl text-xs font-medium transition-all text-slate-400 hover:text-slate-100 hover:bg-white/[0.04] [&.active]:bg-indigo-500/15 [&.active]:text-indigo-200 [&.active]:border [&.active]:border-indigo-500/30">
                <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <svg class="w-4 h-4 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    </svg>
                </div>
                @if (IsExpanded)
                {
                    <div class="flex items-center justify-between flex-1 min-w-0 animate-atlas-in">
                        <span class="truncate">Ajustes</span>
                        <kbd class="text-[9px] font-mono opacity-40 group-hover:opacity-100">5</kbd>
                    </div>
                }
            </NavLink>
        </AtlasTooltip>

        <!-- User Profile Card -->
        <AtlasTooltip Text="Álvaro (Local SQLite)" Position="right">
            <div class="flex items-center gap-2.5 p-1.5 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                <AtlasAvatar Initials="A" Size="sm" IsOnline="true" />
                @if (IsExpanded)
                {
                    <div class="flex flex-col min-w-0 flex-1 animate-atlas-in">
                        <span class="text-xs font-semibold text-slate-200 truncate leading-tight">Álvaro</span>
                        <span class="text-[9.5px] font-mono text-emerald-400">● SQLite local</span>
                    </div>
                }
            </div>
        </AtlasTooltip>

    </div>

</aside>

@code {
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }
    [Parameter] public EventCallback OnQuickCapture { get; set; }
    [Parameter] public EventCallback OnCommandLauncher { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task ToggleExpand()
    {
        IsExpanded = !IsExpanded;
        if (IsExpandedChanged.HasDelegate)
        {
            await IsExpandedChanged.InvokeAsync(IsExpanded);
        }
    }

    private async Task TriggerQuickCapture()
    {
        if (OnQuickCapture.HasDelegate)
        {
            await OnQuickCapture.InvokeAsync();
        }
    }

    private async Task TriggerCommandLauncher()
    {
        if (OnCommandLauncher.HasDelegate)
        {
            await OnCommandLauncher.InvokeAsync();
        }
    }
}
