@namespace ATLAS.UI.Components.Common
@inject NavigationManager NavigationManager

<!-- Floating Personal Dock Capsule -->
<aside 
    class="flex flex-col gap-6 p-2 rounded-2xl atlas-dock transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] select-none shrink-0 h-fit my-auto relative z-20 w-14 @Class">
    
    <!-- TOP SECTION: Glowing Orb & Hero Quick Capture -->
    <div class="flex flex-col items-center space-y-3 pt-1">
        
        <!-- 1. Glowing 3D Orb Header / Dock Toggle -->
        <AtlasTooltip IsDisabled="false" Text="ATLAS OS" Shortcut="Alt+D" Position="right" Class="w-full flex justify-center">
            <button 
                type="button" 
                @onclick="TriggerCommandLauncher"
                class="w-full flex items-center justify-center p-1 rounded-xl hover:bg-white/[0.05] active:scale-95 transition-all cursor-pointer group"
                aria-label="Toggle Dock">
                
                <!-- 3D Iridescent Orb with Glow -->
                <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-violet-600 via-indigo-500 to-cyan-400 p-0.5 shadow-glow-purple animate-atlas-orb flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <div class="w-full h-full rounded-full bg-[#0d111c] flex items-center justify-center text-white text-[11px] font-mono font-bold tracking-tighter">
                        ✦
                    </div>
                </div>
            </button>
        </AtlasTooltip>

        <!-- 2. Hero Quick Capture Action (+) -->
        <AtlasTooltip IsDisabled="false" Text="Captura Rápida" Shortcut="Ctrl+N" Position="right" Class="w-full flex justify-center">
            <button 
                type="button"
                @onclick="TriggerQuickCapture"
                class="w-9 h-9 rounded-full flex items-center justify-center bg-gradient-to-r from-violet-600 via-indigo-600 to-purple-600 hover:from-violet-500 hover:to-purple-500 active:scale-95 text-white border border-violet-400/40 shadow-glow-purple transition-all duration-150 cursor-pointer group"
                aria-label="Captura rápida">
                <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
            </button>
        </AtlasTooltip>

    </div>

    <!-- CENTER SECTION: 8 Curated Personal Spaces -->
    <nav class="flex flex-col space-y-1.5 py-2 my-auto" aria-label="Espacios de ATLAS">
        
        <!-- 1. Inicio -->
        <AtlasTooltip IsDisabled="false" Text="Inicio" Shortcut="Alt+1" Position="right" Class="w-full block">
            <NavLink href="" Match="NavLinkMatch.All" class="group flex items-center justify-center p-2 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-white/[0.05] [&.active]:text-violet-400 [&.active]:drop-shadow-[0_0_8px_rgba(139,92,246,0.6)] transition-all atlas-clickable">
                <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                </div>
            </NavLink>
        </AtlasTooltip>

        <!-- 2. Búsqueda Universal -->
        <AtlasTooltip IsDisabled="false" Text="Búsqueda Universal" Shortcut="Alt+2" Position="right" Class="w-full block">
            <NavLink href="search" class="group flex items-center justify-center p-2 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-white/[0.05] [&.active]:text-violet-400 [&.active]:drop-shadow-[0_0_8px_rgba(139,92,246,0.6)] transition-all atlas-clickable">
                <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </NavLink>
        </AtlasTooltip>

        <!-- 3. Segundo Cerebro (Notas & Conocimiento) -->
        <AtlasTooltip IsDisabled="false" Text="Segundo Cerebro" Shortcut="Alt+3" Position="right" Class="w-full block">
            <NavLink href="capture" class="group flex items-center justify-center p-2 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-white/[0.05] [&.active]:text-violet-400 [&.active]:drop-shadow-[0_0_8px_rgba(139,92,246,0.6)] transition-all atlas-clickable">
                <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                    </svg>
                </div>
            </NavLink>
        </AtlasTooltip>

        <!-- 4. Metas & Hábitos -->
        <AtlasTooltip IsDisabled="false" Text="Metas & Hábitos" Shortcut="Alt+4" Position="right" Class="w-full block">
            <NavLink href="habits-goals" class="group flex items-center justify-center p-2 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-white/[0.05] [&.active]:text-violet-400 [&.active]:drop-shadow-[0_0_8px_rgba(139,92,246,0.6)] transition-all atlas-clickable">
                <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </NavLink>
        </AtlasTooltip>

        <!-- 5. Finanzas -->
        <AtlasTooltip IsDisabled="false" Text="Finanzas" Shortcut="Alt+5" Position="right" Class="w-full block">
            <NavLink href="finance" class="group flex items-center justify-center p-2 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-white/[0.05] [&.active]:text-violet-400 [&.active]:drop-shadow-[0_0_8px_rgba(139,92,246,0.6)] transition-all atlas-clickable">
                <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </NavLink>
        </AtlasTooltip>

        <!-- 6. Mensajes & Correo -->
        <AtlasTooltip IsDisabled="false" Text="Mensajes & Correo" Shortcut="Alt+6" Position="right" Class="w-full block">
            <NavLink href="settings" class="group flex items-center justify-center p-2 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-white/[0.05] transition-all atlas-clickable">
                <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
            </NavLink>
        </AtlasTooltip>

        <!-- 7. Conexiones & Apps -->
        <AtlasTooltip IsDisabled="false" Text="Integraciones" Shortcut="Alt+7" Position="right" Class="w-full block">
            <NavLink href="settings" class="group flex items-center justify-center p-2 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-white/[0.05] transition-all atlas-clickable">
                <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                </div>
            </NavLink>
        </AtlasTooltip>

        <!-- 8. Configuración -->
        <AtlasTooltip IsDisabled="false" Text="Configuración & Bóveda" Shortcut="Alt+8" Position="right" Class="w-full block">
            <NavLink href="settings" class="group flex items-center justify-center p-2 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-white/[0.05] [&.active]:text-violet-400 [&.active]:drop-shadow-[0_0_8px_rgba(139,92,246,0.6)] transition-all atlas-clickable">
                <div class="w-5 h-5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
            </NavLink>
        </AtlasTooltip>

    </nav>

    <!-- BOTTOM SECTION: User Profile Avatar -->
    <div class="flex flex-col items-center pt-2 pb-1 border-t border-white/[0.06]">
        <AtlasTooltip IsDisabled="false" Text="Álvaro — En línea" Shortcut="Perfil" Position="right" Class="w-full flex justify-center">
            <button 
                type="button" 
                @onclick="@(() => NavigationManager.NavigateTo("settings"))" 
                class="flex items-center justify-center p-1 rounded-xl hover:bg-white/[0.05] active:scale-95 transition-all cursor-pointer group"
                aria-label="Perfil de usuario">
                <AtlasAvatar Name="Álvaro Espinoza" IsOnline="true" Size="sm" />
            </button>
        </AtlasTooltip>
    </div>

</aside>

@code {
    [Parameter] public EventCallback OnQuickCapture { get; set; }
    [Parameter] public EventCallback OnCommandLauncher { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task TriggerQuickCapture()
    {
        if (OnQuickCapture.HasDelegate)
        {
            await OnQuickCapture.InvokeAsync();
        }
    }

    private async Task TriggerCommandLauncher()
    {
        if (OnCommandLauncher.HasDelegate)
        {
            await OnCommandLauncher.InvokeAsync();
        }
    }
}
