@namespace ATLAS.UI.Components.Common

<div class="p-4 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-xs text-rose-200 flex items-center justify-between gap-3 shadow-md shadow-rose-950/20 backdrop-blur-md animate-atlas-in @Class" @attributes="AdditionalAttributes">
    <div class="flex items-center gap-2.5 min-w-0">
        <span class="w-2 h-2 rounded-full bg-rose-400 shadow-sm shadow-rose-400/80 shrink-0"></span>
        <span class="truncate font-medium">@Message</span>
    </div>

    @if (OnRetry.HasDelegate)
    {
        <button 
            type="button" 
            @onclick="OnRetry" 
            class="px-3 py-1 rounded-xl bg-rose-500/25 hover:bg-rose-500/35 active:scale-[0.98] text-rose-100 text-[11px] font-mono shrink-0 transition-all border border-rose-500/30 cursor-pointer">
            Reintentar
        </button>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Ocurrió un error al procesar la solicitud.";
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
