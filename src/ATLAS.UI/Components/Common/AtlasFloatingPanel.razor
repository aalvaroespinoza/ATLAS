@namespace ATLAS.UI.Components.Common

<div class="atlas-floating rounded-2xl overflow-hidden shadow-floating animate-atlas-in @Class" @attributes="AdditionalAttributes" @onclick:stopPropagation="@StopPropagation">
    @if (HeaderContent != null)
    {
        <div class="px-5 py-3.5 border-b border-white/[0.08] bg-white/[0.02] flex items-center justify-between">
            @HeaderContent
        </div>
    }

    <div class="@BodyClass">
        @ChildContent
    </div>

    @if (FooterContent != null)
    {
        <div class="px-5 py-2.5 border-t border-white/[0.06] bg-black/20 flex items-center justify-between text-xs text-slate-400">
            @FooterContent
        </div>
    }
</div>

@code {
    [Parameter] public bool StopPropagation { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? BodyClass { get; set; } = "p-5";
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
