@namespace ATLAS.UI.Components.Common

<div class="relative flex items-center w-full max-w-2xl mx-auto rounded-2xl bg-[#0f1422]/95 backdrop-blur-2xl border border-white/[0.12] shadow-floating p-1.5 transition-all duration-150 @Class">
    <div class="pl-3.5 pr-2 flex items-center text-slate-400 font-mono text-sm select-none">
        <span>|</span>
    </div>

    <input 
        type="text"
        value="@Value"
        @oninput="HandleInput"
        @onkeydown="HandleKeyDown"
        placeholder="@Placeholder"
        disabled="@IsExecuting"
        class="flex-1 bg-transparent border-0 py-2 text-xs md:text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-0 font-sans" />

    <div class="flex items-center gap-2 pr-1.5 select-none">
        @if (!string.IsNullOrWhiteSpace(ShortcutText) && string.IsNullOrEmpty(Value))
        {
            <kbd class="px-2 py-0.5 rounded-lg bg-white/[0.06] border border-white/[0.08] text-[10.5px] font-mono text-slate-400 hidden sm:inline-block">
                @ShortcutText
            </kbd>
        }

        <button 
            type="button" 
            @onclick="Execute" 
            disabled="@(IsExecuting || string.IsNullOrWhiteSpace(Value))"
            class="w-8 h-8 rounded-full flex items-center justify-center bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-500 hover:to-purple-500 active:scale-95 text-white shadow-glow-purple transition-all duration-150 disabled:opacity-40 disabled:pointer-events-none cursor-pointer">
            @if (IsExecuting)
            {
                <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                </svg>
            }
            else
            {
                <svg class="w-4 h-4 font-bold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Pregúntale algo a ATLAS...";
    [Parameter] public string ShortcutText { get; set; } = "Ctrl + Space";
    [Parameter] public bool IsExecuting { get; set; }
    [Parameter] public EventCallback<string?> OnExecute { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsExecuting && !string.IsNullOrWhiteSpace(Value))
        {
            await Execute();
        }
    }

    private async Task Execute()
    {
        if (OnExecute.HasDelegate && !string.IsNullOrWhiteSpace(Value))
        {
            await OnExecute.InvokeAsync(Value);
        }
    }
}
