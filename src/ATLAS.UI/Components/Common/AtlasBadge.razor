@namespace ATLAS.UI.Components.Common

<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[10.5px] font-mono leading-none select-none border @GetVariantClasses() @Class">
    @if (ShowDot)
    {
        <span class="w-1.5 h-1.5 rounded-full shrink-0 @GetDotClasses()"></span>
    }
    <span>@ChildContent</span>
</span>

@code {
    [Parameter] public string Variant { get; set; } = "neutral"; // neutral, accent, success, warning, danger, mono
    [Parameter] public bool ShowDot { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string GetVariantClasses() => Variant.ToLowerInvariant() switch
    {
        "accent" => "bg-indigo-500/10 text-indigo-300 border-indigo-500/25",
        "success" => "bg-emerald-500/10 text-emerald-300 border-emerald-500/25",
        "warning" => "bg-amber-500/10 text-amber-300 border-amber-500/25",
        "danger" => "bg-rose-500/10 text-rose-300 border-rose-500/25",
        "mono" => "bg-white/[0.03] text-slate-400 border-white/[0.06]",
        _ => "bg-white/[0.04] text-slate-300 border-white/[0.08]"
    };

    private string GetDotClasses() => Variant.ToLowerInvariant() switch
    {
        "accent" => "bg-indigo-400",
        "success" => "bg-emerald-400",
        "warning" => "bg-amber-400",
        "danger" => "bg-rose-400",
        "mono" => "bg-slate-500",
        _ => "bg-slate-400"
    };
}
