@namespace ATLAS.UI.Components.Common

<div class="p-8 rounded-2xl bg-gradient-to-b from-[#141a29]/90 to-[#0e1320]/90 border border-white/[0.08] shadow-lg shadow-black/40 text-center space-y-3 select-none backdrop-blur-md animate-atlas-in @Class" @attributes="AdditionalAttributes">
    @if (IconContent != null)
    {
        <div class="flex justify-center text-slate-400">
            @IconContent
        </div>
    }

    <div class="space-y-1 max-w-sm mx-auto">
        <p class="text-xs text-slate-200 font-semibold">@Title</p>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="text-[11px] text-slate-400 font-sans leading-relaxed">@Description</p>
        }
    </div>

    @if (ActionContent != null)
    {
        <div class="pt-2 flex justify-center">
            @ActionContent
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Sin elementos";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter] public RenderFragment? ActionContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
