@namespace ATLAS.UI.Components.Common

<button 
    type="@Type"
    @onclick="HandleClick"
    disabled="@(IsDisabled || IsLoading)"
    class="inline-flex items-center justify-center gap-2 font-medium transition-all duration-150 cursor-pointer disabled:cursor-not-allowed disabled:opacity-40 atlas-clickable @GetVariantClasses() @GetSizeClasses() @Class"
    @attributes="AdditionalAttributes">
    
    @if (IsLoading)
    {
        <svg class="animate-spin w-3.5 h-3.5 shrink-0 text-current" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
        </svg>
    }
    
    <span>@ChildContent</span>

    @if (!string.IsNullOrWhiteSpace(ShortcutText) && !IsLoading)
    {
        <kbd class="px-1.5 py-0.5 rounded text-[10px] font-mono tracking-tighter opacity-75 border @GetShortcutClasses()">
            @ShortcutText
        </kbd>
    }
</button>

@code {
    [Parameter] public string Variant { get; set; } = "secondary"; // primary, hero-glow, secondary, ghost, danger, accent
    [Parameter] public string Size { get; set; } = "sm"; // sm (28px), md (36px), lg (44px)
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? ShortcutText { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!IsDisabled && !IsLoading && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }

    private string GetVariantClasses() => Variant.ToLowerInvariant() switch
    {
        "hero-glow" => "bg-gradient-to-r from-violet-600 via-indigo-600 to-purple-600 hover:from-violet-500 hover:to-purple-500 active:scale-[0.98] text-white font-semibold shadow-glow-purple border border-violet-400/40",
        "primary" => "bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] text-white font-semibold shadow-sm shadow-indigo-500/20 border border-indigo-400/30",
        "accent" => "bg-violet-500/15 hover:bg-violet-500/25 active:bg-violet-500/35 text-violet-200 hover:text-white border border-violet-500/30 font-medium",
        "secondary" => "bg-white/[0.05] hover:bg-white/[0.10] active:bg-white/[0.14] text-slate-200 hover:text-white border border-white/[0.08]",
        "ghost" => "bg-transparent hover:bg-white/[0.06] active:bg-white/[0.10] text-slate-400 hover:text-slate-100",
        "danger" => "bg-rose-500/15 hover:bg-rose-500/25 active:bg-rose-500/35 text-rose-200 hover:text-rose-100 border border-rose-500/30",
        _ => "bg-white/[0.05] hover:bg-white/[0.10] text-slate-200 border border-white/[0.08]"
    };

    private string GetShortcutClasses() => Variant.ToLowerInvariant() switch
    {
        "hero-glow" or "primary" => "bg-black/30 text-violet-100 border-white/20",
        "accent" => "bg-violet-950/60 text-violet-200 border-violet-500/30",
        _ => "bg-white/[0.06] text-slate-400 border-white/[0.10]"
    };

    private string GetSizeClasses() => Size.ToLowerInvariant() switch
    {
        "lg" => "h-11 px-5 text-sm rounded-xl",
        "md" => "h-9 px-4 text-xs rounded-xl",
        _ => "h-7.5 px-3 text-xs rounded-lg"
    };
}
