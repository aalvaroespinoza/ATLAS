@namespace ATLAS.UI.Components.Common

<button 
    type="@Type"
    @onclick="HandleClick"
    disabled="@(IsDisabled || IsLoading)"
    class="inline-flex items-center justify-center gap-2 font-medium transition-all duration-150 select-none cursor-pointer disabled:cursor-not-allowed disabled:opacity-40 atlas-clickable @GetVariantClasses() @GetSizeClasses() @Class">
    
    @if (IsLoading)
    {
        <svg class="animate-spin w-3.5 h-3.5 shrink-0 text-current" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
        </svg>
    }
    
    <span>@ChildContent</span>

    @if (!string.IsNullOrWhiteSpace(ShortcutText) && !IsLoading)
    {
        <kbd class="px-1 py-0.2 rounded text-[9px] font-mono tracking-tighter opacity-70 border @GetShortcutClasses()">
            @ShortcutText
        </kbd>
    }
</button>

@code {
    [Parameter] public string Variant { get; set; } = "secondary"; // primary, secondary, ghost, danger
    [Parameter] public string Size { get; set; } = "sm"; // sm (28px), md (34px)
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? ShortcutText { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!IsDisabled && !IsLoading && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }

    private string GetVariantClasses() => Variant.ToLowerInvariant() switch
    {
        "primary" => "bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-semibold shadow-sm shadow-indigo-500/20 border border-indigo-400/30",
        "secondary" => "bg-white/[0.05] hover:bg-white/[0.10] active:bg-white/[0.14] text-slate-200 hover:text-white border border-white/[0.08]",
        "ghost" => "bg-transparent hover:bg-white/[0.06] active:bg-white/[0.10] text-slate-400 hover:text-slate-100",
        "danger" => "bg-rose-500/10 hover:bg-rose-500/20 active:bg-rose-500/30 text-rose-300 border border-rose-500/20",
        _ => "bg-white/[0.05] hover:bg-white/[0.10] text-slate-200 border border-white/[0.08]"
    };

    private string GetShortcutClasses() => Variant.ToLowerInvariant() switch
    {
        "primary" => "bg-indigo-700/50 text-indigo-100 border-indigo-400/40",
        _ => "bg-white/[0.06] text-slate-400 border-white/[0.1]"
    };

    private string GetSizeClasses() => Size.ToLowerInvariant() switch
    {
        "md" => "h-8.5 px-3.5 text-xs rounded-xl",
        _ => "h-7 px-2.5 text-xs rounded-lg"
    };
}
