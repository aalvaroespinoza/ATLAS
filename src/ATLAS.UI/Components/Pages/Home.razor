@page "/"
@inject IHabitRepository HabitRepository
@inject IGoalRepository GoalRepository
@inject INoteRepository NoteRepository
@inject ITransactionRepository TransactionRepository
@inject IRoadmapRepository RoadmapRepository
@inject ICommandRegistry CommandRegistry
@inject NavigationManager NavigationManager

<div class="space-y-8 max-w-3xl pb-16 animate-atlas-in">
    
    <!-- 1. NOW: Header con Saludo Personal y Fecha -->
    <div class="space-y-1 border-b border-white/[0.08] pb-4">
        <div class="flex items-center justify-between">
            <h1 class="text-lg font-bold tracking-tight text-white flex items-center gap-2">
                <span>@greeting, Álvaro</span>
            </h1>
            <span class="text-[11px] font-mono text-slate-400 capitalize">
                @DateTime.Now.ToString("dddd, dd 'de' MMMM", new CultureInfo("es-AR"))
            </span>
        </div>
        <p class="text-xs text-slate-400">
            Superficie de enfoque diario. Escribí directamente abajo o ejecutá comandos.
        </p>
    </div>

    <!-- Feedback Banner -->
    @if (!string.IsNullOrWhiteSpace(actionFeedback))
    {
        <div class="px-3.5 py-2.5 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-xs flex items-center justify-between text-indigo-200 animate-atlas-in">
            <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                <span>@actionFeedback</span>
            </span>
            <button @onclick="() => actionFeedback = null" class="text-slate-400 hover:text-slate-200 text-xs">✕</button>
        </div>
    }

    <!-- 2. QUICK ACTIONS / INPUT BAR HERO -->
    <div class="space-y-2">
        <AtlasCommandInput 
            @bind-Value="quickInputQuery"
            OnKeyDown="HandleQuickInputKeyDown"
            IsLoading="isExecutingQuickInput"
            Placeholder="¿Qué tenés en mente o qué querés hacer?... (Escribí texto, '?' para IA o '/expense')" />

        <!-- AI Inline Answer Box (if user asked a '?' question from home) -->
        @if (!string.IsNullOrWhiteSpace(aiAnswer))
        {
            <div class="atlas-elevated rounded-2xl p-4 space-y-2 animate-atlas-in">
                <div class="flex items-center justify-between">
                    <span class="text-[10.5px] font-mono uppercase tracking-wider text-indigo-400 font-semibold flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                        <span>Respuesta ATLAS AI:</span>
                    </span>
                    <button @onclick="() => aiAnswer = null" class="text-slate-400 hover:text-slate-200 text-xs">✕</button>
                </div>
                <div class="text-xs text-slate-200 leading-relaxed whitespace-pre-wrap font-sans">
                    @aiAnswer
                </div>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <AtlasLoadingState Message="Cargando tu día en ATLAS..." />
    }
    else
    {
        <!-- 3. NEXT / ATENCIÓN (Hábitos pendientes de hoy) -->
        @if (pendingHabits.Count > 0)
        {
            <section class="space-y-3">
                <div class="flex items-center justify-between">
                    <AtlasSectionHeader 
                        Title="Atención de Hoy" 
                        Count="@pendingHabits.Count" />
                    
                    <button 
                        type="button" 
                        @onclick="@(() => NavigationManager.NavigateTo("habits-goals"))"
                        class="text-[11px] font-mono text-slate-400 hover:text-indigo-300 transition-colors">
                        Ver todos →
                    </button>
                </div>

                <div class="atlas-surface rounded-2xl divide-y divide-white/[0.04] overflow-hidden">
                    @foreach (var habit in pendingHabits.Take(4))
                    {
                        <AtlasListItem 
                            Title="@habit.Name" 
                            Subtitle="@($"Frecuencia: {habit.Frequency}")" 
                            MetaText="HOY">
                            <PrefixContent>
                                <input 
                                    type="checkbox" 
                                    @onchange="() => CompleteHabitAsync(habit)"
                                    class="w-4 h-4 rounded text-indigo-500 bg-slate-900 border-slate-700 focus:ring-indigo-500/30 cursor-pointer" />
                            </PrefixContent>
                            <SuffixContent>
                                <AtlasBadge Variant="accent">Pendiente</AtlasBadge>
                            </SuffixContent>
                        </AtlasListItem>
                    }
                </div>
            </section>
        }
        else if (allHabitsCount > 0)
        {
            <!-- Tranquil 1-line State when all habits are completed -->
            <div class="px-4 py-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-300 flex items-center justify-between">
                <span class="flex items-center gap-2">
                    <span>✓</span>
                    <span>Todo al día por hoy. Excelente constancia en tus hábitos (@allHabitsCount/@allHabitsCount).</span>
                </span>
                <button 
                    type="button" 
                    @onclick="@(() => NavigationManager.NavigateTo("habits-goals"))"
                    class="text-[11px] font-mono text-emerald-400 hover:underline">
                    Ver Hábitos →
                </button>
            </div>
        }

        <!-- 4. IN PROGRESS: SIGUIENTE HITO ACTIVO EN ROADMAP O META -->
        @if (activeRoadmaps.Count > 0 || activeGoals.Count > 0)
        {
            <section class="space-y-3">
                <div class="flex items-center justify-between">
                    <AtlasSectionHeader Title="En Progreso — Hitos Activos" />
                    
                    <button 
                        type="button" 
                        @onclick="@(() => NavigationManager.NavigateTo("habits-goals"))"
                        class="text-[11px] font-mono text-slate-400 hover:text-indigo-300 transition-colors">
                        Metas & Roadmaps →
                    </button>
                </div>

                <div class="space-y-2.5">
                    @foreach (var roadmap in activeRoadmaps)
                    {
                        var nextMilestone = roadmap.Milestones?.FirstOrDefault(m => m.Status == "pending");
                        
                        <div class="atlas-surface rounded-2xl p-4 space-y-3">
                            <div class="flex items-center justify-between text-xs">
                                <div class="flex items-center gap-2 min-w-0">
                                    <AtlasBadge Variant="accent">Roadmap</AtlasBadge>
                                    <span class="font-semibold text-slate-200 truncate">@roadmap.Title</span>
                                </div>
                                <span class="text-[11px] font-mono text-indigo-300 font-semibold">@roadmap.ProgressPercentage%</span>
                            </div>

                            @if (nextMilestone != null)
                            {
                                <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/[0.06] flex items-center justify-between gap-3 text-xs">
                                    <label class="flex items-center gap-2.5 cursor-pointer flex-1 min-w-0">
                                        <input 
                                            type="checkbox" 
                                            @onchange="() => CompleteMilestoneAsync(roadmap.Id, nextMilestone.Id)"
                                            class="w-3.5 h-3.5 rounded text-indigo-500 bg-slate-900 border-slate-700 cursor-pointer" />
                                        <span class="text-slate-300 font-medium truncate">
                                            Siguiente: @nextMilestone.Title
                                        </span>
                                    </label>
                                    <span class="text-[10px] font-mono text-slate-500">Paso @(nextMilestone.OrderIndex + 1)</span>
                                </div>
                            }

                            <!-- Hairline Progress Bar -->
                            <AtlasProgress Value="@roadmap.ProgressPercentage" Variant="accent" />
                        </div>
                    }

                    @foreach (var goal in activeGoals)
                    {
                        <div class="atlas-surface rounded-2xl p-3.5 space-y-2">
                            <div class="flex items-center justify-between text-xs">
                                <span class="font-medium text-slate-200 truncate">@goal.Title</span>
                                <span class="text-[11px] font-mono text-slate-400 font-semibold">@goal.Progress%</span>
                            </div>
                            <AtlasProgress Value="@goal.Progress" Variant="neutral" />
                        </div>
                    }
                </div>
            </section>
        }

        <!-- 5. RECENT: TIMELINE UNIFICADO DE ACTIVIDAD (Últimas 48h) -->
        @if (unifiedFeed.Count > 0)
        {
            <section class="space-y-3">
                <div class="flex items-center justify-between">
                    <AtlasSectionHeader Title="Actividad Reciente" />
                    
                    <button 
                        type="button" 
                        @onclick="@(() => NavigationManager.NavigateTo("search"))"
                        class="text-[11px] font-mono text-slate-400 hover:text-indigo-300 transition-colors">
                        Explorar archivo →
                    </button>
                </div>

                <div class="atlas-surface rounded-2xl divide-y divide-white/[0.04] overflow-hidden text-xs">
                    @foreach (var item in unifiedFeed.Take(5))
                    {
                        <div 
                            @onclick="() => NavigateToItem(item)"
                            class="px-4 py-2.5 flex items-center justify-between hover:bg-white/[0.03] cursor-pointer transition-colors gap-3">
                            
                            <div class="flex items-center gap-2.5 min-w-0">
                                <AtlasBadge Variant="@item.BadgeVariant">@item.TypeLabel</AtlasBadge>
                                <span class="text-slate-200 font-medium truncate">
                                    @item.Title
                                </span>
                            </div>

                            <div class="flex items-center gap-3 shrink-0 font-mono text-[10.5px]">
                                @if (!string.IsNullOrWhiteSpace(item.AmountText))
                                {
                                    <span class="@item.AmountClass font-semibold">@item.AmountText</span>
                                }
                                <span class="text-slate-500">@FormatRelative(item.Timestamp)</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    }

</div>

@code {
    private bool isLoading = true;
    private string greeting = "Hola";
    private string? actionFeedback;

    // Quick Input State
    private string? quickInputQuery;
    private bool isExecutingQuickInput;
    private string? aiAnswer;

    // Habits State
    private List<Habit> pendingHabits = [];
    private int allHabitsCount;

    // Goals & Roadmaps State
    private List<Roadmap> activeRoadmaps = [];
    private List<Goal> activeGoals = [];

    // Unified Activity Feed Item Model
    private record FeedItem(
        string TypeLabel, 
        string BadgeVariant, 
        string Title, 
        DateTimeOffset Timestamp, 
        string? AmountText = null, 
        string? AmountClass = null, 
        string TargetUrl = "search"
    );

    private List<FeedItem> unifiedFeed = [];

    protected override async Task OnInitializedAsync()
    {
        UpdateGreeting();
        await LoadHomeDataAsync();
    }

    private void UpdateGreeting()
    {
        var hour = DateTime.Now.Hour;
        greeting = hour switch
        {
            < 12 => "Buenos días",
            < 20 => "Buenas tardes",
            _ => "Buenas noches"
        };
    }

    private async Task LoadHomeDataAsync()
    {
        isLoading = true;

        try
        {
            // 1. Habits Data
            var allHabits = (await HabitRepository.GetAllAsync()).ToList();
            allHabitsCount = allHabits.Count;
            var todayEvents = await HabitRepository.GetEventsAsync(since: DateTimeOffset.UtcNow.Date);
            var completedIds = todayEvents.Select(e => e.HabitId).ToHashSet();
            pendingHabits = allHabits.Where(h => !completedIds.Contains(h.Id)).ToList();

            // 2. Roadmaps & Goals
            var roadmaps = (await RoadmapRepository.GetAllAsync(status: "active")).ToList();
            activeRoadmaps = roadmaps.Where(r => r.ProgressPercentage < 100).Take(2).ToList();

            var goals = (await GoalRepository.GetAllAsync(status: "active")).ToList();
            // If roadmaps exist, show fewer standalone goals to avoid clutter
            activeGoals = goals.Where(g => g.Progress < 100).Take(activeRoadmaps.Count > 0 ? 1 : 2).ToList();

            // 3. Unified Activity Feed (Notes + Transactions)
            var feed = new List<FeedItem>();

            var notes = await NoteRepository.GetRecentAsync(5);
            foreach (var note in notes)
            {
                var displayTitle = !string.IsNullOrWhiteSpace(note.Title) 
                    ? note.Title 
                    : (note.Content.Length > 45 ? note.Content[..45] + "..." : note.Content);

                feed.Add(new FeedItem(
                    TypeLabel: "Nota",
                    BadgeVariant: "accent",
                    Title: displayTitle,
                    Timestamp: note.CreatedAt,
                    TargetUrl: "search"
                ));
            }

            var txs = await TransactionRepository.GetRecentAsync(3);
            foreach (var tx in txs)
            {
                var isIncome = tx.Tipo == "income";
                var amountStr = $"{(isIncome ? "+" : "-")}${tx.Monto.ToString("N0", new CultureInfo("es-AR"))}";

                feed.Add(new FeedItem(
                    TypeLabel: "Finanza",
                    BadgeVariant: isIncome ? "success" : "neutral",
                    Title: tx.Descripcion,
                    Timestamp: tx.Fecha,
                    AmountText: amountStr,
                    AmountClass: isIncome ? "text-emerald-400" : "text-slate-300",
                    TargetUrl: "finance"
                ));
            }

            unifiedFeed = feed.OrderByDescending(f => f.Timestamp).ToList();
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleQuickInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || isExecutingQuickInput || string.IsNullOrWhiteSpace(quickInputQuery)) return;

        var query = quickInputQuery.Trim();
        isExecutingQuickInput = true;
        aiAnswer = null;

        try
        {
            // 1. Direct AI Query ('?')
            if (query.StartsWith("?"))
            {
                var prompt = query[1..].Trim();
                if (!string.IsNullOrWhiteSpace(prompt))
                {
                    var res = await CommandRegistry.ExecuteAsync(AiAskCommand.CommandId, new Dictionary<string, object?> { ["query"] = prompt });
                    if (res.IsSuccess)
                    {
                        aiAnswer = res.Data?.ToString();
                        quickInputQuery = string.Empty;
                    }
                    else
                    {
                        actionFeedback = res.ErrorMessage ?? "Error al consultar con Gemini.";
                    }
                }
            }
            // 2. Direct Expense ('/expense')
            else if (query.StartsWith("/expense", StringComparison.OrdinalIgnoreCase))
            {
                var parts = query.Split(' ', 3, StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length >= 3 && decimal.TryParse(parts[1], NumberStyles.Any, CultureInfo.InvariantCulture, out var amount))
                {
                    var desc = parts[2];
                    var res = await CommandRegistry.ExecuteAsync(FinanceAddTransactionCommand.CommandId, new Dictionary<string, object?>
                    {
                        ["amount"] = amount,
                        ["type"] = "expense",
                        ["description"] = desc
                    });

                    if (res.IsSuccess)
                    {
                        actionFeedback = $"✓ Gasto de ${amount:N0} registrado: '{desc}'";
                        quickInputQuery = string.Empty;
                        await LoadHomeDataAsync();
                    }
                }
                else
                {
                    actionFeedback = "Formato de gasto: /expense <monto> <descripción>";
                }
            }
            // 3. Fallback: Quick Note Capture
            else
            {
                var res = await CommandRegistry.ExecuteAsync(CaptureNoteCommand.CommandId, new Dictionary<string, object?>
                {
                    ["content"] = query,
                    ["source"] = "home_input"
                });

                if (res.IsSuccess)
                {
                    actionFeedback = "✓ Nota guardada correctamente.";
                    quickInputQuery = string.Empty;
                    await LoadHomeDataAsync();
                }
                else
                {
                    actionFeedback = res.ErrorMessage ?? "Error al capturar nota.";
                }
            }
        }
        catch (Exception ex)
        {
            actionFeedback = ex.Message;
        }
        finally
        {
            isExecutingQuickInput = false;
        }
    }

    private async Task CompleteHabitAsync(Habit habit)
    {
        try
        {
            var res = await CommandRegistry.ExecuteAsync(HabitCompleteCommand.CommandId, new Dictionary<string, object?>
            {
                ["habit_id"] = habit.Id
            });

            if (res.IsSuccess)
            {
                actionFeedback = $"✓ Hábito '{habit.Name}' registrado hoy.";
                await LoadHomeDataAsync();
            }
        }
        catch (Exception ex)
        {
            actionFeedback = ex.Message;
        }
    }

    private async Task CompleteMilestoneAsync(string roadmapId, string milestoneId)
    {
        try
        {
            var res = await CommandRegistry.ExecuteAsync(RoadmapCompleteMilestoneCommand.CommandId, new Dictionary<string, object?>
            {
                ["roadmap_id"] = roadmapId,
                ["milestone_id"] = milestoneId
            });

            if (res.IsSuccess)
            {
                actionFeedback = "✓ Hito del roadmap completado.";
                await LoadHomeDataAsync();
            }
        }
        catch (Exception ex)
        {
            actionFeedback = ex.Message;
        }
    }

    private void NavigateToItem(FeedItem item)
    {
        NavigationManager.NavigateTo(item.TargetUrl);
    }

    private static string FormatRelative(DateTimeOffset dto)
    {
        var dt = dto.ToLocalTime();
        var now = DateTimeOffset.Now;
        var diff = now - dt;

        if (diff.TotalMinutes < 1) return "ahora";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m";
        if (diff.TotalHours < 24 && dt.Date == now.Date) return $"{dt:HH:mm}";
        if (diff.TotalDays < 2 && dt.Date == now.Date.AddDays(-1)) return "ayer";

        return dt.ToString("dd MMM", new CultureInfo("es-AR"));
    }
}
