@code {
    private AtlasContextSnapshot? contextSnapshot;
    private bool isLoading = true;
    private string? actionFeedback;
    private string? aiAnswer;
    private IDisposable? _eventSubscription;

    protected override async Task OnInitializedAsync()
    {
        _eventSubscription = EventBus.SubscribeAll(async (evt) =>
        {
            // Pequeño retardo para asegurar que los BackgroundServices (como ActivityEventSubscriber) 
            // terminen de guardar en SQLite antes de recargar.
            await Task.Delay(100); 
            await InvokeAsync(async () =>
            {
                await ReloadContextAsync();
                StateHasChanged();
            });
        });
        
        await ReloadContextAsync();
    }

    public void Dispose()
    {
        _eventSubscription?.Dispose();
    }

    private async Task ReloadContextAsync()
    {
        isLoading = true;
        try
        {
            contextSnapshot = await AtlasContextService.GetCurrentContextAsync();
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error al cargar datos de contexto: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetFocusPercentage()
    {
        if (contextSnapshot == null || contextSnapshot.Habits.TotalCount == 0) return 100;
        return (int)Math.Round((contextSnapshot.Habits.CompletedTodayCount * 100.0) / contextSnapshot.Habits.TotalCount);
    }

    private string GetGreetingEmoji()
    {
        int hour = DateTime.Now.Hour;
        if (hour < 12) return "☀️";
        if (hour < 20) return "👋";
        return "🌙";
    }

    private async Task ExecuteSignalActionAsync(AtlasAttentionSignal signal)
    {
        if (string.IsNullOrWhiteSpace(signal.AssociatedCommandId)) return;

        try
        {
            var result = await CommandRegistry.ExecuteAsync(signal.AssociatedCommandId, signal.CommandParameters);
            if (result.IsSuccess)
            {
                actionFeedback = $"✓ Acción '{signal.Title}' ejecutada.";
                await ReloadContextAsync();
            }
            else
            {
                actionFeedback = $"⚠️ {result.ErrorMessage}";
            }
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error: {ex.Message}";
        }
    }

    private async Task CompleteHabitAsync(string habitId, string habitName)
    {
        try
        {
            var result = await CommandRegistry.ExecuteAsync(HabitCompleteCommand.CommandId, new Dictionary<string, object?>
            {
                ["id"] = habitId
            });

            if (result.IsSuccess)
            {
                actionFeedback = $"✓ Hábito '{habitName}' completado.";
                await ReloadContextAsync();
            }
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error: {ex.Message}";
        }
    }

    private async Task TriggerAiTool(string toolType)
    {
        try
        {
            CommandResult? result = null;
            string targetText = string.Empty;

            if (toolType == "pregunta")
            {
                actionFeedback = "⚠️ Presioná Ctrl+K o Ctrl+Space para abrir la consola y hacer tu pregunta.";
                return;
            }

            // Inyectamos el contexto de ATLAS ya que no hay barra inferior.
            targetText = await AtlasContextService.BuildAiSystemContextPromptAsync();
            
            if (toolType == "resumen")
            {
                targetText = "Por favor genera un resumen ejecutivo del siguiente estado actual de mis tareas, hábitos y gastos registrados en ATLAS:\n" + targetText;
            }
            
            switch (toolType)
            {
                case "resumen":
                    result = await CommandRegistry.ExecuteAsync(AiSummarizeCommand.CommandId, new Dictionary<string, object?> { ["text"] = targetText });
                    if (result.IsSuccess && result.Data is string sumText) 
                    {
                        aiAnswer = sumText;
                    }
                    return;
                case "explicar":
                    result = await CommandRegistry.ExecuteAsync(AiExplainCommand.CommandId, new Dictionary<string, object?> { ["text"] = targetText });
                    break;
                case "reescribir":
                    result = await CommandRegistry.ExecuteAsync(AiRewriteCommand.CommandId, new Dictionary<string, object?> { ["text"] = targetText });
                    break;
                case "traducir":
                    result = await CommandRegistry.ExecuteAsync(AiTranslateCommand.CommandId, new Dictionary<string, object?> { ["text"] = targetText });
                    break;

            }

            if (result != null)
            {
                if (result.IsSuccess && result.Data is IAsyncEnumerable<string> stream)
                {
                    aiAnswer = string.Empty;
                    StateHasChanged();
                    
                    await foreach (var chunk in stream)
                    {
                        aiAnswer += chunk;
                        StateHasChanged();
                    }
                }
                else if (result.IsSuccess && result.Data is string answer)
                {
                    aiAnswer = answer;
                }
                else
                {
                    actionFeedback = $"⚠️ {result.ErrorMessage ?? "No se obtuvo respuesta de IA."}";
                }
            }
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error: {ex.Message}";
        }
        finally
        {
            isExecutingPrompt = false;
        }
    }

    private static string GetActivityIconClass(string colorVariant) => colorVariant.ToLowerInvariant() switch
    {
        "purple" => "bg-violet-500/15 text-violet-300 border border-violet-500/30",
        "emerald" => "bg-emerald-500/15 text-emerald-300 border border-emerald-500/30",
        "orange" => "bg-orange-500/15 text-orange-300 border border-orange-500/30",
        "rose" => "bg-rose-500/15 text-rose-300 border border-rose-500/30",
        _ => "bg-white/[0.06] text-slate-300"
    };

    private static string GenerateSparklinePath(IReadOnlyList<int> points, double width, double height)
    {
        var inv = CultureInfo.InvariantCulture;
        double padding = 4.0;
        double drawableWidth = width - (padding * 2);
        double drawableHeight = height - (padding * 2);

        if (points == null || points.Count < 2) 
        {
            return string.Format(inv, "M {0:F1} {1:F1} L {2:F1} {3:F1}", padding, height / 2, width - padding, height / 2);
        }

        int max = Math.Max(1, points.Max());
        var stepX = drawableWidth / (points.Count - 1);
        
        var sb = new System.Text.StringBuilder();
        double startX = padding;
        double startY = height - padding - ((double)points[0] / max * drawableHeight);
        sb.AppendFormat(inv, "M {0:F1} {1:F1}", startX, startY);
        
        for (int i = 1; i < points.Count; i++)
        {
            double endX = padding + (i * stepX);
            double endY = height - padding - ((double)points[i] / max * drawableHeight);
            double cpX1 = startX + (stepX / 2);
            double cpX2 = endX - (stepX / 2);
            sb.AppendFormat(inv, " C {0:F1} {1:F1}, {2:F1} {3:F1}, {4:F1} {5:F1}", cpX1, startY, cpX2, endY, endX, endY);
            startX = endX;
            startY = endY;
        }
        
        return sb.ToString();
    }

    private static string GetSparklineLastY(IReadOnlyList<int> points, double height)
    {
        var inv = CultureInfo.InvariantCulture;
        double padding = 4.0;
        double drawableHeight = height - (padding * 2);
        
        if (points == null || points.Count == 0) 
            return (height / 2).ToString("F1", inv);
            
        int max = Math.Max(1, points.Max());
        double y = height - padding - ((double)points[^1] / max * drawableHeight);
        return y.ToString("F1", inv);
    }

    private static double GetBarHeightPct(IReadOnlyList<decimal> values, int index)
    {
        if (values == null || values.Count <= index) return 20;
        decimal max = Math.Max(1, values.Max());
        return (double)(values[index] / max * 100);
    }
}
