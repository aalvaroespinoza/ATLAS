@page "/"
@inject IHabitRepository HabitRepository
@inject IGoalRepository GoalRepository
@inject INoteRepository NoteRepository
@inject ITransactionRepository TransactionRepository
@inject IRoadmapRepository RoadmapRepository
@inject ICommandRegistry CommandRegistry
@inject NavigationManager NavigationManager

<div class="space-y-8 max-w-3xl pb-16">
    
    <!-- Top Command Center Header -->
    <div class="space-y-1 border-b border-white/[0.06] pb-4">
        <div class="flex items-center justify-between">
            <h1 class="text-lg font-semibold tracking-tight text-white flex items-center gap-2">
                <span>@greeting, Álvaro</span>
            </h1>
            <span class="text-[11px] font-mono text-slate-500 capitalize">
                @DateTime.Now.ToString("dddd, dd 'de' MMMM", new CultureInfo("es-AR"))
            </span>
        </div>
        <p class="text-xs text-slate-400">
            Resumen consolidado de actividad y tareas prioritarias.
        </p>
    </div>

    <!-- Feedback Banner -->
    @if (!string.IsNullOrWhiteSpace(actionFeedback))
    {
        <div class="px-3.5 py-2 rounded-lg bg-white/[0.04] border border-white/[0.08] text-xs flex items-center justify-between text-slate-200 animate-fadeIn">
            <span>@actionFeedback</span>
            <button @onclick="() => actionFeedback = null" class="text-slate-500 hover:text-slate-300 text-xs">✕</button>
        </div>
    }

    <!-- ======================================================================= -->
    <!-- SECTION 1: ACCIÓN INMEDIATA / HÁBITOS DE HOY -->
    <!-- ======================================================================= -->
    <section class="space-y-3">
        <div class="flex items-center justify-between">
            <h2 class="text-[10px] font-mono uppercase tracking-widest text-slate-400 font-semibold flex items-center gap-2">
                <span>Acción Inmediata — Hábitos de Hoy</span>
                @if (totalHabits > 0)
                {
                    <span class="text-[10px] font-mono text-slate-400 font-normal">(@completedHabits / @totalHabits)</span>
                }
            </h2>
            <button 
                type="button" 
                @onclick="@(() => NavigationManager.NavigateTo("habits-goals"))"
                class="text-[11px] text-slate-400 hover:text-slate-200 transition-colors">
                Administrar →
            </button>
        </div>

        @if (isLoading)
        {
            <div class="py-4 text-xs font-mono text-slate-600">Cargando hábitos...</div>
        }
        else if (habits.Count == 0)
        {
            <div class="p-4 rounded-lg bg-white/[0.02] border border-white/[0.04] text-xs text-slate-400 flex items-center justify-between">
                <span>No hay hábitos configurados.</span>
                <button @onclick="@(() => NavigationManager.NavigateTo("habits-goals"))" class="text-sky-400 hover:underline">Crear uno</button>
            </div>
        }
        else
        {
            <div class="divide-y divide-white/[0.04] rounded-lg bg-white/[0.02] border border-white/[0.06] overflow-hidden">
                @foreach (var habit in habits)
                {
                    var isDone = completedHabitIds.Contains(habit.Id);
                    <div class="px-4 py-2.5 flex items-center justify-between hover:bg-white/[0.02] transition-colors gap-3">
                        <label class="flex items-center gap-3 cursor-pointer select-none flex-1 min-w-0">
                            <input 
                                type="checkbox" 
                                checked="@isDone"
                                @onchange="() => ToggleHabitAsync(habit)"
                                class="w-3.5 h-3.5 rounded text-sky-500 bg-slate-900 border-slate-700 focus:ring-sky-500/30 cursor-pointer" />
                            <span class="text-xs @(isDone ? "line-through text-slate-400" : "text-slate-200 font-medium") truncate">
                                @habit.Name
                            </span>
                        </label>
                        <span class="text-[10px] font-mono text-slate-400 shrink-0">@habit.Frequency</span>
                    </div>
                }
            </div>
        }
    </section>

    <!-- ======================================================================= -->
    <!-- SECTION 2: EN PROGRESO / METAS & ROADMAPS ACTIVOS -->
    <!-- ======================================================================= -->
    <section class="space-y-3">
        <div class="flex items-center justify-between">
            <h2 class="text-[10px] font-mono uppercase tracking-widest text-slate-400 font-semibold">
                En Progreso — Metas & Roadmaps
            </h2>
            <button 
                type="button" 
                @onclick="@(() => NavigationManager.NavigateTo("habits-goals"))"
                class="text-[11px] text-slate-400 hover:text-slate-200 transition-colors">
                Ver todos →
            </button>
        </div>

        @if (isLoading)
        {
            <div class="py-4 text-xs font-mono text-slate-600">Cargando metas...</div>
        }
        else if (activeGoals.Count == 0 && activeRoadmaps.Count == 0)
        {
            <div class="p-4 rounded-lg bg-white/[0.02] border border-white/[0.04] text-xs text-slate-400 flex items-center justify-between">
                <span>No hay metas o roadmaps activos en curso.</span>
                <button @onclick="@(() => NavigationManager.NavigateTo("habits-goals"))" class="text-sky-400 hover:underline">Planificar</button>
            </div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var goal in activeGoals)
                {
                    <div class="p-3.5 rounded-lg bg-white/[0.02] border border-white/[0.06] hover:border-white/10 transition-all space-y-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-medium text-slate-200 truncate">@goal.Title</span>
                            <span class="text-[11px] font-mono text-slate-400 font-semibold">@goal.Progress%</span>
                        </div>
                        
                        <!-- Slim Hairline Progress Bar -->
                        <div class="w-full h-1 rounded-full bg-white/[0.06] overflow-hidden">
                            <div class="h-full bg-slate-300 rounded-full transition-all duration-300" style="width: @(Math.Clamp(goal.Progress, 0, 100))%"></div>
                        </div>
                    </div>
                }

                @foreach (var roadmap in activeRoadmaps)
                {
                    <div class="p-3.5 rounded-lg bg-white/[0.02] border border-white/[0.06] hover:border-white/10 transition-all space-y-2">
                        <div class="flex items-center justify-between text-xs">
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-mono text-sky-400 uppercase">Roadmap</span>
                                <span class="font-medium text-slate-200 truncate">@roadmap.Title</span>
                            </div>
                            <span class="text-[11px] font-mono text-slate-400 font-semibold">@roadmap.ProgressPercentage%</span>
                        </div>
                        
                        <!-- Slim Hairline Progress Bar -->
                        <div class="w-full h-1 rounded-full bg-white/[0.06] overflow-hidden">
                            <div class="h-full bg-sky-400 rounded-full transition-all duration-300" style="width: @(roadmap.ProgressPercentage)%"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- ======================================================================= -->
    <!-- SECTION 3: ACTIVIDAD RECIENTE (FEED UNIFICADO) -->
    <!-- ======================================================================= -->
    <section class="space-y-3">
        <div class="flex items-center justify-between">
            <h2 class="text-[10px] font-mono uppercase tracking-widest text-slate-400 font-semibold">
                Actividad Reciente & Cambios
            </h2>
            <button 
                type="button" 
                @onclick="@(() => NavigationManager.NavigateTo("search"))"
                class="text-[11px] text-slate-400 hover:text-slate-200 transition-colors">
                Explorar archivo →
            </button>
        </div>

        @if (isLoading)
        {
            <div class="py-4 text-xs font-mono text-slate-600">Cargando actividad...</div>
        }
        else if (recentNotes.Count == 0 && recentTransactions.Count == 0)
        {
            <div class="p-4 rounded-lg bg-white/[0.02] border border-white/[0.04] text-xs text-slate-400">
                Sin actividad registrada recientemente. Usá <kbd class="px-1 py-0.5 rounded bg-white/[0.06] text-[10px] font-mono text-slate-400">Ctrl+Space</kbd> para capturar o registrar datos.
            </div>
        }
        else
        {
            <div class="divide-y divide-white/[0.04] rounded-lg bg-white/[0.02] border border-white/[0.06] overflow-hidden text-xs">
                
                <!-- Notes -->
                @foreach (var note in recentNotes)
                {
                    <div 
                        @onclick="@(() => NavigationManager.NavigateTo("search"))"
                        class="px-4 py-2.5 flex items-center justify-between hover:bg-white/[0.02] cursor-pointer transition-colors gap-3">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="text-[10px] font-mono text-slate-400 uppercase shrink-0">Nota</span>
                            <span class="text-slate-200 font-medium truncate">
                                @(!string.IsNullOrWhiteSpace(note.Title) ? note.Title : (note.Content.Length > 40 ? note.Content[..40] + "..." : note.Content))
                            </span>
                        </div>
                        <span class="text-[11px] font-mono text-slate-400 shrink-0">@FormatRelative(note.CreatedAt)</span>
                    </div>
                }

                <!-- Transactions -->
                @foreach (var tx in recentTransactions)
                {
                    <div 
                        @onclick="@(() => NavigationManager.NavigateTo("finance"))"
                        class="px-4 py-2.5 flex items-center justify-between hover:bg-white/[0.02] cursor-pointer transition-colors gap-3">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="text-[10px] font-mono text-slate-400 uppercase shrink-0">Finanza</span>
                            <span class="text-slate-200 truncate">@tx.Descripcion</span>
                        </div>
                        <div class="flex items-center gap-3 shrink-0 font-mono text-[11px]">
                            <span class="@(tx.Tipo == "income" ? "text-emerald-400 font-semibold" : "text-slate-300")">
                                @(tx.Tipo == "income" ? "+" : "-")$@tx.Monto.ToString("N0", new CultureInfo("es-AR"))
                            </span>
                            <span class="text-slate-400">@FormatRelative(tx.Fecha)</span>
                        </div>
                    </div>
                }

            </div>
        }
    </section>

</div>

@code {
    private bool isLoading = true;
    private string greeting = "Hola";
    private string? actionFeedback;

    // Habits state
    private List<Habit> habits = [];
    private HashSet<string> completedHabitIds = [];
    private int totalHabits;
    private int completedHabits;

    // Goals & Roadmaps state
    private List<Goal> activeGoals = [];
    private List<Roadmap> activeRoadmaps = [];

    // Recent items
    private List<Note> recentNotes = [];
    private List<Transaction> recentTransactions = [];

    protected override async Task OnInitializedAsync()
    {
        UpdateGreeting();
        await LoadCommandCenterDataAsync();
    }

    private void UpdateGreeting()
    {
        var hour = DateTime.Now.Hour;
        greeting = hour switch
        {
            < 12 => "Buenos días",
            < 20 => "Buenas tardes",
            _ => "Buenas noches"
        };
    }

    private async Task LoadCommandCenterDataAsync()
    {
        isLoading = true;

        try
        {
            // 1. Habits
            var allHabits = await HabitRepository.GetAllAsync();
            habits = allHabits.ToList();
            var todayEvents = await HabitRepository.GetEventsAsync(since: DateTimeOffset.UtcNow.Date);
            completedHabitIds = todayEvents.Select(e => e.HabitId).ToHashSet();
            totalHabits = habits.Count;
            completedHabits = habits.Count(h => completedHabitIds.Contains(h.Id));

            // 2. Active Goals & Roadmaps
            var goals = await GoalRepository.GetAllAsync(status: "active");
            activeGoals = goals.Take(3).ToList();

            var roadmaps = await RoadmapRepository.GetAllAsync(status: "active");
            activeRoadmaps = roadmaps.Where(r => r.ProgressPercentage < 100).Take(2).ToList();

            // 3. Recent Notes & Transactions
            var notes = await NoteRepository.GetRecentAsync(3);
            recentNotes = notes.ToList();

            var txs = await TransactionRepository.GetRecentAsync(2);
            recentTransactions = txs.ToList();
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleHabitAsync(Habit habit)
    {
        try
        {
            var res = await CommandRegistry.ExecuteAsync(HabitCompleteCommand.CommandId, new Dictionary<string, object?>
            {
                ["habit_id"] = habit.Id
            });

            if (res.IsSuccess)
            {
                actionFeedback = $"✓ Hábito '{habit.Name}' registrado hoy.";
                await LoadCommandCenterDataAsync();
            }
        }
        catch (Exception ex)
        {
            actionFeedback = ex.Message;
        }
    }

    private static string FormatRelative(DateTimeOffset dto)
    {
        var dt = dto.ToLocalTime();
        var now = DateTimeOffset.Now;
        var diff = now - dt;

        if (diff.TotalMinutes < 1) return "ahora";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m";
        if (diff.TotalHours < 24 && dt.Date == now.Date) return $"{dt:HH:mm}";
        if (diff.TotalDays < 2 && dt.Date == now.Date.AddDays(-1)) return "ayer";

        return dt.ToString("dd MMM", new CultureInfo("es-AR"));
    }
}
