    private void HandleSearchSubmit(string? query)
    {
        if (!string.IsNullOrWhiteSpace(query))
        {
            NavigationManager.NavigateTo($"search?q={Uri.EscapeDataString(query.Trim())}");
        }
    }

    private async Task HandlePromptExecute(string? input)
    {
        if (string.IsNullOrWhiteSpace(input) || isExecutingPrompt) return;

        isExecutingPrompt = true;
        try
        {
            string trimmed = input.Trim();

            // 1. Expense Command Shortcut: /expense or /gasto
            if (trimmed.StartsWith("/expense", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("/gasto", StringComparison.OrdinalIgnoreCase))
            {
                var result = await CommandRegistry.ExecuteAsync(FinanceAddTransactionCommand.CommandId, new Dictionary<string, object?>
                {
                    ["text"] = trimmed
                });
                actionFeedback = result.IsSuccess ? $"✓ Gasto registrado: {result.Data ?? "Correcto"}" : $"⚠️ {result.ErrorMessage}";
                quickPromptText = string.Empty;
                await ReloadContextAsync();
                return;
            }

            // 2. Note Command Shortcut: /note or /nota
            if (trimmed.StartsWith("/note", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("/nota", StringComparison.OrdinalIgnoreCase))
            {
                var content = trimmed.Contains(' ') ? trimmed[(trimmed.IndexOf(' ') + 1)..] : trimmed;
                var result = await CommandRegistry.ExecuteAsync(CaptureNoteCommand.CommandId, new Dictionary<string, object?>
                {
                    ["content"] = content,
                    ["source"] = "home_prompt"
                });
                actionFeedback = result.IsSuccess ? "✓ Nota capturada en Segundo Cerebro." : $"⚠️ {result.ErrorMessage}";
                quickPromptText = string.Empty;
                await ReloadContextAsync();
                return;
            }

            // 3. AI Question Dispatch
            var aiResult = await CommandRegistry.ExecuteAsync(AiAskCommand.CommandId, new Dictionary<string, object?>
            {
                ["question"] = trimmed.StartsWith('?') ? trimmed[1..].Trim() : trimmed
            });

            if (aiResult.IsSuccess && aiResult.Data is string answer)
            {
                aiAnswer = answer;
                quickPromptText = string.Empty;
            }
            else
            {
                actionFeedback = $"⚠️ {aiResult.ErrorMessage ?? "No se obtuvo respuesta de IA."}";
            }
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error: {ex.Message}";
        }
        finally
        {
            isExecutingPrompt = false;
        }
    }

    private async Task TriggerAiTool(string toolType)
    {
        switch (toolType)
        {
            case "resumen":
                var summaryResult = await CommandRegistry.ExecuteAsync(AiSummarizeCommand.CommandId, new Dictionary<string, object?>
                {
                    ["text"] = "Por favor genera un resumen ejecutivo del estado actual de mis tareas, hábitos y gastos registrados en ATLAS."
                });
                if (summaryResult.IsSuccess && summaryResult.Data is string sumText) aiAnswer = sumText;
                break;
            case "explicar":
                quickPromptText = "¿Podrías explicarme con claridad cómo estructurar...?";
                break;
            case "reescribir":
                quickPromptText = "Reescribir para mayor impacto: ";
                break;
            case "traducir":
                quickPromptText = "Traducir al inglés: ";
                break;
            default:
                quickPromptText = "¿Qué tengo pendiente para hoy?";
                break;
        }
    }

    private static string GetActivityIconClass(string colorVariant) => colorVariant.ToLowerInvariant() switch
    {
        "purple" => "bg-violet-500/15 text-violet-300 border border-violet-500/30",
        "emerald" => "bg-emerald-500/15 text-emerald-300 border border-emerald-500/30",
        "orange" => "bg-orange-500/15 text-orange-300 border border-orange-500/30",
        "rose" => "bg-rose-500/15 text-rose-300 border border-rose-500/30",
        _ => "bg-white/[0.06] text-slate-300"
    };

    private static string GenerateSparklinePath(IReadOnlyList<int> points, double width, double height)
    {
        if (points == null || points.Count < 2) return $"M 0 {height/2} L {width} {height/2}";
        int max = Math.Max(1, points.Max());
        var stepX = width / (points.Count - 1);
        var coords = points.Select((p, i) => $"{i * stepX:F1} {height - ((double)p / max * (height - 8) + 4):F1}").ToList();
        return "M " + string.Join(" L ", coords);
    }

    private static double GetSparklineLastY(IReadOnlyList<int> points, double height)
    {
        if (points == null || points.Count == 0) return height / 2;
        int max = Math.Max(1, points.Max());
        return height - ((double)points[^1] / max * (height - 8) + 4);
    }

    private static double GetBarHeightPct(IReadOnlyList<decimal> values, int index)
    {
        if (values == null || values.Count <= index) return 20;
        decimal max = Math.Max(1, values.Max());
        return (double)(values[index] / max * 100);
    }
