@page "/"
@using System.Globalization
@using ATLAS.Core.Commands
@using ATLAS.Core.Context
@using ATLAS.UI.Components.Common
@inject IAtlasContextService AtlasContextService
@inject ICommandRegistry CommandRegistry
@inject NavigationManager NavigationManager

<div class="space-y-6 max-w-6xl mx-auto pb-24 animate-atlas-in">

    <!-- 1. TOP HERO HEADER -->
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
        <div class="space-y-1 select-none">
            <h1 class="text-xl md:text-2xl font-bold tracking-tight text-white flex items-center gap-2">
                <span>@(contextSnapshot?.TimeOfDayGreeting ?? "¡Bienvenido"), Álvaro!</span>
                <span class="text-lg">@GetGreetingEmoji()</span>
            </h1>
            <div class="flex items-center gap-2 text-xs text-slate-400">
                <span>Esto es lo que importa hoy.</span>
                <span class="text-slate-600">•</span>
                <span class="font-mono text-[11px] text-slate-400 capitalize">
                    @DateTime.Now.ToString("dddd, dd 'de' MMMM", new CultureInfo("es-AR"))
                </span>
            </div>
        </div>

        <!-- Header Controls (Search + Quick Actions) -->
        <div class="flex items-center gap-3">
            <div class="w-72 hidden lg:block">
                <AtlasSearch 
                    @bind-Value="searchQuery" 
                    OnSearch="HandleSearchSubmit" 
                    Placeholder="Buscar en ATLAS o comando..." />
            </div>

            <div class="flex items-center gap-1.5">
                <AtlasTooltip Text="Asistente IA" Shortcut="?" Position="bottom">
                    <AtlasIconButton 
                        Variant="accent" 
                        Shape="circle" 
                        Size="md" 
                        Glow="purple"
                        OnClick="@(() => TriggerAiTool("pregunta"))">
                        <span class="text-xs">✨</span>
                    </AtlasIconButton>
                </AtlasTooltip>

                <AtlasTooltip Text="Metas & Hábitos" Shortcut="Alt+4" Position="bottom">
                    <AtlasIconButton 
                        Variant="secondary" 
                        Shape="circle" 
                        Size="md"
                        OnClick="@(() => NavigationManager.NavigateTo("habits-goals"))">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </AtlasIconButton>
                </AtlasTooltip>

                <AtlasTooltip Text="Álvaro — En línea" Position="bottom">
                    <AtlasAvatar Name="Álvaro Espinoza" IsOnline="true" Size="md" Class="ml-1" />
                </AtlasTooltip>
            </div>
        </div>
    </header>

    <!-- Feedback Banner -->
    @if (!string.IsNullOrWhiteSpace(actionFeedback))
    {
        <div class="px-4 py-2.5 rounded-xl bg-violet-500/15 border border-violet-500/30 text-xs flex items-center justify-between text-violet-200 animate-atlas-in shadow-glow-purple">
            <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                <span>@actionFeedback</span>
            </span>
            <button type="button" @onclick="() => actionFeedback = null" class="text-slate-400 hover:text-white text-xs cursor-pointer">✕</button>
        </div>
    }

    <!-- Inline AI Response Container -->
    @if (!string.IsNullOrWhiteSpace(aiAnswer))
    {
        <div class="atlas-panel-ai rounded-2xl p-5 space-y-3 animate-atlas-in shadow-floating">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-violet-600 to-cyan-400 flex items-center justify-center text-[10px] font-bold text-white shadow-glow-purple">
                        AI
                    </div>
                    <span class="text-xs font-semibold text-white">Respuesta de ATLAS Intelligence</span>
                </div>
                <button type="button" @onclick="() => aiAnswer = null" class="text-slate-400 hover:text-white text-xs cursor-pointer">✕</button>
            </div>
            <div class="text-xs text-slate-200 leading-relaxed whitespace-pre-wrap font-sans pl-8">
                @aiAnswer
            </div>
        </div>
    }

    @if (isLoading)
    {
        <AtlasLoadingState Message="Cargando tu contexto personal..." />
    }
    else if (contextSnapshot != null)
    {
        <!-- 2. TOP METRICS ROW (3 Cards with Real Data & Sparklines) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            
            <!-- Card 1: Racha de hábitos -->
            <AtlasSurface Elevation="base" Glow="orange" Class="p-5 flex flex-col justify-between select-none">
                <div class="flex items-center justify-between text-xs text-slate-400">
                    <div class="flex items-center gap-2">
                        <span class="text-base">🔥</span>
                        <span class="font-medium text-slate-200">Racha de hábitos</span>
                    </div>
                </div>
                
                <div class="flex items-baseline justify-between mt-3">
                    <div>
                        <div class="flex items-baseline gap-1.5">
                            <span class="text-3xl font-extrabold text-white tracking-tight">@contextSnapshot.Habits.LongestStreakDays</span>
                            <span class="text-xs font-medium text-slate-400">días</span>
                        </div>
                        <p class="text-[11px] text-orange-400 font-medium mt-0.5 truncate max-w-[140px]">
                            @(contextSnapshot.Habits.LongestStreakDays > 0 ? (string.IsNullOrEmpty(contextSnapshot.Habits.LongestStreakHabitName) ? "¡Vamos así!" : contextSnapshot.Habits.LongestStreakHabitName) : "Iniciá una racha hoy")
                        </p>
                    </div>

                    <!-- Sparkline Trend SVG -->
                    <div class="w-24 h-9 flex items-center">
                        <svg class="w-full h-full text-orange-400 overflow-visible" viewBox="0 0 100 30" fill="none">
                            <path d="@GenerateSparklinePath(contextSnapshot.Habits.WeeklyCompletionTrend, 100, 30)" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="96" cy="@GetSparklineLastY(contextSnapshot.Habits.WeeklyCompletionTrend, 30)" r="3.5" fill="currentColor" class="animate-pulse" />
                        </svg>
                    </div>
                </div>
            </AtlasSurface>

            <!-- Card 2: Enfoque de hoy -->
            <AtlasSurface Elevation="base" Glow="emerald" Class="p-5 flex flex-col justify-between select-none">
                <div class="flex items-center justify-between text-xs text-slate-400">
                    <div class="flex items-center gap-2">
                        <span class="text-base">🎯</span>
                        <span class="font-medium text-slate-200">Enfoque de hoy</span>
                    </div>
                </div>
                
                <div class="flex items-baseline justify-between mt-3">
                    <div>
                        <div class="flex items-baseline gap-1.5">
                            <span class="text-3xl font-extrabold text-white tracking-tight">@GetFocusPercentage()%</span>
                            <span class="text-xs font-medium text-slate-400">de foco</span>
                        </div>
                        <p class="text-[11px] text-emerald-400 font-medium mt-0.5">
                            @contextSnapshot.Habits.CompletedTodayCount de @contextSnapshot.Habits.TotalCount hábitos listos
                        </p>
                    </div>

                    <!-- Curve Focus SVG -->
                    <div class="w-24 h-9 flex items-center">
                        <svg class="w-full h-full text-emerald-400 overflow-visible" viewBox="0 0 100 30" fill="none">
                            <path d="@GenerateSparklinePath(contextSnapshot.Habits.WeeklyCompletionTrend, 100, 30)" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="96" cy="@GetSparklineLastY(contextSnapshot.Habits.WeeklyCompletionTrend, 30)" r="3.5" fill="currentColor" class="animate-pulse" />
                        </svg>
                    </div>
                </div>
            </AtlasSurface>

            <!-- Card 3: Balance del mes -->
            <AtlasSurface Elevation="base" Glow="cyan" Class="p-5 flex flex-col justify-between select-none">
                <div class="flex items-center justify-between text-xs text-slate-400">
                    <div class="flex items-center gap-2">
                        <span class="text-base">💳</span>
                        <span class="font-medium text-slate-200">Balance del mes</span>
                    </div>
                </div>
                
                <div class="flex items-baseline justify-between mt-3">
                    <div>
                        <div class="flex items-baseline gap-1.5">
                            <span class="text-2xl font-extrabold text-white tracking-tight font-mono">
                                $@contextSnapshot.Finance.NetBalance.ToString("N0", new CultureInfo("es-AR"))
                            </span>
                        </div>
                        <p class="text-[11px] text-cyan-400 font-medium mt-0.5">
                            @contextSnapshot.Finance.MovementCount movimientos
                        </p>
                    </div>

                    <!-- Mini Bars SVG -->
                    <div class="w-24 h-8 flex items-end gap-1.5 justify-end">
                        @for (int i = 0; i < 6; i++)
                        {
                            var heightPct = GetBarHeightPct(contextSnapshot.Finance.WeeklyExpenseTrend, i);
                            <div class="w-2 rounded-t bg-cyan-400/80 transition-all duration-300" style="height: @(Math.Max(15, heightPct))%;"></div>
                        }
                    </div>
                </div>
            </AtlasSurface>

        </div>

        <!-- 3. MAIN 3-COLUMN STRUCTURED GRID -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            
            <!-- COLUMN 1: Agenda de hoy (Señales de Atención) + Hábitos -->
            <div class="space-y-5">
                
                <!-- Agenda de hoy / Atención prioritaria -->
                <AtlasPanel Title="Atención de hoy" ActionText="Ver todo" OnAction="@(() => NavigationManager.NavigateTo("habits-goals"))">
                    <Icon>
                        <span class="text-sm">📅</span>
                    </Icon>
                    <ChildContent>
                        <AtlasList IsEmpty="@(contextSnapshot.AttentionSignals.Count == 0)" EmptyTitle="Todo al día" EmptyDescription="No tenés acciones ni hábitos pendientes para hoy.">
                            @foreach (var signal in contextSnapshot.AttentionSignals.Take(4))
                            {
                                <AtlasListItem 
                                    Title="@signal.Title" 
                                    Subtitle="@signal.Message" 
                                    MetaText="@(signal.Priority == AtlasSignalPriority.High ? "Prioritario" : null)">
                                    <PrefixContent>
                                        @if (!string.IsNullOrWhiteSpace(signal.AssociatedCommandId))
                                        {
                                            <button 
                                                type="button" 
                                                @onclick="() => ExecuteSignalActionAsync(signal)"
                                                class="w-4 h-4 rounded-full border border-slate-600 hover:border-emerald-400 hover:bg-emerald-500/20 transition-all cursor-pointer flex items-center justify-center text-transparent hover:text-emerald-400 text-[10px]"
                                                title="Completar acción">
                                                ✓
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="w-2 h-2 rounded-full @(signal.Priority == AtlasSignalPriority.High ? "bg-rose-400 shadow-glow-rose" : "bg-violet-400")"></span>
                                        }
                                    </PrefixContent>
                                </AtlasListItem>
                            }
                        </AtlasList>
                    </ChildContent>
                </AtlasPanel>

                <!-- Badges de Hábitos -->
                <AtlasPanel Title="Hábitos" ActionText="Ver todos" OnAction="@(() => NavigationManager.NavigateTo("habits-goals"))">
                    <Icon>
                        <span class="text-sm">🎯</span>
                    </Icon>
                    <ChildContent>
                        <div class="flex items-center gap-3 overflow-x-auto py-1.5 scrollbar-none">
                            @foreach (var habit in contextSnapshot.Habits.Items.Take(4))
                            {
                                <AtlasHabitBadge 
                                    Name="@habit.Name" 
                                    StreakDays="@habit.CurrentStreak" 
                                    IsCompleted="@habit.IsCompletedToday" 
                                    IconType="@habit.IconType" 
                                    ColorVariant="@habit.ColorVariant"
                                    OnClick="() => CompleteHabitAsync(habit.Id, habit.Name)" />
                            }

                            <!-- Botón circular punteado + Agregar hábito -->
                            <div class="flex flex-col items-center gap-1.5 select-none shrink-0">
                                <button 
                                    type="button" 
                                    @onclick="@(() => NavigationManager.NavigateTo("habits-goals"))"
                                    class="w-13 h-13 rounded-full border-2 border-dashed border-white/[0.18] hover:border-violet-400/60 hover:bg-white/[0.04] active:scale-95 transition-all flex items-center justify-center text-slate-400 hover:text-white cursor-pointer"
                                    title="Agregar nuevo hábito">
                                    <span class="text-lg font-light">+</span>
                                </button>
                                <span class="text-[11px] font-medium text-slate-400">Agregar</span>
                            </div>
                        </div>
                    </ChildContent>
                </AtlasPanel>

            </div>

            <!-- COLUMN 2: En progreso (Roadmaps) + Actividad reciente -->
            <div class="space-y-5">
                
                <!-- En progreso (Roadmaps) -->
                <AtlasPanel Title="En progreso" ActionText="Ver todo" OnAction="@(() => NavigationManager.NavigateTo("habits-goals"))">
                    <Icon>
                        <span class="text-sm">🚀</span>
                    </Icon>
                    <ChildContent>
                        <AtlasList IsEmpty="@(contextSnapshot.Roadmaps.Count == 0)" EmptyTitle="Sin roadmaps activos" EmptyDescription="Creá un roadmap para rastrear hitos hacia tus metas.">
                            @foreach (var rm in contextSnapshot.Roadmaps.Take(3))
                            {
                                <div class="p-3 rounded-xl bg-white/[0.03] border border-white/[0.06] space-y-2 select-none">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <div class="w-6 h-6 rounded-lg bg-white/[0.06] flex items-center justify-center text-xs shrink-0">
                                                @(rm.Color == "purple" ? "🛡️" : rm.Color == "cyan" ? "🇬🇧" : "⚡")
                                            </div>
                                            <span class="text-xs font-semibold text-white truncate">@rm.RoadmapTitle</span>
                                        </div>
                                        <span class="text-xs font-mono font-bold text-slate-300">@rm.ProgressPercentage%</span>
                                    </div>
                                    <AtlasProgress Value="@rm.ProgressPercentage" Color="@rm.Color" Height="sm" />
                                    @if (!string.IsNullOrWhiteSpace(rm.MilestoneTitle))
                                    {
                                        <span class="text-[10.5px] font-mono text-slate-400 block truncate">
                                            Próximo: @rm.MilestoneTitle
                                        </span>
                                    }
                                </div>
                            }
                        </AtlasList>
                    </ChildContent>
                </AtlasPanel>

                <!-- Actividad reciente -->
                <AtlasPanel Title="Actividad reciente" ActionText="Ver todos" OnAction="@(() => NavigationManager.NavigateTo("capture"))">
                    <Icon>
                        <span class="text-sm">⚡</span>
                    </Icon>
                    <ChildContent>
                        <AtlasList IsEmpty="@(contextSnapshot.RecentActivity.Count == 0)" EmptyTitle="Sin actividad registrada" EmptyDescription="Tus capturas, hábitos y gastos aparecerán acá.">
                            @foreach (var act in contextSnapshot.RecentActivity.Take(4))
                            {
                                <AtlasListItem 
                                    Title="@act.Title" 
                                    Subtitle="@act.Subtitle" 
                                    MetaText="@act.RelativeTime">
                                    <PrefixContent>
                                        <div class="w-6 h-6 rounded-lg flex items-center justify-center text-xs @GetActivityIconClass(act.ColorVariant)">
                                            @act.Icon
                                        </div>
                                    </PrefixContent>
                                </AtlasListItem>
                            }
                        </AtlasList>
                    </ChildContent>
                </AtlasPanel>

            </div>

            <!-- COLUMN 3: AI Toolbox + Integraciones activas -->
            <div class="space-y-5">
                
                <!-- AI Toolbox (Orbe 3D) -->
                <AtlasPanel Title="AI Toolbox" Variant="ai">
                    <Icon>
                        <span class="text-sm">✨</span>
                    </Icon>
                    <ChildContent>
                        <div class="flex items-center justify-between gap-3 pb-1">
                            <div class="space-y-0.5">
                                <span class="text-xs font-semibold text-white">Haz más con inteligencia.</span>
                                <p class="text-[11px] text-slate-300">Asistencia transversal con Gemini.</p>
                            </div>
                            <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-violet-600 via-purple-500 to-cyan-400 p-0.5 shadow-glow-purple animate-atlas-orb flex items-center justify-center shrink-0">
                                <div class="w-full h-full rounded-full bg-[#0e101f] flex items-center justify-center text-white text-xs font-mono font-bold">
                                    ✦
                                </div>
                            </div>
                        </div>

                        <!-- 4 Grid Tool Buttons -->
                        <div class="grid grid-cols-2 gap-2 pt-2">
                            <button 
                                type="button" 
                                @onclick="@(() => TriggerAiTool("resumen"))"
                                class="p-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.10] active:scale-95 border border-white/[0.08] text-left transition-all cursor-pointer group atlas-clickable">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-xs text-violet-300">📄</span>
                                    <span class="text-xs font-semibold text-slate-100 group-hover:text-white">Resumen</span>
                                </div>
                                <span class="text-[10px] text-slate-400 block truncate">De textos largos</span>
                            </button>

                            <button 
                                type="button" 
                                @onclick="@(() => TriggerAiTool("explicar"))"
                                class="p-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.10] active:scale-95 border border-white/[0.08] text-left transition-all cursor-pointer group atlas-clickable">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-xs text-cyan-300">🧠</span>
                                    <span class="text-xs font-semibold text-slate-100 group-hover:text-white">Explicar</span>
                                </div>
                                <span class="text-[10px] text-slate-400 block truncate">Conceptos clave</span>
                            </button>

                            <button 
                                type="button" 
                                @onclick="@(() => TriggerAiTool("reescribir"))"
                                class="p-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.10] active:scale-95 border border-white/[0.08] text-left transition-all cursor-pointer group atlas-clickable">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-xs text-emerald-300">✏️</span>
                                    <span class="text-xs font-semibold text-slate-100 group-hover:text-white">Reescribir</span>
                                </div>
                                <span class="text-[10px] text-slate-400 block truncate">Mejorar redacción</span>
                            </button>

                            <button 
                                type="button" 
                                @onclick="@(() => TriggerAiTool("traducir"))"
                                class="p-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.10] active:scale-95 border border-white/[0.08] text-left transition-all cursor-pointer group atlas-clickable">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-xs text-orange-300">🌐</span>
                                    <span class="text-xs font-semibold text-slate-100 group-hover:text-white">Traducir</span>
                                </div>
                                <span class="text-[10px] text-slate-400 block truncate">Cualquier idioma</span>
                            </button>
                        </div>

                        <!-- Full Width Action: Preguntar a ATLAS -->
                        <button 
                            type="button" 
                            @onclick="@(() => TriggerAiTool("pregunta"))"
                            class="w-full mt-2 p-2.5 rounded-xl bg-violet-500/15 hover:bg-violet-500/25 active:scale-[0.98] border border-violet-500/30 text-left transition-all cursor-pointer flex items-center justify-between group atlas-clickable">
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-violet-300">💬</span>
                                <span class="text-xs font-semibold text-violet-200 group-hover:text-white">Preguntar a ATLAS</span>
                            </div>
                            <span class="text-[10px] font-mono text-violet-300 opacity-75">Obtén respuestas →</span>
                        </button>
                    </ChildContent>
                </AtlasPanel>

                <!-- Integraciones activas -->
                <AtlasPanel Title="Integraciones activas" ActionText="Ver todas" OnAction="@(() => NavigationManager.NavigateTo("settings"))">
                    <Icon>
                        <span class="text-sm">📦</span>
                    </Icon>
                    <ChildContent>
                        <div class="flex items-center gap-2.5 py-1">
                            <!-- Telegram -->
                            <div class="w-9 h-9 rounded-full flex items-center justify-center transition-all cursor-pointer @(contextSnapshot.Integrations.HasTelegram ? "bg-[#229ED9]/20 border border-[#229ED9]/50 text-[#229ED9]" : "bg-white/[0.05] border border-white/[0.08] text-slate-500")" title="Telegram Bot">
                                <span class="text-xs font-bold">✈️</span>
                            </div>

                            <!-- Gmail -->
                            <div class="w-9 h-9 rounded-full flex items-center justify-center transition-all cursor-pointer @(contextSnapshot.Integrations.HasGmail ? "bg-[#EA4335]/20 border border-[#EA4335]/50 text-[#EA4335]" : "bg-white/[0.05] border border-white/[0.08] text-slate-500")" title="Gmail OAuth">
                                <span class="text-xs font-bold">✉️</span>
                            </div>

                            <!-- WhatsApp -->
                            <div class="w-9 h-9 rounded-full flex items-center justify-center bg-white/[0.05] border border-white/[0.08] text-slate-500 transition-all cursor-pointer" title="WhatsApp (Próximamente)">
                                <span class="text-xs font-bold">💬</span>
                            </div>

                            <!-- Mercado Pago -->
                            <div class="w-9 h-9 rounded-full flex items-center justify-center transition-all cursor-pointer @(contextSnapshot.Integrations.HasMercadoPago ? "bg-[#009EE3]/20 border border-[#009EE3]/50 text-[#009EE3]" : "bg-white/[0.05] border border-white/[0.08] text-slate-500")" title="Mercado Pago Sync">
                                <span class="text-xs font-bold">💳</span>
                            </div>

                            <!-- Supabase -->
                            <div class="w-9 h-9 rounded-full flex items-center justify-center transition-all cursor-pointer @(contextSnapshot.Integrations.HasSupabase ? "bg-emerald-500/20 border border-emerald-500/50 text-emerald-400" : "bg-white/[0.05] border border-white/[0.08] text-slate-500")" title="Supabase Sync">
                                <span class="text-xs font-bold">⚡</span>
                            </div>

                            <!-- Add Button -->
                            <button 
                                type="button" 
                                @onclick="@(() => NavigationManager.NavigateTo("settings"))"
                                class="w-9 h-9 rounded-full border border-dashed border-white/[0.20] hover:border-violet-400/60 hover:bg-white/[0.05] flex items-center justify-center text-slate-400 hover:text-white transition-all cursor-pointer"
                                title="Configurar integraciones">
                                <span class="text-sm font-light">+</span>
                            </button>
                        </div>
                    </ChildContent>
                </AtlasPanel>

            </div>

        </div>
    }

    <!-- 4. BOTTOM FLOATING PROMPT HERO -->
    <div class="pt-4">
        <AtlasCommandInput 
            @bind-Value="quickPromptText" 
            Placeholder="Pregúntale algo a ATLAS... (o escribí /expense, /note)" 
            IsExecuting="isExecutingPrompt"
            OnExecute="HandlePromptExecute" />
    </div>

</div>

@code {
    private AtlasContextSnapshot? contextSnapshot;
    private bool isLoading = true;
    private string searchQuery = string.Empty;
    private string quickPromptText = string.Empty;
    private bool isExecutingPrompt;
    private string? actionFeedback;
    private string? aiAnswer;

    protected override async Task OnInitializedAsync()
    {
        await ReloadContextAsync();
    }

    private async Task ReloadContextAsync()
    {
        isLoading = true;
        try
        {
            contextSnapshot = await AtlasContextService.GetCurrentContextAsync();
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error al cargar datos de contexto: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetFocusPercentage()
    {
        if (contextSnapshot == null || contextSnapshot.Habits.TotalCount == 0) return 100;
        return (int)Math.Round((contextSnapshot.Habits.CompletedTodayCount * 100.0) / contextSnapshot.Habits.TotalCount);
    }

    private string GetGreetingEmoji()
    {
        int hour = DateTime.Now.Hour;
        if (hour < 12) return "☀️";
        if (hour < 20) return "👋";
        return "🌙";
    }

    private async Task ExecuteSignalActionAsync(AtlasAttentionSignal signal)
    {
        if (string.IsNullOrWhiteSpace(signal.AssociatedCommandId)) return;

        try
        {
            var result = await CommandRegistry.ExecuteAsync(signal.AssociatedCommandId, signal.CommandParameters);
            if (result.IsSuccess)
            {
                actionFeedback = $"✓ Acción '{signal.Title}' ejecutada.";
                await ReloadContextAsync();
            }
            else
            {
                actionFeedback = $"⚠️ {result.ErrorMessage}";
            }
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error: {ex.Message}";
        }
    }

