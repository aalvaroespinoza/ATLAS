@page "/finance"
@inject ITransactionRepository TransactionRepository
@inject ICommandRegistry CommandRegistry

<div class="space-y-6 max-w-3xl pb-16 animate-atlas-in">
    
    <!-- Page Header & Typographic Balance Line (Anti-Dashboard: No Cards) -->
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 border-b border-white/[0.08] pb-4">
        <div class="space-y-1">
            <h1 class="text-lg font-bold tracking-tight text-white">
                Finanzas
            </h1>
            <div class="flex items-center gap-3 font-mono text-xs text-slate-400">
                <span>Balance: <strong class="text-white font-semibold">$@((totalIncome - totalExpense).ToString("N0", new CultureInfo("es-AR")))</strong></span>
                <span>•</span>
                <span class="text-emerald-400 font-semibold">+$@totalIncome.ToString("N0", new CultureInfo("es-AR"))</span>
                <span>•</span>
                <span class="text-slate-300 font-semibold">-$@totalExpense.ToString("N0", new CultureInfo("es-AR"))</span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(actionFeedback))
        {
            <span class="text-xs font-mono @(isFeedbackSuccess ? "text-emerald-400" : "text-rose-400") animate-atlas-in">
                @(isFeedbackSuccess ? "✓ " : "✕ ") @actionFeedback
            </span>
        }
    </div>

    <!-- Quick Add Expense / Income Input Bar -->
    <div class="atlas-surface rounded-2xl p-3.5 flex flex-col sm:flex-row items-center gap-2.5">
        <div class="w-full sm:w-36">
            <AtlasInput 
                Type="number"
                @bind-Value="amountString" 
                Placeholder="Monto ($)..." />
        </div>

        <div class="flex-1 w-full">
            <AtlasInput 
                @bind-Value="newDescription" 
                Placeholder="Descripción (ej: Supermercado, Alquiler, Transferencia)..." />
        </div>
        
        <AtlasButton 
            Variant="primary" 
            Size="md" 
            OnClick="AddExpenseAsync">
            + Registrar
        </AtlasButton>
    </div>

    <!-- Grouped Transactions Stream -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <AtlasSectionHeader 
                Title="Movimientos Registrados" 
                Count="@transactions.Count" />
        </div>

        @if (isLoading)
        {
            <AtlasLoadingState Message="Cargando finanzas..." />
        }
        else if (transactions.Count == 0)
        {
            <AtlasEmptyState 
                Title="No hay transacciones registradas" 
                Description="Registrá tu primer movimiento arriba o mediante el atajo Ctrl+Space (/expense)." />
        }
        else
        {
            <div class="atlas-surface rounded-2xl divide-y divide-white/[0.04] overflow-hidden">
                @foreach (var tx in transactions)
                {
                    var isIncome = tx.Tipo == "income";
                    var amountStr = $"{(isIncome ? "+" : "-")}${tx.Monto.ToString("N0", new CultureInfo("es-AR"))}";

                    <AtlasListItem 
                        Title="@tx.Descripcion" 
                        Subtitle="@($"{tx.Fecha.ToLocalTime():dd MMM yyyy HH:mm} • {tx.Origen}")"
                        MetaText="@amountStr"
                        Class="group">
                        <PrefixContent>
                            <span class="w-2 h-2 rounded-full @(isIncome ? "bg-emerald-400" : "bg-slate-500")"></span>
                        </PrefixContent>
                        <SuffixContent>
                            <span class="font-mono text-xs font-semibold @(isIncome ? "text-emerald-400" : "text-slate-200")">
                                @amountStr
                            </span>
                        </SuffixContent>
                    </AtlasListItem>
                }
            </div>
        }
    </div>

</div>

@code {
    private List<Transaction> transactions = [];
    private bool isLoading = true;
    private decimal totalIncome;
    private decimal totalExpense;

    private string amountString = string.Empty;
    private string newDescription = string.Empty;
    private string? actionFeedback;
    private bool isFeedbackSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactionsAsync();
    }

    private async Task LoadTransactionsAsync()
    {
        isLoading = true;
        try
        {
            var txs = await TransactionRepository.GetRecentAsync(100);
            transactions = txs.ToList();

            totalIncome = transactions.Where(t => t.Tipo == "income").Sum(t => t.Monto);
            totalExpense = transactions.Where(t => t.Tipo == "expense").Sum(t => t.Monto);
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error: {ex.Message}";
            isFeedbackSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddExpenseAsync()
    {
        if (string.IsNullOrWhiteSpace(amountString) || !decimal.TryParse(amountString, NumberStyles.Any, CultureInfo.InvariantCulture, out var amount) || amount <= 0)
        {
            actionFeedback = "Ingresá un monto numérico válido.";
            isFeedbackSuccess = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(newDescription))
        {
            actionFeedback = "Ingresá una descripción para el movimiento.";
            isFeedbackSuccess = false;
            return;
        }

        try
        {
            var res = await CommandRegistry.ExecuteAsync(FinanceAddTransactionCommand.CommandId, new Dictionary<string, object?>
            {
                ["amount"] = amount,
                ["description"] = newDescription.Trim(),
                ["type"] = "expense",
                ["origin"] = "manual"
            });

            if (res.IsSuccess)
            {
                amountString = string.Empty;
                newDescription = string.Empty;
                actionFeedback = "Gasto registrado exitosamente.";
                isFeedbackSuccess = true;
                _ = Task.Delay(2500).ContinueWith(_ => { actionFeedback = null; InvokeAsync(StateHasChanged); });
                await LoadTransactionsAsync();
            }
            else
            {
                actionFeedback = res.ErrorMessage ?? "Error al registrar gasto.";
                isFeedbackSuccess = false;
            }
        }
        catch (Exception ex)
        {
            actionFeedback = ex.Message;
            isFeedbackSuccess = false;
        }
    }
}
