@page "/design-preview"
@using ATLAS.UI.Components.Common

<div class="space-y-8 pb-24 max-w-5xl mx-auto animate-atlas-in">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/[0.08]">
        <div>
            <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 rounded-full bg-violet-400 shadow-glow-purple"></span>
                <h1 class="text-xl font-bold text-white tracking-tight">
                    ATLAS Master Design System — Preview
                </h1>
            </div>
            <p class="text-xs text-slate-400 mt-1 font-mono">
                Validación visual de tokens, superficies, componentes y microinteracciones.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <AtlasBadge Variant="purple" Dot="true" Text="Dark Glassmorphism" />
            <AtlasBadge Variant="emerald" Dot="true" Text="Bioluminiscente" />
        </div>
    </div>

    <!-- 1. Surfaces & Elevation Section -->
    <div class="space-y-3">
        <AtlasSectionHeader Title="1. Superficies, Elevaciones & Glows" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <AtlasSurface Elevation="base" Class="p-5">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-slate-200">Base Surface</span>
                    <AtlasBadge Variant="neutral" Text="0 12px 28px" />
                </div>
                <p class="text-xs text-slate-400">Superficie estándar satinada con backdrop blur y borde milimétrico superior.</p>
            </AtlasSurface>

            <AtlasSurface Elevation="elevated" Glow="purple" IsInteractive="true" Class="p-5">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-white">Elevated + Glow Purple</span>
                    <AtlasBadge Variant="purple" Dot="true" Text="Hover Lift" />
                </div>
                <p class="text-xs text-slate-300">Superficie elevada con halo violeta para elementos de foco o acción prioritaria.</p>
            </AtlasSurface>

            <AtlasSurface Elevation="floating" Glow="cyan" IsInteractive="true" Class="p-5">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-white">Floating Surface</span>
                    <AtlasBadge Variant="cyan" Dot="true" Text="Z-20" />
                </div>
                <p class="text-xs text-slate-300">Superficie flotante con sombra profunda para paneles y modales.</p>
            </AtlasSurface>
        </div>
    </div>

    <!-- 2. Master Panels Section -->
    <div class="space-y-3">
        <AtlasSectionHeader Title="2. AtlasPanel (Estructuras de Módulo)" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            
            <!-- Standard Panel -->
            <AtlasPanel Title="Agenda de hoy" ActionText="Ver calendario" Variant="standard">
                <Icon>
                    <span class="text-sm">📅</span>
                </Icon>
                <ChildContent>
                    <div class="space-y-2">
                        <AtlasListItem Title="Estudiar redes y routing" Subtitle="Módulo 4: Protocolos BGP" MetaText="90 min" />
                        <AtlasListItem Title="Revisar proyecto ATLAS" Subtitle="Validación de componentes" MetaText="3 h" IsCompleted="true" />
                    </div>
                </ChildContent>
            </AtlasPanel>

            <!-- Metric Panel -->
            <AtlasPanel Title="Racha de hábitos" ActionText="✕" Variant="metric">
                <Icon>
                    <span class="text-sm">🔥</span>
                </Icon>
                <ChildContent>
                    <div class="flex items-baseline justify-between pt-1">
                        <div>
                            <span class="text-3xl font-extrabold text-white font-sans tracking-tight">12</span>
                            <span class="text-xs text-slate-400 ml-1">días</span>
                            <p class="text-[11px] text-orange-400 font-medium mt-0.5">¡Vamos así!</p>
                        </div>
                        <div class="w-24 h-8 flex items-center">
                            <!-- SVG Sparkline Mock -->
                            <svg class="w-full h-full text-orange-400 overflow-visible" viewBox="0 0 100 30" fill="none">
                                <path d="M0 25 Q 25 5, 50 18 T 100 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                                <circle cx="100" cy="8" r="3.5" fill="currentColor" class="animate-pulse" />
                            </svg>
                        </div>
                    </div>
                </ChildContent>
            </AtlasPanel>

            <!-- AI Panel -->
            <AtlasPanel Title="AI Toolbox" ActionText="Haz más" Variant="ai">
                <Icon>
                    <span class="text-sm">✨</span>
                </Icon>
                <ChildContent>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-violet-600 via-purple-500 to-cyan-400 animate-atlas-orb flex items-center justify-center text-xs font-bold text-white shadow-glow-purple">
                            AI
                        </div>
                        <div class="space-y-0.5">
                            <span class="text-xs font-semibold text-white">Núcleo Inteligente</span>
                            <p class="text-[11px] text-slate-300">Asistencia transversal silenciosa.</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-1.5 pt-2">
                        <AtlasButton Variant="accent" Size="sm">Resumen</AtlasButton>
                        <AtlasButton Variant="accent" Size="sm">Explicar</AtlasButton>
                    </div>
                </ChildContent>
            </AtlasPanel>

        </div>
    </div>

    <!-- 3. Search & Command Inputs Section -->
    <div class="space-y-3">
        <AtlasSectionHeader Title="3. Buscadores & Command Inputs" />
        <div class="space-y-4 p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
            
            <div>
                <span class="text-xs font-mono text-slate-400 block mb-1.5">AtlasSearch (Header Central):</span>
                <AtlasSearch @bind-Value="searchDemo" />
            </div>

            <div>
                <span class="text-xs font-mono text-slate-400 block mb-1.5">AtlasCommandInput (Barra Flotante Inferior):</span>
                <AtlasCommandInput @bind-Value="commandDemo" OnExecute="HandleExecuteDemo" />
            </div>

            <div>
                <span class="text-xs font-mono text-slate-400 block mb-1.5">AtlasInput (Estándar):</span>
                <div class="max-w-md">
                    <AtlasInput @bind-Value="inputDemo" Placeholder="Nombre del hábito o nota..." />
                </div>
            </div>

        </div>
    </div>

    <!-- 4. Buttons, IconButtons & Avatars Section -->
    <div class="space-y-3">
        <AtlasSectionHeader Title="4. Botones, Iconos & Avatares" />
        <div class="flex flex-wrap items-center gap-3 p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
            
            <AtlasButton Variant="hero-glow" Size="md" ShortcutText="Ctrl+N">
                Hero Glow Button
            </AtlasButton>

            <AtlasButton Variant="primary" Size="md" ShortcutText="↵">
                Primary Action
            </AtlasButton>

            <AtlasButton Variant="secondary" Size="md">
                Secondary
            </AtlasButton>

            <AtlasButton Variant="ghost" Size="md">
                Ghost Button
            </AtlasButton>

            <AtlasButton Variant="danger" Size="md">
                Danger
            </AtlasButton>

            <AtlasButton Variant="primary" Size="md" IsLoading="true">
                Guardando
            </AtlasButton>

            <AtlasDivider IsVertical="true" Class="h-8" />

            <AtlasIconButton Variant="hero-glow" Shape="circle" Size="md" Title="Crear nuevo">
                <span>+</span>
            </AtlasIconButton>

            <AtlasIconButton Variant="secondary" Shape="rounded" Size="md" Title="Configuración">
                <span>⚙️</span>
            </AtlasIconButton>

            <AtlasIconButton Variant="accent" Shape="circle" Size="md" Glow="purple" Title="IA">
                <span>✨</span>
            </AtlasIconButton>

            <AtlasDivider IsVertical="true" Class="h-8" />

            <AtlasAvatar Name="Álvaro Espinoza" IsOnline="true" Size="md" />
            <AtlasAvatar Name="Álvaro" IsOnline="false" Size="sm" />

        </div>
    </div>

    <!-- 5. Badges & Progress Bars Section -->
    <div class="space-y-3">
        <AtlasSectionHeader Title="5. Badges & Barras de Progreso" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
            
            <div class="space-y-2.5">
                <span class="text-xs font-mono text-slate-400 block">Píldoras Semánticas:</span>
                <div class="flex flex-wrap gap-2">
                    <AtlasBadge Variant="purple" Dot="true" Text="Metas & Roadmaps" />
                    <AtlasBadge Variant="emerald" Dot="true" Text="Hábitos de Hoy" />
                    <AtlasBadge Variant="orange" Dot="true" Text="Racha 12 Días" />
                    <AtlasBadge Variant="cyan" Dot="true" Text="Sincronizado" />
                    <AtlasBadge Variant="rose" Dot="true" Text="Gasto $8.450" />
                    <AtlasBadge Variant="neutral" Text="Solo Lectura" />
                </div>
            </div>

            <div class="space-y-3">
                <span class="text-xs font-mono text-slate-400 block">Barras de Progreso Líquidas:</span>
                <AtlasProgress Value="68" Label="Proyecto ATLAS" Color="gradient" ShowPercentage="true" />
                <AtlasProgress Value="42" Label="eJPT Certification" Color="cyan" ShowPercentage="true" />
                <AtlasProgress Value="85" Label="Enfoque de Hoy" Color="emerald" ShowPercentage="true" />
            </div>

        </div>
    </div>

    <!-- 6. State Components Section -->
    <div class="space-y-3">
        <AtlasSectionHeader Title="6. Estados (Loading, Empty, Error)" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <AtlasLoadingState Message="Sincronizando con base local..." />
            <AtlasEmptyState Title="Sin actividad reciente" Description="Tus capturas y transacciones aparecerán acá." />
            <AtlasErrorState Message="No se pudo conectar con el servicio." />
        </div>
    </div>

</div>

@code {
    private string searchDemo = string.Empty;
    private string commandDemo = string.Empty;
    private string inputDemo = string.Empty;

    private void HandleExecuteDemo(string? cmd)
    {
        commandDemo = string.Empty;
    }
}
