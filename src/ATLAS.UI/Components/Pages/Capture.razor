@page "/capture"
@inject ICommandRegistry CommandRegistry
@inject NavigationManager NavigationManager

<div class="space-y-6 max-w-2xl pb-16 animate-atlas-in">
    
    <!-- Clean Header & Status -->
    <div class="flex items-center justify-between border-b border-white/[0.08] pb-4">
        <div>
            <h1 class="text-lg font-bold tracking-tight text-white">
                Nueva Nota
            </h1>
        </div>

        <div class="flex items-center gap-3">
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <span class="text-xs font-mono @(isSuccess ? "text-emerald-400" : "text-rose-400") animate-atlas-in">
                    @(isSuccess ? "✓ " : "✕ ") @statusMessage
                </span>
            }

            <span class="text-[11px] font-mono text-slate-500">
                <kbd class="px-1.5 py-0.5 rounded bg-white/[0.06] text-slate-400">Ctrl+Enter</kbd> para guardar
            </span>
        </div>
    </div>

    <!-- Distraction-Free Draft Canvas (Craft / Linear Spirit) -->
    <div class="atlas-surface rounded-2xl p-6 md:p-8 space-y-4 shadow-xl">
        
        <!-- Borderless Hero Title Input -->
        <div>
            <input 
                type="text" 
                @bind="titleInput" 
                placeholder="Título de la nota (opcional)..." 
                class="w-full bg-transparent border-0 text-base md:text-lg font-semibold text-white placeholder-slate-500 focus:outline-none focus:ring-0 p-0 font-sans tracking-tight" />
        </div>

        <AtlasDivider />

        <!-- Clean Reading & Writing Textarea -->
        <div>
            <textarea 
                @bind="contentInput" 
                @onkeydown="HandleKeyDown"
                rows="8"
                placeholder="Escribí tu pensamiento, apunte, resumen o fragmento de código acá... (soporta Markdown)" 
                class="w-full bg-transparent border-0 text-xs md:text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-0 p-0 leading-relaxed font-sans resize-none"></textarea>
        </div>

        <!-- Tags Input Bar -->
        <div class="pt-2 border-t border-white/[0.04] flex items-center gap-2">
            <span class="text-[11px] font-mono text-slate-500">Tags:</span>
            <input 
                type="text" 
                @bind="tagsInput" 
                placeholder="ideas, trabajo, proyecto (separados por coma)" 
                class="flex-1 bg-transparent border-0 text-xs text-slate-300 placeholder-slate-600 focus:outline-none focus:ring-0 p-0 font-sans" />
        </div>

        <!-- Bottom Action Bar -->
        <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between">
            <div class="flex items-center gap-2 font-mono text-[11px] text-slate-500">
                <span>@(contentInput?.Length ?? 0) caracteres</span>
            </div>

            <div class="flex items-center gap-2">
                <AtlasButton 
                    Variant="secondary" 
                    Size="sm" 
                    OnClick="@(() => NavigationManager.NavigateTo("search"))">
                    Cancelar
                </AtlasButton>

                <AtlasButton 
                    Variant="primary" 
                    Size="sm" 
                    OnClick="SaveNoteAsync" 
                    IsLoading="isSaving">
                    Guardar en Segundo Cerebro
                </AtlasButton>
            </div>
        </div>

    </div>

</div>

@code {
    private string titleInput = string.Empty;
    private string contentInput = string.Empty;
    private string tagsInput = string.Empty;
    private bool isSaving;
    private string? statusMessage;
    private bool isSuccess;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter")
        {
            await SaveNoteAsync();
        }
    }

    private async Task SaveNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(contentInput))
        {
            statusMessage = "Escribí el contenido de la nota antes de guardar.";
            isSuccess = false;
            return;
        }

        if (isSaving) return;

        isSaving = true;
        statusMessage = null;

        try
        {
            var parameters = new Dictionary<string, object?>
            {
                ["content"] = contentInput.Trim(),
                ["title"] = string.IsNullOrWhiteSpace(titleInput) ? null : titleInput.Trim(),
                ["tags"] = string.IsNullOrWhiteSpace(tagsInput) ? null : tagsInput.Trim(),
                ["source"] = "desktop_app",
                ["type"] = "note"
            };

            var result = await CommandRegistry.ExecuteAsync(CaptureNoteCommand.CommandId, parameters);

            if (result.IsSuccess)
            {
                titleInput = string.Empty;
                contentInput = string.Empty;
                tagsInput = string.Empty;
                statusMessage = "Nota guardada exitosamente.";
                isSuccess = true;
                _ = Task.Delay(2500).ContinueWith(_ => { statusMessage = null; InvokeAsync(StateHasChanged); });
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al guardar la nota.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }
}
