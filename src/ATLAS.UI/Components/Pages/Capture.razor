@page "/capture"
@inject ICommandRegistry CommandRegistry

<div class="space-y-6 max-w-2xl">
    
    <!-- Page Header -->
    <div class="space-y-1 border-b border-white/[0.06] pb-4">
        <h1 class="text-base font-semibold tracking-tight text-white">
            Capturar Conocimiento
        </h1>
        <p class="text-xs text-slate-400">
            Redactá y guardá notas, ideas o fragmentos en tu Second Brain.
        </p>
    </div>

    <!-- Notification / Status Banner -->
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="px-4 py-2.5 rounded-lg border text-xs flex items-center justify-between transition-all @(isSuccess ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-300" : "bg-rose-500/10 border-rose-500/20 text-rose-300")">
            <span>@(isSuccess ? "✓ " : "✕ ") @statusMessage</span>
            <button @onclick="() => statusMessage = null" class="text-slate-400 hover:text-white text-xs">✕</button>
        </div>
    }

    <!-- Capture Form -->
    <div class="p-6 rounded-xl bg-white/[0.02] border border-white/[0.06] space-y-4">
        
        <!-- Title (Optional) -->
        <div class="space-y-1">
            <label for="note-title" class="text-[11px] font-mono uppercase tracking-wider text-slate-400">
                Título <span class="text-slate-400 font-normal lowercase">(opcional)</span>
            </label>
            <input 
                id="note-title"
                type="text" 
                @bind="titleInput" 
                placeholder="Título o resumen del apunte..." 
                class="w-full px-3.5 py-2 rounded-lg bg-white/[0.03] border border-white/[0.08] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-white/20 transition-all font-sans" />
        </div>

        <!-- Content (Required) -->
        <div class="space-y-1">
            <label for="note-content" class="text-[11px] font-mono uppercase tracking-wider text-slate-400">
                Contenido <span class="text-sky-400">*</span>
            </label>
            <textarea 
                id="note-content"
                @bind="contentInput" 
                rows="7"
                placeholder="Escribí tu apunte, nota o conocimiento acá (soporta Markdown)..." 
                class="w-full px-3.5 py-2.5 rounded-lg bg-white/[0.03] border border-white/[0.08] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-white/20 transition-all resize-y leading-relaxed font-sans"></textarea>
        </div>

        <!-- Tags (Optional) -->
        <div class="space-y-1">
            <label for="note-tags" class="text-[11px] font-mono uppercase tracking-wider text-slate-400">
                Tags <span class="text-slate-400 font-normal lowercase">(separados por coma)</span>
            </label>
            <input 
                id="note-tags"
                type="text" 
                @bind="tagsInput" 
                placeholder="ej: ideas, trabajo, lectura" 
                class="w-full px-3.5 py-2 rounded-lg bg-white/[0.03] border border-white/[0.08] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-white/20 transition-all font-sans" />
        </div>

        <!-- Action Bar -->
        <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between gap-4">
            <button 
                type="button"
                @onclick="SaveNoteAsync" 
                disabled="@isSaving"
                class="px-4 py-2 rounded-lg bg-white/[0.08] hover:bg-white/[0.14] disabled:opacity-50 text-white font-medium text-xs border border-white/[0.1] transition-all flex items-center gap-2 cursor-pointer disabled:cursor-not-allowed">
                @if (isSaving)
                {
                    <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                    </svg>
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar Nota</span>
                }
            </button>

            <span class="text-[11px] font-mono text-slate-400">
                También con <kbd class="px-1 py-0.5 rounded bg-white/[0.06] text-[10px]">Ctrl+Space</kbd>
            </span>
        </div>

    </div>

</div>

@code {
    private string titleInput = string.Empty;
    private string contentInput = string.Empty;
    private string tagsInput = string.Empty;
    private bool isSaving;
    private string? statusMessage;
    private bool isSuccess;

    private async Task SaveNoteAsync()
    {
        if (isSaving) return;

        if (string.IsNullOrWhiteSpace(contentInput))
        {
            statusMessage = "Por favor escribí el contenido de la nota.";
            isSuccess = false;
            return;
        }

        isSaving = true;
        statusMessage = null;

        try
        {
            var parameters = new Dictionary<string, object?>
            {
                ["content"] = contentInput.Trim(),
                ["title"] = string.IsNullOrWhiteSpace(titleInput) ? null : titleInput.Trim(),
                ["tags"] = string.IsNullOrWhiteSpace(tagsInput) ? null : tagsInput.Trim(),
                ["source"] = "desktop_app",
                ["type"] = "note"
            };

            var result = await CommandRegistry.ExecuteAsync(CaptureNoteCommand.CommandId, parameters);

            if (result.IsSuccess)
            {
                titleInput = string.Empty;
                contentInput = string.Empty;
                tagsInput = string.Empty;
                statusMessage = "Nota guardada exitosamente.";
                isSuccess = true;
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al guardar la nota.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }
}
