@page "/capture"
@inject ICommandRegistry CommandRegistry

<div class="space-y-6 max-w-3xl">
    
    <!-- Page Header -->
    <div class="space-y-1">
        <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400/50"></span>
            Capturar
        </h1>
        <p class="text-xs text-slate-400">
            Redactá y guardá notas, ideas o conocimiento en tu Second Brain.
        </p>
    </div>

    <!-- Notification / Status Banner -->
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="p-3.5 rounded-xl border flex items-center justify-between transition-all duration-300 @(isSuccess ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-300" : "bg-rose-500/10 border-rose-500/30 text-rose-300")">
            <div class="flex items-center gap-2.5 text-xs font-medium">
                @if (isSuccess)
                {
                    <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                }
                else
                {
                    <svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                }
                <span>@statusMessage</span>
            </div>
            <button @onclick="() => statusMessage = null" class="text-slate-400 hover:text-slate-200 text-xs p-1">
                ✕
            </button>
        </div>
    }

    <!-- Glassmorphic Capture Form -->
    <div class="p-6 md:p-8 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl shadow-2xl space-y-5">
        
        <!-- Title (Optional) -->
        <div class="space-y-1.5">
            <label for="note-title" class="text-xs font-semibold uppercase tracking-wider text-slate-400 flex items-center justify-between">
                <span>Título <span class="text-slate-500 font-normal lowercase">(opcional)</span></span>
            </label>
            <input 
                id="note-title"
                type="text" 
                @bind="titleInput" 
                placeholder="Ej: Resumen reunión semanal, Arquitectura de plugin..." 
                class="w-full px-4 py-2.5 rounded-xl bg-slate-950/70 border border-slate-800 text-slate-100 text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/30 transition-all" />
        </div>

        <!-- Content (Required) -->
        <div class="space-y-1.5">
            <label for="note-content" class="text-xs font-semibold uppercase tracking-wider text-slate-400 flex items-center justify-between">
                <span>Contenido <span class="text-emerald-400">*</span></span>
                <span class="text-[11px] text-slate-500 font-normal">Markdown soportado</span>
            </label>
            <textarea 
                id="note-content"
                @bind="contentInput" 
                rows="8"
                placeholder="Escribí tu pensamiento, apunte o conocimiento acá..." 
                class="w-full px-4 py-3 rounded-xl bg-slate-950/70 border border-slate-800 text-slate-100 text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/30 transition-all resize-y leading-relaxed font-sans"></textarea>
        </div>

        <!-- Tags (Optional) -->
        <div class="space-y-1.5">
            <label for="note-tags" class="text-xs font-semibold uppercase tracking-wider text-slate-400 flex items-center justify-between">
                <span>Tags <span class="text-slate-500 font-normal lowercase">(separados por coma o espacio)</span></span>
            </label>
            <input 
                id="note-tags"
                type="text" 
                @bind="tagsInput" 
                placeholder="ej: ideas, trabajo, lectura" 
                class="w-full px-4 py-2.5 rounded-xl bg-slate-950/70 border border-slate-800 text-slate-100 text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/30 transition-all" />
        </div>

        <!-- Action Bar -->
        <div class="pt-3 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4">
            
            <button 
                type="button"
                @onclick="SaveNoteAsync" 
                disabled="@isSaving"
                class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white font-medium text-xs shadow-lg shadow-emerald-600/20 hover:shadow-emerald-500/30 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer disabled:cursor-not-allowed">
                @if (isSaving)
                {
                    <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                    </svg>
                    <span>Guardando...</span>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                    </svg>
                    <span>Guardar Nota</span>
                }
            </button>

            <span class="text-[11px] text-slate-500 text-center sm:text-right">
                Tip: También podés capturar con el Launcher flotante (<kbd class="px-1 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-400 font-mono text-[10px]">Ctrl+Space</kbd>).
            </span>

        </div>

    </div>

</div>

@code {
    private string titleInput = string.Empty;
    private string contentInput = string.Empty;
    private string tagsInput = string.Empty;
    private bool isSaving;
    private string? statusMessage;
    private bool isSuccess;

    private async Task SaveNoteAsync()
    {
        if (isSaving) return;

        if (string.IsNullOrWhiteSpace(contentInput))
        {
            statusMessage = "Por favor escribí el contenido de la nota.";
            isSuccess = false;
            return;
        }

        isSaving = true;
        statusMessage = null;

        try
        {
            var parameters = new Dictionary<string, object?>
            {
                ["content"] = contentInput.Trim(),
                ["title"] = string.IsNullOrWhiteSpace(titleInput) ? null : titleInput.Trim(),
                ["tags"] = string.IsNullOrWhiteSpace(tagsInput) ? null : tagsInput.Trim(),
                ["source"] = "desktop_app",
                ["type"] = "note"
            };

            var result = await CommandRegistry.ExecuteAsync(CaptureNoteCommand.CommandId, parameters);

            if (result.IsSuccess)
            {
                titleInput = string.Empty;
                contentInput = string.Empty;
                tagsInput = string.Empty;
                statusMessage = "✓ Nota guardada exitosamente en ATLAS.";
                isSuccess = true;
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al guardar la nota.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }
}
