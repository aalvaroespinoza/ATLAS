@page "/capture"
@inject ICommandRegistry CommandRegistry
@inject NavigationManager NavigationManager

<div class="space-y-6 max-w-2xl pb-16 animate-atlas-in">
    
    <!-- Clean Header & Status -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/[0.08] pb-4">
        <div>
            <h1 class="text-lg font-bold tracking-tight text-white flex items-center gap-2">
                <span>Nueva Nota</span>
            </h1>
            <p class="text-xs text-slate-400">
                Captura rápida sin fricción hacia tu Segundo Cerebro.
            </p>
        </div>

        <div class="flex items-center gap-3">
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <span class="px-3 py-1 rounded-xl text-xs font-mono font-medium @(isSuccess ? "bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 shadow-sm shadow-emerald-500/10" : "bg-rose-500/15 text-rose-300 border border-rose-500/30 shadow-sm shadow-rose-500/10") animate-atlas-in">
                    @(isSuccess ? "✓ " : "✕ ") @statusMessage
                </span>
            }

            <span class="text-[11px] font-mono text-slate-500">
                <kbd class="px-2 py-0.5 rounded-lg bg-white/[0.06] border border-white/[0.08] text-slate-300 shadow-sm">Ctrl+Enter</kbd> para guardar
            </span>
        </div>
    </div>

    <!-- Distraction-Free Draft Canvas (Craft & Linear Spirit with Rich Depth) -->
    <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-b from-[#141a29]/90 to-[#0e1320]/90 border border-white/[0.08] shadow-2xl shadow-black/50 space-y-4 backdrop-blur-md">
        
        <!-- Borderless Hero Title Input -->
        <div>
            <input 
                type="text" 
                @bind="titleInput" 
                placeholder="Título de la nota (opcional)..." 
                class="w-full bg-transparent border-0 text-base md:text-lg font-semibold text-white placeholder-slate-500 focus:outline-none focus:ring-0 p-0 font-sans tracking-tight" />
        </div>

        <div class="h-px bg-white/[0.06]"></div>

        <!-- Clean Reading & Writing Textarea -->
        <div>
            <textarea 
                @bind="contentInput" 
                @onkeydown="HandleKeyDown"
                rows="8"
                placeholder="Escribí tu pensamiento, apunte, resumen o fragmento de código acá... (soporta Markdown)" 
                class="w-full bg-transparent border-0 text-xs md:text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-0 p-0 leading-relaxed font-sans resize-none"></textarea>
        </div>

        <!-- Tags Input Bar -->
        <div class="pt-3 border-t border-white/[0.04] flex items-center gap-2">
            <span class="text-[11px] font-mono text-slate-400">Tags:</span>
            <input 
                type="text" 
                @bind="tagsInput" 
                placeholder="ideas, trabajo, proyecto (separados por coma)" 
                class="flex-1 bg-transparent border-0 text-xs text-slate-300 placeholder-slate-600 focus:outline-none focus:ring-0 p-0 font-sans" />
        </div>

        <!-- Bottom Action Bar -->
        <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between flex-wrap gap-3">
            <div class="flex items-center gap-2 font-mono text-[11px] text-slate-500">
                <span>@(contentInput?.Length ?? 0) caracteres</span>
            </div>

            <div class="flex items-center gap-2.5">
                <button 
                    type="button" 
                    @onclick="@(() => NavigationManager.NavigateTo("search"))"
                    class="h-8 px-3.5 rounded-xl text-xs font-medium text-slate-400 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] active:scale-[0.98] border border-white/[0.06] transition-all cursor-pointer">
                    Cancelar
                </button>

                <button 
                    type="button" 
                    @onclick="SaveNoteAsync" 
                    disabled="@isSaving"
                    class="h-8.5 px-4 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] transition-all border border-indigo-400/30 shadow-md shadow-indigo-500/20 cursor-pointer disabled:opacity-50">
                    @(isSaving ? "Guardando..." : "Guardar en Segundo Cerebro")
                </button>
            </div>
        </div>

    </div>

</div>

@code {
    private string titleInput = string.Empty;
    private string contentInput = string.Empty;
    private string tagsInput = string.Empty;
    private bool isSaving;
    private string? statusMessage;
    private bool isSuccess;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter")
        {
            await SaveNoteAsync();
        }
    }

    private async Task SaveNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(contentInput))
        {
            statusMessage = "Escribí el contenido de la nota antes de guardar.";
            isSuccess = false;
            return;
        }

        if (isSaving) return;

        isSaving = true;
        statusMessage = null;

        try
        {
            var parameters = new Dictionary<string, object?>
            {
                ["content"] = contentInput.Trim(),
                ["title"] = string.IsNullOrWhiteSpace(titleInput) ? null : titleInput.Trim(),
                ["tags"] = string.IsNullOrWhiteSpace(tagsInput) ? null : tagsInput.Trim(),
                ["source"] = "desktop_app",
                ["type"] = "note"
            };

            var result = await CommandRegistry.ExecuteAsync(CaptureNoteCommand.CommandId, parameters);

            if (result.IsSuccess)
            {
                titleInput = string.Empty;
                contentInput = string.Empty;
                tagsInput = string.Empty;
                statusMessage = "Nota guardada exitosamente.";
                isSuccess = true;
                _ = Task.Delay(2500).ContinueWith(_ => { statusMessage = null; InvokeAsync(StateHasChanged); });
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al guardar la nota.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }
}
