@page "/search"
@inject INoteRepository NoteRepository
@inject IGoalRepository GoalRepository
@inject IHabitRepository HabitRepository
@inject IRoadmapRepository RoadmapRepository
@inject ITransactionRepository TransactionRepository
@inject ICommandRegistry CommandRegistry
@inject NavigationManager NavigationManager

<div class="h-[calc(100vh-6.5rem)] flex flex-col space-y-3 animate-atlas-in">
    
    <!-- Top Search Header & Category Filter Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex-1 max-w-lg">
            <AtlasSearchInput 
                @bind-Value="searchQuery" 
                Placeholder="Buscar notas, roadmaps, hábitos, finanzas..." />
        </div>

        <!-- Filter Chips (Visible and Interactive) -->
        <div class="flex items-center gap-1.5 overflow-x-auto text-[11px] font-mono select-none">
            <button 
                type="button" 
                @onclick="@(() => SetFilter("all"))"
                class="px-2.5 py-1 rounded-lg transition-colors @(selectedFilter == "all" ? "bg-indigo-600 text-white font-semibold shadow-sm shadow-indigo-500/25" : "bg-white/[0.04] text-slate-400 hover:text-slate-200")">
                Todos (@TotalResultCount)
            </button>
            <button 
                type="button" 
                @onclick="@(() => SetFilter("notes"))"
                class="px-2.5 py-1 rounded-lg transition-colors @(selectedFilter == "notes" ? "bg-indigo-600 text-white font-semibold shadow-sm shadow-indigo-500/25" : "bg-white/[0.04] text-slate-400 hover:text-slate-200")">
                Notas (@filteredNotes.Count)
            </button>
            <button 
                type="button" 
                @onclick="@(() => SetFilter("roadmaps"))"
                class="px-2.5 py-1 rounded-lg transition-colors @(selectedFilter == "roadmaps" ? "bg-indigo-600 text-white font-semibold shadow-sm shadow-indigo-500/25" : "bg-white/[0.04] text-slate-400 hover:text-slate-200")">
                Roadmaps (@filteredRoadmaps.Count)
            </button>
            <button 
                type="button" 
                @onclick="@(() => SetFilter("habits"))"
                class="px-2.5 py-1 rounded-lg transition-colors @(selectedFilter == "habits" ? "bg-indigo-600 text-white font-semibold shadow-sm shadow-indigo-500/25" : "bg-white/[0.04] text-slate-400 hover:text-slate-200")">
                Hábitos (@filteredHabits.Count)
            </button>
            <button 
                type="button" 
                @onclick="@(() => SetFilter("finance"))"
                class="px-2.5 py-1 rounded-lg transition-colors @(selectedFilter == "finance" ? "bg-indigo-600 text-white font-semibold shadow-sm shadow-indigo-500/25" : "bg-white/[0.04] text-slate-400 hover:text-slate-200")">
                Finanzas (@filteredTransactions.Count)
            </button>
        </div>
    </div>

    <!-- Master-Detail Split View (Craft & Linear Spatial Layout) -->
    <div class="flex-1 flex min-h-0 rounded-2xl atlas-surface overflow-hidden">
        
        <!-- Left Panel: Grouped Search Results (40%) -->
        <div class="w-full md:w-[38%] border-r border-white/[0.06] flex flex-col overflow-hidden bg-[#0d111a]">
            
            <div class="flex-1 overflow-y-auto p-2 space-y-4">
                @if (isLoading)
                {
                    <AtlasLoadingState Message="Buscando en SQLite..." />
                }
                else if (TotalResultCount == 0)
                {
                    <div class="py-12 px-4 text-center space-y-1 select-none">
                        <p class="text-xs font-medium text-slate-400">Sin coincidencias para "@searchQuery"</p>
                        <p class="text-[11px] text-slate-500">Probá con otra palabra clave o capturá una nueva nota.</p>
                    </div>
                }
                else
                {
                    <!-- 1. GROUP: KNOWLEDGE / NOTAS (Only if non-empty and filter matches) -->
                    @if (ShouldShow("notes") && filteredNotes.Count > 0)
                    {
                        <div class="space-y-1">
                            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider px-2 font-semibold">
                                Knowledge / Notas (@filteredNotes.Count)
                            </span>
                            <div class="space-y-0.5">
                                @foreach (var note in filteredNotes)
                                {
                                    var isSel = selectedItem?.Id == note.Id;
                                    <div 
                                        @onclick="() => SelectNote(note)"
                                        class="p-2.5 rounded-xl cursor-pointer transition-all @(isSel ? "bg-indigo-500/15 border border-indigo-500/30 text-white font-semibold" : "hover:bg-white/[0.03] text-slate-300")">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-xs truncate font-medium">@GetNoteTitle(note)</span>
                                            <span class="text-[10px] font-mono text-slate-500 shrink-0">@note.CreatedAt.ToLocalTime().ToString("dd MMM")</span>
                                        </div>
                                        <p class="text-[11px] text-slate-400 line-clamp-1 pt-0.5 font-normal">
                                            @note.Content
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- 2. GROUP: ROADMAPS (Only if non-empty and filter matches) -->
                    @if (ShouldShow("roadmaps") && filteredRoadmaps.Count > 0)
                    {
                        <div class="space-y-1">
                            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider px-2 font-semibold">
                                Roadmaps & Metas (@filteredRoadmaps.Count)
                            </span>
                            <div class="space-y-0.5">
                                @foreach (var r in filteredRoadmaps)
                                {
                                    var isSel = selectedItem?.Id == r.Id;
                                    <div 
                                        @onclick="() => SelectRoadmap(r)"
                                        class="p-2.5 rounded-xl cursor-pointer transition-all @(isSel ? "bg-indigo-500/15 border border-indigo-500/30 text-white font-semibold" : "hover:bg-white/[0.03] text-slate-300")">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-xs truncate font-medium">@r.Title</span>
                                            <span class="text-[10px] font-mono text-indigo-300 font-semibold">@r.ProgressPercentage%</span>
                                        </div>
                                        <span class="text-[10px] font-mono text-slate-500">@(r.Milestones?.Count ?? 0) hitos configurados</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- 3. GROUP: HABITS (Only if non-empty and filter matches) -->
                    @if (ShouldShow("habits") && filteredHabits.Count > 0)
                    {
                        <div class="space-y-1">
                            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider px-2 font-semibold">
                                Hábitos (@filteredHabits.Count)
                            </span>
                            <div class="space-y-0.5">
                                @foreach (var h in filteredHabits)
                                {
                                    var isSel = selectedItem?.Id == h.Id;
                                    <div 
                                        @onclick="() => SelectHabit(h)"
                                        class="p-2.5 rounded-xl cursor-pointer transition-all @(isSel ? "bg-indigo-500/15 border border-indigo-500/30 text-white font-semibold" : "hover:bg-white/[0.03] text-slate-300")">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-xs truncate font-medium">@h.Name</span>
                                            <AtlasBadge Variant="success">@h.Frequency</AtlasBadge>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- 4. GROUP: FINANCES (Only if non-empty and filter matches) -->
                    @if (ShouldShow("finance") && filteredTransactions.Count > 0)
                    {
                        <div class="space-y-1">
                            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider px-2 font-semibold">
                                Finanzas (@filteredTransactions.Count)
                            </span>
                            <div class="space-y-0.5">
                                @foreach (var tx in filteredTransactions)
                                {
                                    var isSel = selectedItem?.Id == tx.Id;
                                    var isIncome = tx.Tipo == "income";
                                    <div 
                                        @onclick="() => SelectTransaction(tx)"
                                        class="p-2.5 rounded-xl cursor-pointer transition-all @(isSel ? "bg-indigo-500/15 border border-indigo-500/30 text-white font-semibold" : "hover:bg-white/[0.03] text-slate-300")">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-xs truncate font-medium">@tx.Descripcion</span>
                                            <span class="text-[10.5px] font-mono font-semibold @(isIncome ? "text-emerald-400" : "text-slate-200")">
                                                @(isIncome ? "+" : "-")$@tx.Monto.ToString("N0", new CultureInfo("es-AR"))
                                            </span>
                                        </div>
                                        <span class="text-[10px] font-mono text-slate-500">@tx.Fecha.ToLocalTime().ToString("dd MMM yyyy")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

        </div>

        <!-- Right Panel: Live Contextual Preview (60%) -->
        <div class="flex-1 flex flex-col overflow-hidden bg-[#0f1420]">
            
            @if (selectedItem == null)
            {
                <div class="flex-1 flex items-center justify-center text-xs text-slate-500 font-mono select-none">
                    Seleccioná un elemento para ver su detalle o resumir con IA
                </div>
            }
            else
            {
                <!-- Reader Preview Area -->
                <div class="flex-1 overflow-y-auto p-6 md:p-8 space-y-5">
                    
                    <!-- Title & Header Meta -->
                    <div class="space-y-2 border-b border-white/[0.08] pb-4">
                        <div class="flex items-center gap-2">
                            <AtlasBadge Variant="@selectedItem.BadgeVariant">@selectedItem.Category</AtlasBadge>
                            <span class="text-[10.5px] font-mono text-slate-400">@selectedItem.MetaInfo</span>
                        </div>
                        <h2 class="text-lg font-bold text-white tracking-tight">
                            @selectedItem.Title
                        </h2>
                    </div>

                    <!-- AI Summary / Action Result Banner (if generated) -->
                    @if (!string.IsNullOrWhiteSpace(aiOutput))
                    {
                        <div class="atlas-elevated rounded-2xl p-4 space-y-2 border border-indigo-500/30 animate-atlas-in">
                            <div class="flex items-center justify-between text-[10.5px] font-mono font-semibold text-indigo-400 uppercase">
                                <span class="flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                                    <span>Respuesta Gemini AI:</span>
                                </span>
                                <button @onclick="() => aiOutput = null" class="text-slate-400 hover:text-white text-xs">✕</button>
                            </div>
                            <div class="text-xs text-slate-200 leading-relaxed whitespace-pre-wrap font-sans">
                                @aiOutput
                            </div>
                        </div>
                    }

                    <!-- Rich Body Detail by Category -->
                    @if (selectedItem.Category == "Nota")
                    {
                        <div class="text-[13px] text-slate-200 leading-relaxed whitespace-pre-wrap font-sans selection:bg-indigo-500/30">
                            @selectedItem.BodyContent
                        </div>
                    }
                    else if (selectedItem.Category == "Roadmap" && selectedRoadmapDetail != null)
                    {
                        <div class="space-y-4">
                            <AtlasProgress Value="@selectedRoadmapDetail.ProgressPercentage" ShowLabel="true" Label="Avance general de la ruta" />

                            <div class="space-y-2 pt-2">
                                <span class="text-[11px] font-mono text-slate-400 uppercase block font-semibold">Hitos estructurados:</span>
                                <div class="space-y-1.5">
                                    @if (selectedRoadmapDetail.Milestones != null)
                                    {
                                        @foreach (var m in selectedRoadmapDetail.Milestones.OrderBy(x => x.OrderIndex))
                                        {
                                            var isCompleted = m.Status == "completed";
                                            <div class="p-3 rounded-xl bg-white/[0.03] border border-white/[0.06] flex items-center justify-between text-xs">
                                                <div class="flex items-center gap-2.5">
                                                    <span class="@(isCompleted ? "text-emerald-400" : "text-slate-500") font-bold">
                                                        @(isCompleted ? "✓" : "○")
                                                    </span>
                                                    <span class="@(isCompleted ? "line-through text-slate-500" : "text-slate-200 font-medium")">
                                                        Paso @(m.OrderIndex + 1): @m.Title
                                                    </span>
                                                </div>
                                                <span class="text-[10px] font-mono text-slate-500">@m.Status</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else if (selectedItem.Category == "Finanza")
                    {
                        <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/[0.06] space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-slate-400 font-mono">Monto registrado:</span>
                                <span class="text-base font-bold font-mono text-white">@selectedItem.BodyContent</span>
                            </div>
                            <AtlasDivider />
                            <div class="flex items-center justify-between text-xs font-mono text-slate-400">
                                <span>Estado: Confirmado en SQLite</span>
                                <span>Moneda: ARS</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-xs text-slate-300 leading-relaxed">
                            @selectedItem.BodyContent
                        </div>
                    }

                </div>

                <!-- Floating Bottom Contextual Action Bar -->
                <div class="h-12 px-6 border-t border-white/[0.08] bg-[#0c1017] flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2.5">
                        
                        <AtlasContextActionBar Target="@selectedDomainObject" OnActionExecuted="HandleContextActionResult" />
                    </div>

                    <span class="text-[10px] font-mono text-slate-500">ID: @selectedItem.Id[..Math.Min(8, selectedItem.Id.Length)]...</span>
                </div>
            }

        </div>

    </div>

</div>

@code {
    private string searchQuery = string.Empty;
    private string selectedFilter = "all";
    private bool isLoading = true;
    private string? aiOutput;
    private string? actionFeedback;

    // Search Result Item Model
    public record SearchUnifiedItem(
        string Id,
        string Category,
        string BadgeVariant,
        string Title,
        string MetaInfo,
        string BodyContent
    );

    private SearchUnifiedItem? selectedItem;
    private Roadmap? selectedRoadmapDetail;
    private object? selectedDomainObject;

    // Local in-memory caches
    private List<Note> allNotes = [];
    private List<Roadmap> allRoadmaps = [];
    private List<Habit> allHabits = [];
    private List<Transaction> allTransactions = [];

    // Filtered lists
    private List<Note> filteredNotes = [];
    private List<Roadmap> filteredRoadmaps = [];
    private List<Habit> filteredHabits = [];
    private List<Transaction> filteredTransactions = [];

    private int TotalResultCount => filteredNotes.Count + filteredRoadmaps.Count + filteredHabits.Count + filteredTransactions.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        isLoading = true;
        try
        {
            var notes = await NoteRepository.GetRecentAsync(100);
            allNotes = notes.ToList();

            var roadmaps = await RoadmapRepository.GetAllAsync();
            allRoadmaps = roadmaps.ToList();

            var habits = await HabitRepository.GetAllAsync();
            allHabits = habits.ToList();

            var txs = await TransactionRepository.GetRecentAsync(100);
            allTransactions = txs.ToList();

            ApplyFilters();

            if (filteredNotes.Count > 0 && selectedItem == null)
            {
                SelectNote(filteredNotes[0]);
            }
        }
        catch (Exception ex)
        {
            actionFeedback = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(string filter)
    {
        selectedFilter = filter;
        ApplyFilters();
    }

    private bool ShouldShow(string category)
    {
        if (selectedFilter == "all") return true;
        return selectedFilter == category;
    }

    private void ApplyFilters()
    {
        var q = searchQuery?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(q))
        {
            filteredNotes = allNotes;
            filteredRoadmaps = allRoadmaps;
            filteredHabits = allHabits;
            filteredTransactions = allTransactions;
        }
        else
        {
            filteredNotes = allNotes
                .Where(n => (n.Title != null && n.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                            n.Content.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                            (n.Tags != null && n.Tags.Contains(q, StringComparison.OrdinalIgnoreCase)))
                .ToList();

            filteredRoadmaps = allRoadmaps
                .Where(r => r.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                            (r.Description != null && r.Description.Contains(q, StringComparison.OrdinalIgnoreCase)))
                .ToList();

            filteredHabits = allHabits
                .Where(h => h.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                            (h.Description != null && h.Description.Contains(q, StringComparison.OrdinalIgnoreCase)))
                .ToList();

            filteredTransactions = allTransactions
                .Where(t => t.Descripcion.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                            (t.Categoria != null && t.Categoria.Contains(q, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private void SelectNote(Note note)
    {
        selectedRoadmapDetail = null;
        selectedDomainObject = note;
        aiOutput = null;
        actionFeedback = null;
        selectedItem = new SearchUnifiedItem(
            Id: note.Id,
            Category: "Nota",
            BadgeVariant: "accent",
            Title: GetNoteTitle(note),
            MetaInfo: $"{note.CreatedAt.ToLocalTime():dd/MM/yyyy HH:mm} • Origen: {note.Source}",
            BodyContent: note.Content
        );
    }

    private void SelectRoadmap(Roadmap roadmap)
    {
        selectedRoadmapDetail = roadmap;
        selectedDomainObject = roadmap;
        aiOutput = null;
        actionFeedback = null;
        selectedItem = new SearchUnifiedItem(
            Id: roadmap.Id,
            Category: "Roadmap",
            BadgeVariant: "warning",
            Title: roadmap.Title,
            MetaInfo: $"Progreso actual: {roadmap.ProgressPercentage}% • {roadmap.CreatedAt.ToLocalTime():dd/MM/yyyy}",
            BodyContent: roadmap.Description ?? "Sin descripción"
        );
    }

    private void SelectHabit(Habit habit)
    {
        selectedRoadmapDetail = null;
        selectedDomainObject = habit;
        aiOutput = null;
        actionFeedback = null;
        selectedItem = new SearchUnifiedItem(
            Id: habit.Id,
            Category: "Hábito",
            BadgeVariant: "success",
            Title: habit.Name,
            MetaInfo: $"Frecuencia: {habit.Frequency} • Creado: {habit.CreatedAt.ToLocalTime():dd/MM/yyyy}",
            BodyContent: habit.Description ?? "Hábito registrado en el sistema personal."
        );
    }

    private void SelectTransaction(Transaction tx)
    {
        selectedRoadmapDetail = null;
        selectedDomainObject = tx;
        aiOutput = null;
        actionFeedback = null;
        var isIncome = tx.Tipo == "income";
        var amountText = $"{(isIncome ? "+" : "-")}${tx.Monto.ToString("N0", new CultureInfo("es-AR"))} ARS";

        selectedItem = new SearchUnifiedItem(
            Id: tx.Id,
            Category: "Finanza",
            BadgeVariant: isIncome ? "success" : "neutral",
            Title: tx.Descripcion,
            MetaInfo: $"Fecha: {tx.Fecha.ToLocalTime():dd/MM/yyyy HH:mm} • Tipo: {tx.Tipo}",
            BodyContent: amountText
        );
    }

    private void HandleContextActionResult(AtlasContextActionBar.ContextActionResult actionResult)
    {
        if (actionResult.Result.IsSuccess && actionResult.Result.Data != null)
        {
            aiOutput = actionResult.Result.Data.ToString();
        }
        else if (!actionResult.Result.IsSuccess)
        {
            actionFeedback = actionResult.Result.ErrorMessage ?? "Error al ejecutar acción.";
        }
    }

    private static string GetNoteTitle(Note note)
    {
        if (!string.IsNullOrWhiteSpace(note.Title)) return note.Title;
        return note.Content.Length > 40 ? note.Content[..40] + "..." : note.Content;
    }
}
