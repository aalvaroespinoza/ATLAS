@page "/search"

<div class="space-y-8">
    <!-- Header -->
    <div class="space-y-1.5">
        <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-indigo-400"></span>
            Buscar (Second Brain)
        </h1>
        <p class="text-sm text-slate-400">
            Explorá tus notas guardadas, ideas indexadas y resúmenes con IA.
        </p>
    </div>

    <!-- Placeholder Search Layout -->
    <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl space-y-4">
        <div class="flex items-center gap-3 text-indigo-400">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <h2 class="text-base font-semibold text-slate-200">Explorador de Conocimiento</h2>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed max-w-2xl">
            Próximamente acá vas a contar con el explorador Master-Detail conectado a <code class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">knowledge.search</code> y resúmenes asistidos con Gemini (<code class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">ai.summarize</code>).
        </p>
    </div>
</div>
