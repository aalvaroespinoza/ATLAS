@page "/search"
@inject INoteRepository NoteRepository
@inject ICommandRegistry CommandRegistry
@inject IJSRuntime JSRuntime

<div class="h-[calc(100vh-6.5rem)] flex flex-col space-y-4">
    
    <!-- Top Search Header Bar -->
    <div class="flex items-center gap-3">
        <div class="relative flex-1">
            <svg class="absolute left-3.5 top-3 w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input 
                type="text" 
                @bind="searchQuery"
                @bind:event="oninput"
                @onkeyup="PerformSearchAsync"
                placeholder="Buscar notas por palabra clave, contenido o #tags..." 
                class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-white/[0.03] border border-white/[0.08] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-sky-500/50 transition-all font-sans" />
        </div>

        <span class="text-[11px] font-mono text-slate-500 shrink-0">
            @filteredNotes.Count notas
        </span>
    </div>

    <!-- Master-Detail Split View (Craft / Linear Style) -->
    <div class="flex-1 flex min-h-0 rounded-xl bg-white/[0.02] border border-white/[0.06] overflow-hidden">
        
        <!-- Left Panel: Notes List (40%) -->
        <div class="w-2/5 border-r border-white/[0.06] flex flex-col overflow-hidden bg-[#0c1017]">
            <div class="flex-1 overflow-y-auto divide-y divide-white/[0.04]">
                @if (isLoading)
                {
                    <div class="p-6 text-center text-xs font-mono text-slate-600">Buscando...</div>
                }
                else if (filteredNotes.Count == 0)
                {
                    <div class="p-6 text-center text-xs text-slate-500">
                        No se encontraron notas con el criterio de búsqueda.
                    </div>
                }
                else
                {
                    @foreach (var note in filteredNotes)
                    {
                        var isSelected = selectedNote?.Id == note.Id;
                        <div 
                            @onclick="() => SelectNote(note)"
                            class="p-3.5 cursor-pointer transition-colors @(isSelected ? "bg-white/[0.06] border-l-2 border-sky-400" : "hover:bg-white/[0.02]") space-y-1.5">
                            
                            <div class="flex items-center justify-between gap-2">
                                <h3 class="text-xs font-medium @(isSelected ? "text-white" : "text-slate-200") truncate">
                                    @(!string.IsNullOrWhiteSpace(note.Title) ? note.Title : "(Sin título)")
                                </h3>
                                <span class="text-[10px] font-mono text-slate-500 shrink-0">
                                    @note.CreatedAt.ToLocalTime().ToString("dd MMM")
                                </span>
                            </div>

                            <p class="text-[11px] text-slate-400 line-clamp-2 leading-relaxed">
                                @note.Content
                            </p>

                            @if (!string.IsNullOrWhiteSpace(note.Tags))
                            {
                                <div class="flex items-center gap-1 pt-1 overflow-hidden">
                                    @foreach (var tag in note.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(3))
                                    {
                                        <span class="px-1.5 py-0.2 rounded bg-white/[0.04] text-[9px] font-mono text-slate-400">#@tag</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Right Panel: Note Reader & Contextual Actions (60%) -->
        <div class="flex-1 flex flex-col overflow-hidden bg-[#0e131d]">
            @if (selectedNote == null)
            {
                <div class="flex-1 flex items-center justify-center text-xs text-slate-500 font-mono">
                    Seleccioná una nota para leer o resumir
                </div>
            }
            else
            {
                <!-- Reader Content Area -->
                <div class="flex-1 overflow-y-auto p-6 space-y-4">
                    
                    <!-- Note Title & Metadata -->
                    <div class="space-y-1.5 border-b border-white/[0.06] pb-3">
                        <h2 class="text-base font-semibold text-white">
                            @(!string.IsNullOrWhiteSpace(selectedNote.Title) ? selectedNote.Title : "(Sin título)")
                        </h2>
                        <div class="flex items-center gap-3 text-[11px] font-mono text-slate-500">
                            <span>@selectedNote.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            <span>•</span>
                            <span class="uppercase">Origen: @selectedNote.Source</span>
                            @if (!string.IsNullOrWhiteSpace(selectedNote.Tags))
                            {
                                <span>•</span>
                                <span>@selectedNote.Tags</span>
                            }
                        </div>
                    </div>

                    <!-- AI Summary Block (if generated) -->
                    @if (!string.IsNullOrWhiteSpace(aiSummary))
                    {
                        <div class="p-3.5 rounded-lg bg-sky-950/20 border border-sky-500/30 text-xs text-sky-200 leading-relaxed space-y-1.5 animate-fadeIn">
                            <div class="flex items-center justify-between text-[10px] font-mono font-semibold uppercase tracking-wider text-sky-400">
                                <span>Resumen IA (Gemini)</span>
                                <button @onclick="() => aiSummary = null" class="text-slate-400 hover:text-white text-xs">✕</button>
                            </div>
                            <p class="whitespace-pre-wrap">@aiSummary</p>
                        </div>
                    }

                    <!-- Note Content Body -->
                    <div class="text-xs text-slate-200 leading-relaxed whitespace-pre-wrap font-sans">
                        @selectedNote.Content
                    </div>

                </div>

                <!-- Bottom Contextual Action Bar -->
                <div class="h-11 px-6 border-t border-white/[0.06] bg-[#0c1017] flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2">
                        <button 
                            type="button"
                            @onclick="SummarizeNoteWithAiAsync"
                            disabled="@isSummarizing"
                            class="px-2.5 py-1 rounded-md bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 hover:text-white border border-white/[0.06] text-xs font-medium transition-all flex items-center gap-1.5 cursor-pointer disabled:opacity-50">
                            @if (isSummarizing)
                            {
                                <svg class="animate-spin w-3 h-3 text-sky-400" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
                                </svg>
                                <span>Resumiendo...</span>
                            }
                            else
                            {
                                <span>Resumir con Gemini</span>
                            }
                        </button>

                        @if (!string.IsNullOrWhiteSpace(actionStatus))
                        {
                            <span class="text-[11px] font-mono text-emerald-400">@actionStatus</span>
                        }
                    </div>

                    <span class="text-[10px] font-mono text-slate-600">ID: @selectedNote.Id[..8]...</span>
                </div>
            }
        </div>

    </div>

</div>

@code {
    private string searchQuery = string.Empty;
    private List<Note> allNotes = [];
    private List<Note> filteredNotes = [];
    private Note? selectedNote;
    private bool isLoading = true;

    // AI summary state
    private bool isSummarizing;
    private string? aiSummary;
    private string? actionStatus;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        isLoading = true;
        try
        {
            var notes = await NoteRepository.GetRecentAsync(100);
            allNotes = notes.ToList();
            filteredNotes = allNotes;
            if (filteredNotes.Count > 0 && selectedNote == null)
            {
                selectedNote = filteredNotes[0];
            }
        }
        catch (Exception ex)
        {
            actionStatus = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PerformSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredNotes = allNotes;
            return;
        }

        var q = searchQuery.Trim();
        filteredNotes = allNotes
            .Where(n => (n.Title != null && n.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                        n.Content.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (n.Tags != null && n.Tags.Contains(q, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        if (filteredNotes.Count > 0 && (selectedNote == null || !filteredNotes.Contains(selectedNote)))
        {
            selectedNote = filteredNotes[0];
        }
    }

    private void SelectNote(Note note)
    {
        selectedNote = note;
        aiSummary = null;
        actionStatus = null;
    }

    private async Task SummarizeNoteWithAiAsync()
    {
        if (selectedNote == null || isSummarizing) return;

        isSummarizing = true;
        aiSummary = null;
        actionStatus = null;

        try
        {
            var result = await CommandRegistry.ExecuteAsync(AiSummarizeCommand.CommandId, new Dictionary<string, object?>
            {
                ["text"] = selectedNote.Content
            });

            if (result.IsSuccess)
            {
                aiSummary = result.Data?.ToString();
            }
            else
            {
                actionStatus = result.ErrorMessage ?? "Error al generar resumen.";
            }
        }
        catch (Exception ex)
        {
            actionStatus = ex.Message;
        }
        finally
        {
            isSummarizing = false;
        }
    }
}
