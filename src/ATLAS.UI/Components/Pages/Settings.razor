                            Guardar
                        </button>
                        @if (hasGmailToken)
                        {
                            <button 
                                type="button" 
                                @onclick="DeleteGmailTokenAsync"
                                class="h-8.5 px-3 rounded-xl text-xs font-medium text-rose-300 bg-rose-500/10 hover:bg-rose-500/20 active:scale-[0.98] border border-rose-500/20 transition-all cursor-pointer">
