        try
        {
            SecretVault.SetSecret(SecretKeys.GmailRefreshToken, gmailTokenInput.Trim());
            RefreshStatus();
            ShowFeedback("✓ Token de Gmail guardado de forma segura.", true);
        }
        catch (Exception ex) { ShowFeedback(ex.Message, false); }
    }

    private void DeleteGmailTokenAsync()
    {
        try
        {
            SecretVault.DeleteSecret(SecretKeys.GmailRefreshToken);
            gmailTokenInput = string.Empty;
            RefreshStatus();
            ShowFeedback("Token de Gmail eliminado.", true);
