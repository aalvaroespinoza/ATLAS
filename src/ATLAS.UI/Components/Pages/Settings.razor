    <div class="space-y-1.5">
        <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-slate-400"></span>
            Configuración
        </h1>
        <p class="text-sm text-slate-400">
            Administración segura de credenciales e integraciones locales (Windows Credential Locker).
        </p>
    </div>

    <!-- Placeholder Section Card -->
    <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl space-y-4">
        <div class="flex items-center gap-3 text-slate-300">
