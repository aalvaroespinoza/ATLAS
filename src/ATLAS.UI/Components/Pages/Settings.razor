@page "/settings"
@using ATLAS.Core.Integrations.Supabase
@inject ISecretVault SecretVault
@inject ICommandRegistry CommandRegistry
@inject ISupabaseAuthService SupabaseAuth
@using System.Security.Cryptography
@using System.Text
@using System.Text.RegularExpressions

<div class="space-y-8 max-w-2xl pb-16 animate-atlas-in">
    
    <!-- Page Header & Vault Status Indicator -->
    <div class="p-5 rounded-2xl bg-gradient-to-b from-[#141a29]/90 to-[#0e1320]/90 border border-white/[0.08] shadow-lg shadow-black/40 backdrop-blur-md space-y-2">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-0.5">
                <h1 class="text-lg font-bold tracking-tight text-white flex items-center gap-2">
                    <span>Configuración & Bóveda de Claves</span>
                </h1>
                <p class="text-xs text-slate-400">
                    Administrá tus credenciales y conexiones encriptadas en Windows Credential Locker.
                </p>
            </div>

            <div class="shrink-0">
                @if (hasPinConfigured)
                {
                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-mono font-medium @(isVaultUnlocked ? "bg-amber-500/15 text-amber-300 border border-amber-500/30 shadow-sm shadow-amber-500/10" : "bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 shadow-sm shadow-emerald-500/10")">
                        <span class="w-2 h-2 rounded-full @(isVaultUnlocked ? "bg-amber-400 shadow-sm shadow-amber-400/80" : "bg-emerald-400 shadow-sm shadow-emerald-400/80")"></span>
                        <span>@(isVaultUnlocked ? "🔓 Bóveda Desbloqueada" : "🔒 Protegido con PIN")</span>
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-mono text-slate-400 bg-white/[0.04] border border-white/[0.08]">
                        <span class="w-2 h-2 rounded-full bg-slate-600"></span>
                        <span>Sin PIN configurado</span>
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Notification / Status Feedback -->
    @if (!string.IsNullOrWhiteSpace(feedbackMessage))
    {
        <div class="px-4 py-3 rounded-2xl text-xs flex items-center justify-between font-medium animate-atlas-in shadow-lg @(isFeedbackSuccess ? "bg-emerald-500/15 border border-emerald-500/30 text-emerald-200 shadow-emerald-950/20" : "bg-rose-500/15 border border-rose-500/30 text-rose-200 shadow-rose-950/20")">
            <span>@(isFeedbackSuccess ? "✓ " : "✕ ") @feedbackMessage</span>
            <button type="button" @onclick="() => feedbackMessage = null" class="text-slate-400 hover:text-white text-xs ml-2 cursor-pointer">✕</button>
        </div>
    }

    <!-- 1. SECCIÓN: PIN DE SEGURIDAD (4 DÍGITOS) -->
    <section class="space-y-3">
        <AtlasSectionHeader Title="Seguridad & Acceso (PIN de 4 dígitos)" />

        <div class="p-5 rounded-2xl bg-gradient-to-b from-[#141a29]/90 to-[#0e1320]/90 border border-white/[0.08] shadow-lg shadow-black/40 space-y-4 backdrop-blur-md">
            @if (!hasPinConfigured)
            {
                <!-- Crear PIN inicial -->
                <div class="space-y-3">
                    <div class="space-y-1">
                        <span class="text-xs font-semibold text-slate-200 block">Establecer PIN Maestro de 4 números</span>
                        <p class="text-[11px] text-slate-400">
                            Creá un PIN de 4 números para proteger y ocultar la visualización de tus claves privadas.
                        </p>
                    </div>

                    <div class="flex items-center gap-2.5">
                        <div class="w-36">
                            <input 
                                type="password" 
                                maxlength="4"
                                @bind="newPinInput"
                                @bind:event="oninput"
                                placeholder="•••• (4 dígitos)" 
                                class="w-full px-3.5 py-2 rounded-xl bg-black/40 border border-white/[0.1] text-white text-xs font-mono text-center tracking-widest focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
                        </div>
                        <button 
                            type="button"
                            @onclick="SetInitialPinAsync"
                            class="h-8.5 px-4 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] transition-all border border-indigo-400/30 shadow-md shadow-indigo-500/20 cursor-pointer">
                            Guardar PIN
                        </button>
                    </div>
                </div>
            }
            else if (!isVaultUnlocked)
            {
                <!-- Bóveda Bloqueada: Ingresar PIN para Desbloquear -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400/80"></span>
                            <span class="text-xs font-semibold text-slate-200">PIN de 4 dígitos activo</span>
                        </div>
                        <p class="text-[11px] text-slate-400">
                            Ingresá tu PIN para ver los valores reales de tus claves guardadas.
                        </p>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="w-32">
                            <input 
                                type="password" 
                                maxlength="4"
                                @bind="unlockPinInput"
                                @bind:event="oninput"
                                placeholder="••••" 
                                class="w-full px-3.5 py-2 rounded-xl bg-black/40 border border-white/[0.1] text-white text-xs font-mono text-center tracking-widest focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
                        </div>
                        <button 
                            type="button"
                            @onclick="UnlockVaultAsync"
                            class="h-8.5 px-4 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] transition-all border border-indigo-400/30 shadow-md shadow-indigo-500/20 cursor-pointer">
                            🔓 Desbloquear
                        </button>
                    </div>
                </div>

                @if (isChangingPin)
                {
                    <div class="pt-3.5 border-t border-white/[0.06] space-y-3 animate-atlas-in">
                        <span class="text-xs font-semibold text-slate-200 block">Cambiar PIN de Seguridad</span>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            <input type="password" maxlength="4" @bind="oldPinChangeInput" @bind:event="oninput" placeholder="PIN Actual (4 dígitos)" class="w-full px-3.5 py-2 rounded-xl bg-black/40 border border-white/[0.1] text-white text-xs font-mono text-center tracking-widest focus:outline-none focus:border-indigo-500" />
                            <input type="password" maxlength="4" @bind="newPinChangeInput" @bind:event="oninput" placeholder="Nuevo PIN (4 dígitos)" class="w-full px-3.5 py-2 rounded-xl bg-black/40 border border-white/[0.1] text-white text-xs font-mono text-center tracking-widest focus:outline-none focus:border-indigo-500" />
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="ChangePinAsync" class="h-7 px-3 rounded-lg text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] transition-all border border-indigo-400/30 cursor-pointer">Actualizar PIN</button>
                            <button type="button" @onclick="() => isChangingPin = false" class="h-7 px-3 rounded-lg text-xs font-medium text-slate-400 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] active:scale-[0.98] transition-all cursor-pointer">Cancelar</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pt-2 border-t border-white/[0.04] flex justify-end">
                        <button type="button" @onclick="() => isChangingPin = true" class="text-[11px] font-mono text-slate-400 hover:text-indigo-300 transition-colors cursor-pointer">
                            ¿Querés cambiar tu PIN? →
                        </button>
                    </div>
                }
            }
            else
            {
                <!-- Bóveda Desbloqueada -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="space-y-0.5">
                        <span class="text-xs font-semibold text-amber-300 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-amber-400 shadow-sm shadow-amber-400/80"></span>
                            <span>Bóveda desbloqueada</span>
                        </span>
                        <p class="text-[11px] text-slate-400">
                            Todas las claves están visibles y editables.
                        </p>
                    </div>

                    <div class="flex items-center gap-2">
                        <button 
                            type="button" 
                            @onclick="LockVault"
                            class="h-8 px-3.5 rounded-xl text-xs font-medium text-slate-200 bg-white/[0.06] hover:bg-white/[0.1] active:scale-[0.98] border border-white/[0.1] transition-all cursor-pointer">
                            🔒 Bloquear Bóveda
                        </button>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- 2. SECCIÓN: BASE DE DATOS SUPABASE + AUTH -->
    <section class="space-y-3">
        <div class="flex items-center justify-between">
            <AtlasSectionHeader Title="Base de Datos en la Nube — Supabase (Auth + RLS)" />
            <button 
                type="button"
                @onclick="() => showSqlModal = !showSqlModal"
                class="text-[11px] font-mono text-indigo-400 hover:text-indigo-300 transition-colors cursor-pointer">
                @(showSqlModal ? "Ocultar SQL" : "📋 Ver Script SQL")
            </button>
        </div>

        <div class="p-5 rounded-2xl bg-gradient-to-b from-[#141a29]/90 to-[#0e1320]/90 border border-indigo-500/20 shadow-lg shadow-black/40 space-y-4 backdrop-blur-md">
            
            <!-- Supabase Connection & Auth Status Badges -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/[0.06] pb-3.5">
                <div class="flex items-center gap-2.5">
                    <span class="w-2.5 h-2.5 rounded-full @(hasSupabaseConfigured && isSupabaseAuthenticated ? "bg-emerald-400 shadow-sm shadow-emerald-400/80" : hasSupabaseConfigured ? "bg-amber-400 shadow-sm shadow-amber-400/80" : "bg-slate-600")"></span>
                    <span class="text-xs font-semibold text-white">Supabase Cloud</span>
                    @if (isSupabaseAuthenticated)
                    {
                        <span class="text-[11px] font-mono text-indigo-300">(@supabaseUserEmail)</span>
                    }
                </div>
                
                <div class="flex items-center gap-2">
                    <AtlasBadge Variant="@(hasSupabaseConfigured ? "success" : "neutral")">
                        @(hasSupabaseConfigured ? "API Conectada" : "Sin Claves")
                    </AtlasBadge>
                    <AtlasBadge Variant="@(isSupabaseAuthenticated ? "success" : "warning")">
                        @(isSupabaseAuthenticated ? "Auth Activo" : "Auth Pendiente")
                    </AtlasBadge>
                </div>
            </div>

            @if (showSqlModal)
            {
                <div class="p-4 rounded-xl bg-[#090b10] border border-white/[0.08] space-y-2.5 animate-atlas-in">
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-mono text-indigo-400 font-semibold">Script SQL de creación con RLS scoped a auth.uid():</span>
                        <button type="button" @onclick="() => showSqlModal = false" class="text-slate-400 hover:text-white text-xs cursor-pointer">✕</button>
                    </div>
                    <pre class="text-[10px] font-mono text-slate-300 overflow-x-auto max-h-48 p-2.5 bg-black/40 rounded-lg select-all whitespace-pre border border-white/[0.04]">@SupabaseSchemaSql</pre>
                    <p class="text-[10px] text-slate-400">
                        Copiá este script y ejecutalo en el <strong>SQL Editor</strong> de tu proyecto en Supabase.
                    </p>
                </div>
            }

            <!-- 2.1 API Configuration (URL & Anon Key) -->
            <div class="space-y-3">
                <div class="space-y-1">
                    <label class="text-[11px] font-mono text-slate-400 block">Project URL</label>
                    <input 
                        type="@(isVaultUnlocked || !hasSupabaseConfigured ? "text" : "password")" 
                        @bind="supabaseUrlInput" 
                        @bind:event="oninput"
                        placeholder="https://your-project.supabase.co" 
                        class="w-full px-3.5 py-2 rounded-xl bg-black/40 border border-white/[0.08] text-slate-100 text-xs font-mono placeholder-slate-500 focus:outline-none focus:border-indigo-500/60 focus:ring-1 focus:ring-indigo-500/20" />
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-mono text-slate-400 block">Anon / Public API Key</label>
                    <input 
                        type="@(isVaultUnlocked || !hasSupabaseConfigured ? "text" : "password")" 
                        @bind="supabaseKeyInput" 
                        @bind:event="oninput"
                        placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." 
                        class="w-full px-3.5 py-2 rounded-xl bg-black/40 border border-white/[0.08] text-slate-100 text-xs font-mono placeholder-slate-500 focus:outline-none focus:border-indigo-500/60 focus:ring-1 focus:ring-indigo-500/20" />
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <button 
                        type="button" 
                        @onclick="SaveSupabaseKeysAsync"
                        class="h-7.5 px-3.5 rounded-lg text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] transition-all border border-indigo-400/30 cursor-pointer">
                        Guardar API Keys
                    </button>
                    @if (hasSupabaseConfigured)
                    {
                        <button 
                            type="button" 
                            @onclick="DeleteSupabaseKeysAsync"
                            class="h-7.5 px-3.5 rounded-lg text-xs font-medium text-rose-300 bg-rose-500/10 hover:bg-rose-500/20 active:scale-[0.98] border border-rose-500/20 transition-all cursor-pointer">
                            Eliminar Keys
                        </button>
                    }
                </div>
            </div>

            <!-- 2.2 Supabase Auth (Email & Password) Login Section -->
            <div class="pt-3.5 border-t border-white/[0.06] space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-200 block">Autenticación de Usuario (Supabase Auth)</span>
                    @if (isSupabaseAuthenticated)
                    {
                        <span class="text-[10.5px] font-mono text-emerald-400 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            <span>Token JWT persistido</span>
                        </span>
                    }
                </div>

                @if (isSupabaseAuthenticated)
                {
                    <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.06] space-y-2.5">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs gap-1">
                            <span class="text-slate-300 font-medium">Sesión activa como: <strong class="text-white">@supabaseUserEmail</strong></span>
                            <span class="text-[10.5px] font-mono text-slate-500">ID: @supabaseUserId</span>
                        </div>
                        
                        <div class="flex items-center justify-between pt-1 flex-wrap gap-2">
                            <button 
                                type="button" 
                                @onclick="SignOutSupabase"
                                class="h-7 px-3 rounded-lg text-xs font-medium text-rose-300 bg-rose-500/10 hover:bg-rose-500/20 active:scale-[0.98] border border-rose-500/20 transition-all cursor-pointer">
                                Cerrar Sesión
                            </button>

                            <button 
                                type="button" 
                                @onclick="SyncSupabaseAsync"
                                disabled="@isSyncingSupabase"
                                class="h-7 px-3.5 rounded-lg text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] transition-all border border-indigo-400/30 shadow-sm shadow-indigo-500/20 cursor-pointer disabled:opacity-50">
                                🔄 @(isSyncingSupabase ? "Sincronizando..." : "Sincronizar Ahora")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="space-y-3 bg-black/30 p-3.5 rounded-xl border border-white/[0.06]">
                        <p class="text-[11px] text-slate-400">
                            Iniciá sesión con tu email y contraseña de Supabase. El token de sesión se guardará en tu bóveda segura para sincronizar con RLS.
                        </p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            <input 
                                type="email" 
                                @bind="loginEmailInput" 
                                @bind:event="oninput"
                                placeholder="tu-email@ejemplo.com" 
                                class="w-full px-3.5 py-2 rounded-xl bg-black/50 border border-white/[0.08] text-white text-xs font-sans placeholder-slate-500 focus:outline-none focus:border-indigo-500" />

                            <input 
                                type="password" 
                                @bind="loginPasswordInput" 
                                @bind:event="oninput"
                                placeholder="Contraseña de Supabase" 
                                class="w-full px-3.5 py-2 rounded-xl bg-black/50 border border-white/[0.08] text-white text-xs font-sans placeholder-slate-500 focus:outline-none focus:border-indigo-500" />
                        </div>

                        <div class="flex items-center justify-between pt-1">
                            <button 
                                type="button" 
                                @onclick="SignInSupabaseAsync"
                                disabled="@isSigningIn"
                                class="h-7.5 px-3.5 rounded-lg text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] transition-all border border-indigo-400/30 cursor-pointer disabled:opacity-50">
                                @(isSigningIn ? "Conectando..." : "Conectar Cuenta (Iniciar Sesión)")
                            </button>
                            <span class="text-[10px] font-mono text-slate-500">Un solo login permanente</span>
                        </div>
                    </div>
                }
            </div>

        </div>
    </section>

    <!-- 3. SECCIÓN: GESTIÓN DE CLAVES DE OTRAS APIS -->
    <section class="space-y-4">
        <AtlasSectionHeader Title="Otras Integraciones & APIs" />

        <div class="space-y-3">
            
            <!-- 1. GOOGLE GEMINI AI -->
            <div class="p-4.5 rounded-2xl bg-gradient-to-b from-[#141a29]/90 to-[#0e1320]/90 border border-white/[0.08] shadow-lg shadow-black/40 space-y-3.5 backdrop-blur-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full @(hasGeminiKey ? "bg-emerald-400 shadow-sm shadow-emerald-400/80" : "bg-slate-600")"></span>
                        <span class="text-xs font-semibold text-white">Google Gemini AI</span>
                    </div>
                    <AtlasBadge Variant="@(hasGeminiKey ? "success" : "neutral")">
                        @(hasGeminiKey ? "Conectado" : "Sin clave")
                    </AtlasBadge>
                </div>

                <div class="space-y-2">
                    <label class="text-[11px] font-mono text-slate-400 block flex items-center gap-1.5">
                        <span>API Key</span>
                        <a href="https://aistudio.google.com/app/apikey" target="_blank" class="text-indigo-400/80 hover:text-indigo-300 underline underline-offset-2 transition-colors">(Obtener en Google AI Studio)</a>
                    </label>
                    <div class="flex items-center gap-2">
                        <div class="flex-1">
                            <input 
                                type="@(isVaultUnlocked || !hasGeminiKey ? "text" : "password")" 
                                @bind="geminiKeyInput" 
                                @bind:event="oninput"
                                placeholder="AIzaSy..." 
                                class="w-full px-3.5 py-2 rounded-xl bg-black/40 border border-white/[0.08] text-slate-100 text-xs font-mono placeholder-slate-500 focus:outline-none focus:border-indigo-500/60 focus:ring-1 focus:ring-indigo-500/20" />
                        </div>

                        <button 
                            type="button" 
                            @onclick="SaveGeminiKeyAsync"
                            class="h-8.5 px-3.5 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] transition-all border border-indigo-400/30 cursor-pointer">
                            Guardar
                        </button>
                        @if (hasGeminiKey)
                        {
                            <button 
                                type="button" 
                                @onclick="DeleteGeminiKeyAsync"
                                class="h-8.5 px-3 rounded-xl text-xs font-medium text-rose-300 bg-rose-500/10 hover:bg-rose-500/20 active:scale-[0.98] border border-rose-500/20 transition-all cursor-pointer">
                                Eliminar
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. BOT DE TELEGRAM -->
            <div class="p-4.5 rounded-2xl bg-gradient-to-b from-[#141a29]/90 to-[#0e1320]/90 border border-white/[0.08] shadow-lg shadow-black/40 space-y-3.5 backdrop-blur-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full @(hasTelegramToken ? "bg-emerald-400 shadow-sm shadow-emerald-400/80" : "bg-slate-600")"></span>
                        <span class="text-xs font-semibold text-white">Bot de Telegram</span>
                    </div>
                    <AtlasBadge Variant="@(hasTelegramToken ? "success" : "neutral")">
                        @(hasTelegramToken ? "Conectado" : "Sin token")
                    </AtlasBadge>
                </div>

                <div class="space-y-2">
                    <label class="text-[11px] font-mono text-slate-400 block flex items-center gap-1.5">
                        <span>Bot Token</span>
                        <a href="https://t.me/BotFather" target="_blank" class="text-indigo-400/80 hover:text-indigo-300 underline underline-offset-2 transition-colors">(Crear en @@BotFather)</a>
                    </label>
                    <div class="flex items-center gap-2">
                        <div class="flex-1">
                            <input 
                                type="@(isVaultUnlocked || !hasTelegramToken ? "text" : "password")" 
                                @bind="telegramTokenInput" 
                                @bind:event="oninput"
                                placeholder="123456789:ABCdefGHIjklMNOpqr..." 
                                class="w-full px-3.5 py-2 rounded-xl bg-black/40 border border-white/[0.08] text-slate-100 text-xs font-mono placeholder-slate-500 focus:outline-none focus:border-indigo-500/60 focus:ring-1 focus:ring-indigo-500/20" />
                        </div>

                        <button 
                            type="button" 
                            @onclick="SaveTelegramTokenAsync"
                            class="h-8.5 px-3.5 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 active:scale-[0.98] transition-all border border-indigo-400/30 cursor-pointer">
                            Guardar
                        </button>
                        @if (hasTelegramToken)
                        {
                            <button 
                                type="button" 
                                @onclick="DeleteTelegramTokenAsync"
                                class="h-8.5 px-3 rounded-xl text-xs font-medium text-rose-300 bg-rose-500/10 hover:bg-rose-500/20 active:scale-[0.98] border border-rose-500/20 transition-all cursor-pointer">
                                Eliminar
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- 3. MERCADO PAGO -->
            <div class="p-4.5 rounded-2xl bg-gradient-to-b from-[#141a29]/90 to-[#0e1320]/90 border border-white/[0.08] shadow-lg shadow-black/40 space-y-3.5 backdrop-blur-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
