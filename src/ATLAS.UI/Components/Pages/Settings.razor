@page "/settings"
@inject ISecretVault SecretVault
@inject ICommandRegistry CommandRegistry
@using System.Security.Cryptography
@using System.Text
@using System.Text.RegularExpressions

<div class="space-y-8 max-w-2xl pb-16 animate-atlas-in">
    
    <!-- Header -->
    <div class="space-y-1 border-b border-white/[0.08] pb-4">
        <h1 class="text-lg font-bold tracking-tight text-white flex items-center justify-between">
            <span>Configuración & Bóveda de Claves</span>
            <span class="text-xs font-mono font-normal @(isVaultUnlocked ? "text-amber-400" : "text-slate-400") flex items-center gap-1.5">
                <span>@(isVaultUnlocked ? "🔓 Bóveda Desbloqueada" : "🔒 Bóveda Protegida")</span>
            </span>
        </h1>
        <p class="text-xs text-slate-400">
            Administración segura y encriptada de APIs y base de datos Supabase. Protegido con PIN de 4 dígitos.
        </p>
    </div>

    <!-- Notification / Status Feedback -->
    @if (!string.IsNullOrWhiteSpace(feedbackMessage))
    {
        <div class="px-3.5 py-2.5 rounded-xl text-xs flex items-center justify-between font-medium animate-atlas-in @(isFeedbackSuccess ? "bg-emerald-500/10 border border-emerald-500/20 text-emerald-300" : "bg-rose-500/10 border border-rose-500/20 text-rose-300")">
            <span>@(isFeedbackSuccess ? "✓ " : "✕ ") @feedbackMessage</span>
            <button @onclick="() => feedbackMessage = null" class="text-slate-400 hover:text-white text-xs">✕</button>
        </div>
    }

    <!-- 1. SECCIÓN: PIN DE SEGURIDAD (4 DÍGITOS) -->
    <section class="space-y-3">
        <AtlasSectionHeader Title="Seguridad & Acceso (PIN de 4 dígitos)" />

        <div class="atlas-surface rounded-2xl p-5 space-y-4">
            @if (!hasPinConfigured)
            {
                <!-- Crear PIN inicial -->
                <div class="space-y-3">
                    <div class="space-y-1">
                        <span class="text-xs font-semibold text-slate-200 block">Establecer PIN de 4 dígitos</span>
                        <p class="text-[11px] text-slate-400">
                            Creá un PIN numérico de 4 cifras para proteger la visualización y edición de tus claves privadas.
                        </p>
                    </div>

                    <div class="flex items-center gap-2.5">
                        <div class="w-32">
                            <AtlasInput 
                                Type="password" 
                                MaxLength="4"
                                @bind-Value="newPinInput" 
                                Placeholder="•••• (4 dígitos)" />
                        </div>
                        <AtlasButton 
                            Variant="primary" 
                            Size="md" 
                            OnClick="SetInitialPinAsync"
                            IsDisabled="@(string.IsNullOrWhiteSpace(newPinInput) || newPinInput.Length != 4)">
                            Guardar PIN
                        </AtlasButton>
                    </div>
                </div>
            }
            else if (!isVaultUnlocked)
            {
                <!-- Bóveda Bloqueada: Ingresar PIN para Desbloquear -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                            <span class="text-xs font-semibold text-slate-200">PIN de 4 dígitos activo</span>
                        </div>
                        <p class="text-[11px] text-slate-400">
                            Ingresá tu PIN para revelar o editar las claves guardadas.
                        </p>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="w-28">
                            <AtlasInput 
                                Type="password" 
                                MaxLength="4"
                                @bind-Value="unlockPinInput" 
                                Placeholder="••••" />
                        </div>
                        <AtlasButton 
                            Variant="primary" 
                            Size="md" 
                            OnClick="UnlockVaultAsync"
                            IsDisabled="@(string.IsNullOrWhiteSpace(unlockPinInput) || unlockPinInput.Length != 4)">
                            Desbloquear
                        </AtlasButton>
                    </div>
                </div>

                @if (isChangingPin)
                {
                    <div class="pt-3 border-t border-white/[0.06] space-y-3 animate-atlas-in">
                        <span class="text-xs font-semibold text-slate-200 block">Cambiar PIN</span>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            <AtlasInput Type="password" MaxLength="4" @bind-Value="oldPinChangeInput" Placeholder="PIN Actual (4 dígitos)" />
                            <AtlasInput Type="password" MaxLength="4" @bind-Value="newPinChangeInput" Placeholder="Nuevo PIN (4 dígitos)" />
                        </div>
                        <div class="flex items-center gap-2">
                            <AtlasButton Variant="primary" Size="sm" OnClick="ChangePinAsync">Actualizar PIN</AtlasButton>
                            <AtlasButton Variant="secondary" Size="sm" OnClick="() => isChangingPin = false">Cancelar</AtlasButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pt-2 border-t border-white/[0.04] flex justify-end">
                        <button type="button" @onclick="() => isChangingPin = true" class="text-[11px] font-mono text-slate-400 hover:text-indigo-300 transition-colors">
                            ¿Querés cambiar tu PIN? →
                        </button>
                    </div>
                }
            }
            else
            {
                <!-- Bóveda Desbloqueada -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="space-y-0.5">
                        <span class="text-xs font-semibold text-amber-300 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                            <span>Bóveda desbloqueada para esta sesión</span>
                        </span>
                        <p class="text-[11px] text-slate-400">
                            Las claves se encuentran visibles y editables.
                        </p>
                    </div>

                    <div class="flex items-center gap-2">
                        <AtlasButton Variant="secondary" Size="sm" OnClick="LockVault">
                            🔒 Bloquear Bóveda
                        </AtlasButton>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- 2. SECCIÓN: BASE DE DATOS SUPABASE -->
    <section class="space-y-3">
        <div class="flex items-center justify-between">
            <AtlasSectionHeader Title="Base de Datos en la Nube — Supabase" />
            <button 
                type="button"
                @onclick="() => showSqlModal = !showSqlModal"
                class="text-[11px] font-mono text-indigo-400 hover:text-indigo-300 transition-colors">
                @(showSqlModal ? "Ocultar SQL" : "📋 Ver Script SQL")
            </button>
        </div>

        <div class="atlas-surface rounded-2xl p-5 space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <span class="w-2 h-2 rounded-full @(hasSupabaseConfigured ? "bg-emerald-400" : "bg-slate-600")"></span>
                    <span class="text-xs font-semibold text-white">Supabase (PostgreSQL & REST)</span>
                </div>
                <AtlasBadge Variant="@(hasSupabaseConfigured ? "success" : "neutral")">
                    @(hasSupabaseConfigured ? "Conectado" : "Pendiente")
                </AtlasBadge>
            </div>

            @if (showSqlModal)
            {
                <div class="p-4 rounded-xl bg-[#090b10] border border-white/[0.08] space-y-2.5 animate-atlas-in">
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-mono text-indigo-400 font-semibold">Script SQL para crear tablas en Supabase:</span>
                        <button type="button" @onclick="() => showSqlModal = false" class="text-slate-400 hover:text-white text-xs">✕</button>
                    </div>
                    <pre class="text-[10px] font-mono text-slate-300 overflow-x-auto max-h-48 p-2.5 bg-black/40 rounded-lg select-all whitespace-pre">@SupabaseSchemaSql</pre>
                    <p class="text-[10px] text-slate-400">
                        Copiá este script y ejecutalo en el <strong>SQL Editor</strong> de tu panel en Supabase.
                    </p>
                </div>
            }

            <div class="space-y-3">
                <!-- Project URL -->
                <div class="space-y-1">
                    <label class="text-[11px] font-mono text-slate-400 block">Project URL (ej: https://xyz.supabase.co)</label>
                    @if (isVaultUnlocked)
                    {
                        <AtlasInput @bind-Value="supabaseUrlInput" Placeholder="https://your-project.supabase.co" />
                    }
                    else
                    {
                        <input type="password" disabled value="@(hasSupabaseConfigured ? "••••••••••••••••••••••••" : "")" placeholder="@(hasSupabaseConfigured ? "••••••••••••••••••••••••" : "No configurada")" class="w-full px-3.5 py-2 rounded-xl bg-white/[0.02] border border-white/[0.06] text-slate-400 text-xs font-mono cursor-not-allowed select-none" />
                    }
                </div>

                <!-- Anon API Key -->
                <div class="space-y-1">
                    <label class="text-[11px] font-mono text-slate-400 block">Anon / Public API Key</label>
                    @if (isVaultUnlocked)
                    {
                        <AtlasInput @bind-Value="supabaseKeyInput" Placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." />
                    }
                    else
                    {
                        <input type="password" disabled value="@(hasSupabaseConfigured ? "••••••••••••••••••••••••" : "")" placeholder="@(hasSupabaseConfigured ? "••••••••••••••••••••••••" : "No configurada")" class="w-full px-3.5 py-2 rounded-xl bg-white/[0.02] border border-white/[0.06] text-slate-400 text-xs font-mono cursor-not-allowed select-none" />
                    }
                </div>

                <!-- Action buttons -->
                <div class="pt-2 flex items-center justify-between flex-wrap gap-2">
                    <div class="flex items-center gap-2">
                        @if (isVaultUnlocked)
                        {
                            <AtlasButton Variant="primary" Size="sm" OnClick="SaveSupabaseKeysAsync">
                                Guardar Credenciales
                            </AtlasButton>
                            @if (hasSupabaseConfigured)
                            {
                                <AtlasButton Variant="danger" Size="sm" OnClick="DeleteSupabaseKeysAsync">
                                    Eliminar
                                </AtlasButton>
                            }
                        }
                        else if (!hasSupabaseConfigured)
                        {
                            <AtlasButton Variant="primary" Size="sm" OnClick='() => PromptUnlockOrSet("supabase")'>
                                + Configurar Supabase
                            </AtlasButton>
                        }
                    </div>

                    @if (hasSupabaseConfigured)
                    {
                        <AtlasButton 
                            Variant="accent" 
                            Size="sm" 
                            OnClick="SyncSupabaseAsync" 
                            IsLoading="isSyncingSupabase">
                            🔄 Sincronizar Ahora con Supabase
                        </AtlasButton>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- 3. SECCIÓN: GESTIÓN DE CLAVES DE APIS E INTEGRACIONES -->
    <section class="space-y-4">
        <div class="flex items-center justify-between">
            <AtlasSectionHeader Title="Otras Integraciones & APIs" />
            <span class="text-[11px] font-mono text-slate-500">
                @(isVaultUnlocked ? "Modo Edición" : "Modo Seguro")
            </span>
        </div>

        <div class="space-y-3">
            
            <!-- 1. GOOGLE GEMINI AI -->
            <div class="atlas-surface rounded-2xl p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2 h-2 rounded-full @(hasGeminiKey ? "bg-emerald-400" : "bg-slate-600")"></span>
                        <span class="text-xs font-semibold text-white">Google Gemini AI</span>
                    </div>
                    <AtlasBadge Variant="@(hasGeminiKey ? "success" : "neutral")">
                        @(hasGeminiKey ? "Conectado" : "Sin clave")
                    </AtlasBadge>
                </div>

                <div class="space-y-2">
                    <label class="text-[11px] font-mono text-slate-400 block">API Key (Google AI Studio)</label>
                    <div class="flex items-center gap-2">
                        <div class="flex-1">
                            @if (isVaultUnlocked)
                            {
                                <AtlasInput 
                                    @bind-Value="geminiKeyInput" 
                                    Placeholder="AIzaSy..." />
                            }
                            else
                            {
                                <input 
                                    type="password" 
                                    disabled 
                                    value="@(hasGeminiKey ? "••••••••••••••••••••••••" : "")" 
                                    placeholder="@(hasGeminiKey ? "••••••••••••••••••••••••" : "No configurada")" 
                                    class="w-full px-3.5 py-2 rounded-xl bg-white/[0.02] border border-white/[0.06] text-slate-400 text-xs font-mono cursor-not-allowed select-none" />
                            }
                        </div>

                        @if (isVaultUnlocked)
                        {
                            <AtlasButton Variant="primary" Size="md" OnClick="SaveGeminiKeyAsync">
                                Guardar
                            </AtlasButton>
                            @if (hasGeminiKey)
                            {
                                <AtlasButton Variant="danger" Size="md" OnClick="DeleteGeminiKeyAsync">
                                    Eliminar
                                </AtlasButton>
                            }
                        }
                        else if (!hasGeminiKey)
                        {
                            <AtlasButton Variant="primary" Size="md" OnClick='() => PromptUnlockOrSet("gemini")'>
                                + Agregar
                            </AtlasButton>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. BOT DE TELEGRAM -->
            <div class="atlas-surface rounded-2xl p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2 h-2 rounded-full @(hasTelegramToken ? "bg-emerald-400" : "bg-slate-600")"></span>
                        <span class="text-xs font-semibold text-white">Bot de Telegram</span>
                    </div>
                    <AtlasBadge Variant="@(hasTelegramToken ? "success" : "neutral")">
                        @(hasTelegramToken ? "Conectado" : "Sin token")
                    </AtlasBadge>
                </div>

                <div class="space-y-2">
                    <label class="text-[11px] font-mono text-slate-400 block">Bot Token (@@BotFather)</label>
                    <div class="flex items-center gap-2">
                        <div class="flex-1">
                            @if (isVaultUnlocked)
                            {
                                <AtlasInput 
                                    @bind-Value="telegramTokenInput" 
                                    Placeholder="123456789:ABCdefGHIjklMNOpqr..." />
                            }
                            else
                            {
                                <input 
                                    type="password" 
                                    disabled 
                                    value="@(hasTelegramToken ? "••••••••••••••••••••••••" : "")" 
                                    placeholder="@(hasTelegramToken ? "••••••••••••••••••••••••" : "No configurado")" 
                                    class="w-full px-3.5 py-2 rounded-xl bg-white/[0.02] border border-white/[0.06] text-slate-400 text-xs font-mono cursor-not-allowed select-none" />
                            }
                        </div>

                        @if (isVaultUnlocked)
                        {
                            <AtlasButton Variant="primary" Size="md" OnClick="SaveTelegramTokenAsync">
                                Guardar
                            </AtlasButton>
                            @if (hasTelegramToken)
                            {
                                <AtlasButton Variant="danger" Size="md" OnClick="DeleteTelegramTokenAsync">
                                    Eliminar
                                </AtlasButton>
                            }
                        }
                        else if (!hasTelegramToken)
                        {
                            <AtlasButton Variant="primary" Size="md" OnClick='() => PromptUnlockOrSet("telegram")'>
                                + Agregar
                            </AtlasButton>
                        }
                    </div>
                </div>
            </div>

            <!-- 3. MERCADO PAGO -->
            <div class="atlas-surface rounded-2xl p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2 h-2 rounded-full @(hasMpToken ? "bg-emerald-400" : "bg-slate-600")"></span>
                        <span class="text-xs font-semibold text-white">Mercado Pago</span>
                    </div>
                    <AtlasBadge Variant="@(hasMpToken ? "success" : "neutral")">
                        @(hasMpToken ? "Conectado" : "Sin token")
                    </AtlasBadge>
                </div>

                <div class="space-y-2">
                    <label class="text-[11px] font-mono text-slate-400 block">Personal Access Token (PROD / TEST)</label>
                    <div class="flex items-center gap-2">
                        <div class="flex-1">
                            @if (isVaultUnlocked)
                            {
                                <AtlasInput 
                                    @bind-Value="mpTokenInput" 
                                    Placeholder="APP_USR-..." />
                            }
                            else
                            {
                                <input 
                                    type="password" 
                                    disabled 
                                    value="@(hasMpToken ? "••••••••••••••••••••••••" : "")" 
                                    placeholder="@(hasMpToken ? "••••••••••••••••••••••••" : "No configurado")" 
                                    class="w-full px-3.5 py-2 rounded-xl bg-white/[0.02] border border-white/[0.06] text-slate-400 text-xs font-mono cursor-not-allowed select-none" />
                            }
                        </div>

                        @if (isVaultUnlocked)
                        {
                            <AtlasButton Variant="primary" Size="md" OnClick="SaveMpTokenAsync">
                                Guardar
                            </AtlasButton>
                            @if (hasMpToken)
                            {
                                <AtlasButton Variant="danger" Size="md" OnClick="DeleteMpTokenAsync">
                                    Eliminar
                                </AtlasButton>
                            }
                        }
                        else if (!hasMpToken)
                        {
                            <AtlasButton Variant="primary" Size="md" OnClick='() => PromptUnlockOrSet("mp")'>
                                + Agregar
                            </AtlasButton>
                        }
                    </div>
                </div>
            </div>

            <!-- 4. GMAIL OAUTH -->
            <div class="atlas-surface rounded-2xl p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2 h-2 rounded-full @(hasGmailToken ? "bg-emerald-400" : "bg-slate-600")"></span>
                        <span class="text-xs font-semibold text-white">Gmail OAuth (Read-Only)</span>
                    </div>
                    <AtlasBadge Variant="@(hasGmailToken ? "success" : "neutral")">
                        @(hasGmailToken ? "Conectado" : "Sin token")
                    </AtlasBadge>
                </div>

                <div class="space-y-2">
                    <label class="text-[11px] font-mono text-slate-400 block">OAuth Refresh Token</label>
                    <div class="flex items-center gap-2">
                        <div class="flex-1">
                            @if (isVaultUnlocked)
                            {
                                <AtlasInput 
                                    @bind-Value="gmailTokenInput" 
                                    Placeholder="1//04..." />
                            }
                            else
                            {
                                <input 
                                    type="password" 
                                    disabled 
                                    value="@(hasGmailToken ? "••••••••••••••••••••••••" : "")" 
                                    placeholder="@(hasGmailToken ? "••••••••••••••••••••••••" : "No configurado")" 
                                    class="w-full px-3.5 py-2 rounded-xl bg-white/[0.02] border border-white/[0.06] text-slate-400 text-xs font-mono cursor-not-allowed select-none" />
                            }
                        </div>

                        @if (isVaultUnlocked)
                        {
                            <AtlasButton Variant="primary" Size="md" OnClick="SaveGmailTokenAsync">
                                Guardar
                            </AtlasButton>
                            @if (hasGmailToken)
                            {
                                <AtlasButton Variant="danger" Size="md" OnClick="DeleteGmailTokenAsync">
                                    Eliminar
                                </AtlasButton>
                            }
                        }
                        else if (!hasGmailToken)
                        {
                            <AtlasButton Variant="primary" Size="md" OnClick='() => PromptUnlockOrSet("gmail")'>
                                + Agregar
                            </AtlasButton>
                        }
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- 4. NOTICIA DE ALMACENAMIENTO SEGURO -->
    <div class="atlas-surface rounded-2xl p-4 text-xs text-slate-400 space-y-1 font-mono text-[11px]">
        <div class="text-slate-300 font-semibold uppercase text-[10px] flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
            <span>Almacenamiento Local & Encriptado</span>
        </div>
        <p class="text-slate-400 leading-relaxed font-sans text-xs">
            Todas las claves son encriptadas por el sistema operativo mediante Windows Credential Locker (DPAPI) y protegidas por tu PIN de 4 dígitos.
        </p>
    </div>

</div>

@code {
    private bool hasPinConfigured;
    private bool isVaultUnlocked;
    private bool isChangingPin;
    private bool showSqlModal;
    private bool isSyncingSupabase;

    // PIN inputs
    private string newPinInput = string.Empty;
    private string unlockPinInput = string.Empty;
    private string oldPinChangeInput = string.Empty;
    private string newPinChangeInput = string.Empty;

    // API Key existence
    private bool hasSupabaseConfigured;
    private bool hasGeminiKey;
    private bool hasTelegramToken;
    private bool hasMpToken;
    private bool hasGmailToken;

    // Unlocked API Key values
    private string supabaseUrlInput = string.Empty;
    private string supabaseKeyInput = string.Empty;
    private string geminiKeyInput = string.Empty;
    private string telegramTokenInput = string.Empty;
    private string mpTokenInput = string.Empty;
    private string gmailTokenInput = string.Empty;

    // Feedback
    private string? feedbackMessage;
    private bool isFeedbackSuccess;

    private const string SupabaseSchemaSql = """
    -- Copiá y ejecutá en Supabase SQL Editor:
    CREATE TABLE IF NOT EXISTS notes (id TEXT PRIMARY KEY, title TEXT, content TEXT NOT NULL, type TEXT NOT NULL DEFAULT 'note', tags TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), source TEXT NOT NULL DEFAULT 'quick_capture');
    CREATE TABLE IF NOT EXISTS goals (id TEXT PRIMARY KEY, title TEXT NOT NULL, description TEXT, status TEXT NOT NULL DEFAULT 'active', progress INTEGER NOT NULL DEFAULT 0, target_date TIMESTAMPTZ, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    CREATE TABLE IF NOT EXISTS habits (id TEXT PRIMARY KEY, name TEXT NOT NULL, description TEXT, frequency TEXT NOT NULL DEFAULT 'daily', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    CREATE TABLE IF NOT EXISTS habit_events (id TEXT PRIMARY KEY, habit_id TEXT NOT NULL REFERENCES habits(id) ON DELETE CASCADE, completed_at TIMESTAMPTZ NOT NULL, note TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    CREATE TABLE IF NOT EXISTS roadmaps (id TEXT PRIMARY KEY, goal_id TEXT REFERENCES goals(id) ON DELETE SET NULL, title TEXT NOT NULL, description TEXT, status TEXT NOT NULL DEFAULT 'active', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    CREATE TABLE IF NOT EXISTS roadmap_milestones (id TEXT PRIMARY KEY, roadmap_id TEXT NOT NULL REFERENCES roadmaps(id) ON DELETE CASCADE, title TEXT NOT NULL, order_index INTEGER NOT NULL, status TEXT NOT NULL DEFAULT 'pending', notes TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), completed_at TIMESTAMPTZ);
    CREATE TABLE IF NOT EXISTS transactions (id TEXT PRIMARY KEY, fecha TIMESTAMPTZ NOT NULL, monto NUMERIC NOT NULL, tipo TEXT NOT NULL DEFAULT 'expense', origen TEXT NOT NULL DEFAULT 'manual', descripcion TEXT NOT NULL, moneda TEXT NOT NULL DEFAULT 'ARS', categoria TEXT, subcategoria TEXT, id_externo TEXT UNIQUE, estado TEXT NOT NULL DEFAULT 'approved', metadata TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    """;

    protected override void OnInitialized()
    {
        RefreshStatus();
    }

    private void RefreshStatus()
    {
        try
        {
            hasPinConfigured = SecretVault.HasSecret(SecretKeys.MasterSecurityPin);
            hasSupabaseConfigured = SecretVault.HasSecret(SecretKeys.SupabaseUrl) && SecretVault.HasSecret(SecretKeys.SupabaseAnonKey);
            hasGeminiKey = SecretVault.HasSecret(SecretKeys.GeminiApiKey);
            hasTelegramToken = SecretVault.HasSecret(SecretKeys.TelegramBotToken);
            hasMpToken = SecretVault.HasSecret(SecretKeys.MercadoPagoAccessToken);
            hasGmailToken = SecretVault.HasSecret(SecretKeys.GmailRefreshToken);

            if (isVaultUnlocked)
            {
                supabaseUrlInput = SecretVault.GetSecret(SecretKeys.SupabaseUrl) ?? string.Empty;
                supabaseKeyInput = SecretVault.GetSecret(SecretKeys.SupabaseAnonKey) ?? string.Empty;
                geminiKeyInput = SecretVault.GetSecret(SecretKeys.GeminiApiKey) ?? string.Empty;
                telegramTokenInput = SecretVault.GetSecret(SecretKeys.TelegramBotToken) ?? string.Empty;
                mpTokenInput = SecretVault.GetSecret(SecretKeys.MercadoPagoAccessToken) ?? string.Empty;
                gmailTokenInput = SecretVault.GetSecret(SecretKeys.GmailRefreshToken) ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al consultar almacén de secretos: {ex.Message}", false);
        }
    }

    private void SetInitialPinAsync()
    {
        if (!IsValidPin(newPinInput))
        {
            ShowFeedback("El PIN debe ser exactamente de 4 dígitos numéricos.", false);
            return;
        }

        try
        {
            var hash = ComputeHash(newPinInput);
            SecretVault.SetSecret(SecretKeys.MasterSecurityPin, hash);
            hasPinConfigured = true;
            isVaultUnlocked = true;
            newPinInput = string.Empty;
            RefreshStatus();
            ShowFeedback("✓ PIN de 4 dígitos establecido correctamente. Bóveda desbloqueada.", true);
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al guardar PIN: {ex.Message}", false);
        }
    }

    private void UnlockVaultAsync()
    {
        if (!IsValidPin(unlockPinInput))
        {
            ShowFeedback("El PIN ingresado no es válido (deben ser 4 dígitos).", false);
            return;
        }

        try
        {
            var storedHash = SecretVault.GetSecret(SecretKeys.MasterSecurityPin);
            var inputHash = ComputeHash(unlockPinInput);

            if (storedHash == inputHash)
            {
                isVaultUnlocked = true;
                unlockPinInput = string.Empty;
                RefreshStatus();
                ShowFeedback("✓ Bóveda desbloqueada con éxito.", true);
            }
            else
            {
                ShowFeedback("PIN incorrecto. Por favor intentá nuevamente.", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al validar PIN: {ex.Message}", false);
        }
    }

    private void LockVault()
    {
        isVaultUnlocked = false;
        supabaseUrlInput = string.Empty;
        supabaseKeyInput = string.Empty;
        geminiKeyInput = string.Empty;
        telegramTokenInput = string.Empty;
        mpTokenInput = string.Empty;
        gmailTokenInput = string.Empty;
        unlockPinInput = string.Empty;
        isChangingPin = false;
        showSqlModal = false;
        ShowFeedback("Bóveda bloqueada.", true);
    }

    private void ChangePinAsync()
    {
        if (!IsValidPin(oldPinChangeInput) || !IsValidPin(newPinChangeInput))
        {
            ShowFeedback("Ambos PINs deben contener exactamente 4 números.", false);
            return;
        }

        try
        {
            var storedHash = SecretVault.GetSecret(SecretKeys.MasterSecurityPin);
            var oldHash = ComputeHash(oldPinChangeInput);

            if (storedHash != oldHash)
            {
                ShowFeedback("El PIN actual es incorrecto.", false);
                return;
            }

            var newHash = ComputeHash(newPinChangeInput);
            SecretVault.SetSecret(SecretKeys.MasterSecurityPin, newHash);
            oldPinChangeInput = string.Empty;
            newPinChangeInput = string.Empty;
            isChangingPin = false;
            ShowFeedback("✓ PIN actualizado con éxito.", true);
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al cambiar PIN: {ex.Message}", false);
        }
    }

    private void PromptUnlockOrSet(string keyType)
    {
        if (!hasPinConfigured)
        {
            ShowFeedback("Primero establecé tu PIN de 4 dígitos arriba para proteger tus claves.", false);
        }
        else
        {
            ShowFeedback("Ingresá tu PIN arriba para desbloquear la bóveda y agregar la clave.", false);
        }
    }

    // Save Handlers
    private void SaveSupabaseKeysAsync()
    {
        if (string.IsNullOrWhiteSpace(supabaseUrlInput) || string.IsNullOrWhiteSpace(supabaseKeyInput))
        {
            ShowFeedback("Completá tanto la URL como la Anon Key de Supabase.", false);
            return;
        }
        try
        {
            SecretVault.SetSecret(SecretKeys.SupabaseUrl, supabaseUrlInput.Trim());
            SecretVault.SetSecret(SecretKeys.SupabaseAnonKey, supabaseKeyInput.Trim());
            RefreshStatus();
            ShowFeedback("✓ Credenciales de Supabase guardadas exitosamente.", true);
        }
        catch (Exception ex) { ShowFeedback(ex.Message, false); }
    }

    private void DeleteSupabaseKeysAsync()
    {
        try
        {
            SecretVault.DeleteSecret(SecretKeys.SupabaseUrl);
            SecretVault.DeleteSecret(SecretKeys.SupabaseAnonKey);
            supabaseUrlInput = string.Empty;
            supabaseKeyInput = string.Empty;
            RefreshStatus();
            ShowFeedback("Credenciales de Supabase eliminadas.", true);
        }
        catch (Exception ex) { ShowFeedback(ex.Message, false); }
    }

    private async Task SyncSupabaseAsync()
    {
        isSyncingSupabase = true;
        try
        {
            var result = await CommandRegistry.ExecuteAsync(SupabaseSyncCommand.CommandId);
            if (result.IsSuccess)
            {
                ShowFeedback($"✓ {result.Data}", true);
            }
            else
            {
                ShowFeedback(result.ErrorMessage ?? "Error al sincronizar con Supabase.", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error: {ex.Message}", false);
        }
        finally
        {
            isSyncingSupabase = false;
        }
    }

