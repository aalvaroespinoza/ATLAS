@page "/settings"
@inject ISecretVault SecretVault

<div class="space-y-6 max-w-2xl pb-16 animate-atlas-in">
    
    <!-- Page Header -->
    <div class="border-b border-white/[0.08] pb-4">
        <h1 class="text-lg font-bold tracking-tight text-white">
            Configuración & Privacidad
        </h1>
    </div>

    <!-- Integrations Status List -->
    <div class="space-y-3">
        <AtlasSectionHeader Title="Integraciones & Proveedores" />

        <div class="atlas-surface rounded-2xl divide-y divide-white/[0.04] overflow-hidden">
            
            <!-- Gemini -->
            <AtlasListItem 
                Title="Google Gemini AI" 
                Subtitle="Procesamiento contextual (gemini-1.5-flash)">
                <PrefixContent>
                    <span class="w-2 h-2 rounded-full @(hasGeminiKey ? "bg-emerald-400" : "bg-slate-600")"></span>
                </PrefixContent>
                <SuffixContent>
                    <AtlasBadge Variant="@(hasGeminiKey ? "success" : "neutral")">
                        @(hasGeminiKey ? "Conectado" : "Pendiente")
                    </AtlasBadge>
                </SuffixContent>
            </AtlasListItem>

            <!-- Telegram -->
            <AtlasListItem 
                Title="Bot de Telegram" 
                Subtitle="Captura remota y comandos vía long polling">
                <PrefixContent>
                    <span class="w-2 h-2 rounded-full @(hasTelegramToken ? "bg-emerald-400" : "bg-slate-600")"></span>
                </PrefixContent>
                <SuffixContent>
                    <AtlasBadge Variant="@(hasTelegramToken ? "success" : "neutral")">
                        @(hasTelegramToken ? "Conectado" : "Pendiente")
                    </AtlasBadge>
                </SuffixContent>
            </AtlasListItem>

            <!-- Mercado Pago -->
            <AtlasListItem 
                Title="Mercado Pago" 
                Subtitle="Sincronización a demanda de transacciones">
                <PrefixContent>
                    <span class="w-2 h-2 rounded-full @(hasMpToken ? "bg-emerald-400" : "bg-slate-600")"></span>
                </PrefixContent>
                <SuffixContent>
                    <AtlasBadge Variant="@(hasMpToken ? "success" : "neutral")">
                        @(hasMpToken ? "Conectado" : "Pendiente")
                    </AtlasBadge>
                </SuffixContent>
            </AtlasListItem>

            <!-- Gmail -->
            <AtlasListItem 
                Title="Gmail (Lectura)" 
                Subtitle="Contexto y triage de correos recientes">
                <PrefixContent>
                    <span class="w-2 h-2 rounded-full @(hasGmailToken ? "bg-emerald-400" : "bg-slate-600")"></span>
                </PrefixContent>
                <SuffixContent>
                    <AtlasBadge Variant="@(hasGmailToken ? "success" : "neutral")">
                        @(hasGmailToken ? "Conectado" : "Pendiente")
                    </AtlasBadge>
                </SuffixContent>
            </AtlasListItem>

        </div>
    </div>

    <!-- Security & Storage Notice -->
    <div class="atlas-surface rounded-2xl p-4 text-xs text-slate-400 space-y-1 font-mono text-[11px]">
        <div class="text-slate-300 font-semibold uppercase text-[10px] flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
            <span>Almacenamiento Local & Seguro</span>
        </div>
        <p class="text-slate-400 leading-relaxed font-sans text-xs">
            Credenciales resguardadas mediante Windows Credential Locker / DPAPI. Base de datos SQLite local bajo <code class="text-indigo-300 font-mono text-[11px]">%LocalAppData%\ATLAS\atlas.db</code>.
        </p>
    </div>

</div>

@code {
    private bool hasGeminiKey;
    private bool hasTelegramToken;
    private bool hasMpToken;
    private bool hasGmailToken;

    protected override void OnInitialized()
    {
        try
        {
            hasGeminiKey = SecretVault.HasSecret(SecretKeys.GeminiApiKey);
            hasTelegramToken = SecretVault.HasSecret(SecretKeys.TelegramBotToken);
            hasMpToken = SecretVault.HasSecret(SecretKeys.MercadoPagoAccessToken);
            hasGmailToken = SecretVault.HasSecret(SecretKeys.GmailRefreshToken);
        }
        catch { }
    }
}
