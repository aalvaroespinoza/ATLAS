</div>

@code {
    private bool hasPinConfigured;
    private bool isVaultUnlocked;
    private bool isChangingPin;
    private bool showSqlModal;
    private bool isSyncingSupabase;
    private bool isSigningIn;

    // PIN inputs
    private string newPinInput = string.Empty;
    private string unlockPinInput = string.Empty;
    private string oldPinChangeInput = string.Empty;
    private string newPinChangeInput = string.Empty;

    // Supabase Auth inputs
    private string loginEmailInput = string.Empty;
    private string loginPasswordInput = string.Empty;
    private bool isSupabaseAuthenticated;
    private string? supabaseUserEmail;
    private string? supabaseUserId;

    // API Key existence
    private bool hasSupabaseConfigured;
    private bool hasGeminiKey;
    private bool hasTelegramToken;
    private bool hasMpToken;
    private bool hasGmailToken;

    // API Key values
    private string supabaseUrlInput = string.Empty;
    private string supabaseKeyInput = string.Empty;
    private string geminiKeyInput = string.Empty;
    private string telegramTokenInput = string.Empty;
    private string mpTokenInput = string.Empty;
    private string gmailTokenInput = string.Empty;

    // Feedback
    private string? feedbackMessage;
    private bool isFeedbackSuccess;

    private const string SupabaseSchemaSql = """
    -- Copiá y ejecutá en Supabase SQL Editor:
    CREATE TABLE IF NOT EXISTS notes (id TEXT PRIMARY KEY, user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE DEFAULT auth.uid(), title TEXT, content TEXT NOT NULL, type TEXT NOT NULL DEFAULT 'note', tags TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), source TEXT NOT NULL DEFAULT 'quick_capture');
    CREATE TABLE IF NOT EXISTS goals (id TEXT PRIMARY KEY, user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE DEFAULT auth.uid(), title TEXT NOT NULL, description TEXT, status TEXT NOT NULL DEFAULT 'active', progress INTEGER NOT NULL DEFAULT 0, target_date TIMESTAMPTZ, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    CREATE TABLE IF NOT EXISTS habits (id TEXT PRIMARY KEY, user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE DEFAULT auth.uid(), name TEXT NOT NULL, description TEXT, frequency TEXT NOT NULL DEFAULT 'daily', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    CREATE TABLE IF NOT EXISTS habit_events (id TEXT PRIMARY KEY, user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE DEFAULT auth.uid(), habit_id TEXT NOT NULL REFERENCES habits(id) ON DELETE CASCADE, completed_at TIMESTAMPTZ NOT NULL, note TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    CREATE TABLE IF NOT EXISTS roadmaps (id TEXT PRIMARY KEY, user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE DEFAULT auth.uid(), goal_id TEXT REFERENCES goals(id) ON DELETE SET NULL, title TEXT NOT NULL, description TEXT, status TEXT NOT NULL DEFAULT 'active', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    CREATE TABLE IF NOT EXISTS roadmap_milestones (id TEXT PRIMARY KEY, user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE DEFAULT auth.uid(), roadmap_id TEXT NOT NULL REFERENCES roadmaps(id) ON DELETE CASCADE, title TEXT NOT NULL, order_index INTEGER NOT NULL, status TEXT NOT NULL DEFAULT 'pending', notes TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), completed_at TIMESTAMPTZ);
    CREATE TABLE IF NOT EXISTS transactions (id TEXT PRIMARY KEY, user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE DEFAULT auth.uid(), fecha TIMESTAMPTZ NOT NULL, monto NUMERIC NOT NULL, tipo TEXT NOT NULL DEFAULT 'expense', origen TEXT NOT NULL DEFAULT 'manual', descripcion TEXT NOT NULL, moneda TEXT NOT NULL DEFAULT 'ARS', categoria TEXT, subcategoria TEXT, id_externo TEXT UNIQUE, estado TEXT NOT NULL DEFAULT 'approved', metadata TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
    
    ALTER TABLE notes ENABLE ROW LEVEL SECURITY;
    ALTER TABLE goals ENABLE ROW LEVEL SECURITY;
    ALTER TABLE habits ENABLE ROW LEVEL SECURITY;
    ALTER TABLE habit_events ENABLE ROW LEVEL SECURITY;
    ALTER TABLE roadmaps ENABLE ROW LEVEL SECURITY;
    ALTER TABLE roadmap_milestones ENABLE ROW LEVEL SECURITY;
    ALTER TABLE transactions ENABLE ROW LEVEL SECURITY;

    CREATE POLICY "Users can manage their own notes" ON notes FOR ALL TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
    CREATE POLICY "Users can manage their own goals" ON goals FOR ALL TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
    CREATE POLICY "Users can manage their own habits" ON habits FOR ALL TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
    CREATE POLICY "Users can manage their own habit_events" ON habit_events FOR ALL TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
    CREATE POLICY "Users can manage their own roadmaps" ON roadmaps FOR ALL TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
    CREATE POLICY "Users can manage their own roadmap_milestones" ON roadmap_milestones FOR ALL TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
    CREATE POLICY "Users can manage their own transactions" ON transactions FOR ALL TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
    """;

    protected override void OnInitialized()
    {
        RefreshStatus();
    }

    private void RefreshStatus()
    {
        try
        {
            hasPinConfigured = SecretVault.HasSecret(SecretKeys.MasterSecurityPin);
            hasSupabaseConfigured = SecretVault.HasSecret(SecretKeys.SupabaseUrl) && SecretVault.HasSecret(SecretKeys.SupabaseAnonKey);
            isSupabaseAuthenticated = SupabaseAuth.IsAuthenticated();
            supabaseUserEmail = SupabaseAuth.GetUserEmail();
            supabaseUserId = SupabaseAuth.GetUserId();

            hasGeminiKey = SecretVault.HasSecret(SecretKeys.GeminiApiKey);
            hasTelegramToken = SecretVault.HasSecret(SecretKeys.TelegramBotToken);
            hasMpToken = SecretVault.HasSecret(SecretKeys.MercadoPagoAccessToken);
            hasGmailToken = SecretVault.HasSecret(SecretKeys.GmailRefreshToken);

            if (isVaultUnlocked || !hasPinConfigured)
            {
                supabaseUrlInput = SecretVault.GetSecret(SecretKeys.SupabaseUrl) ?? string.Empty;
                supabaseKeyInput = SecretVault.GetSecret(SecretKeys.SupabaseAnonKey) ?? string.Empty;
                geminiKeyInput = SecretVault.GetSecret(SecretKeys.GeminiApiKey) ?? string.Empty;
                telegramTokenInput = SecretVault.GetSecret(SecretKeys.TelegramBotToken) ?? string.Empty;
                mpTokenInput = SecretVault.GetSecret(SecretKeys.MercadoPagoAccessToken) ?? string.Empty;
                gmailTokenInput = SecretVault.GetSecret(SecretKeys.GmailRefreshToken) ?? string.Empty;
            }
            else
            {
                supabaseUrlInput = hasSupabaseConfigured ? MaskToken(SecretVault.GetSecret(SecretKeys.SupabaseUrl), 12, 0) : string.Empty;
                supabaseKeyInput = hasSupabaseConfigured ? MaskToken(SecretVault.GetSecret(SecretKeys.SupabaseAnonKey), 6, 4) : string.Empty;
                geminiKeyInput = hasGeminiKey ? MaskToken(SecretVault.GetSecret(SecretKeys.GeminiApiKey), 6, 4) : string.Empty;
                telegramTokenInput = hasTelegramToken ? MaskToken(SecretVault.GetSecret(SecretKeys.TelegramBotToken), 10, 4) : string.Empty; // 123456789:
                mpTokenInput = hasMpToken ? MaskToken(SecretVault.GetSecret(SecretKeys.MercadoPagoAccessToken), 8, 4) : string.Empty; // APP_USR-
                gmailTokenInput = hasGmailToken ? MaskToken(SecretVault.GetSecret(SecretKeys.GmailRefreshToken), 4, 4) : string.Empty; // 1//0
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al consultar almacén de secretos: {ex.Message}", false);
        }
    }

    private string MaskToken(string? token, int showFirst = 4, int showLast = 4)
    {
        if (string.IsNullOrWhiteSpace(token)) return string.Empty;
        if (token.Length <= showFirst + showLast) return "••••••••••••••••";
        return $"{token[..showFirst]}••••••••••••{token[^showLast..]}";
    }

    private void SetInitialPinAsync()
    {
        if (!IsValidPin(newPinInput))
        {
            ShowFeedback("El PIN debe ser exactamente de 4 números (ej: 1234).", false);
            return;
        }

        try
        {
            var hash = ComputeHash(newPinInput);
            SecretVault.SetSecret(SecretKeys.MasterSecurityPin, hash);
            hasPinConfigured = true;
            isVaultUnlocked = true;
            newPinInput = string.Empty;
            RefreshStatus();
            ShowFeedback("✓ PIN de 4 dígitos establecido correctamente. Bóveda desbloqueada.", true);
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al guardar PIN: {ex.Message}", false);
        }
    }

    private void UnlockVaultAsync()
    {
        if (!IsValidPin(unlockPinInput))
        {
            ShowFeedback("El PIN ingresado debe contener 4 dígitos.", false);
            return;
        }

        try
        {
            var storedHash = SecretVault.GetSecret(SecretKeys.MasterSecurityPin);
            var inputHash = ComputeHash(unlockPinInput);

            if (storedHash == inputHash)
            {
                isVaultUnlocked = true;
                unlockPinInput = string.Empty;
                RefreshStatus();
                ShowFeedback("✓ Bóveda desbloqueada con éxito.", true);
            }
            else
            {
                ShowFeedback("PIN incorrecto. Por favor intentá nuevamente.", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al validar PIN: {ex.Message}", false);
        }
    }

    private void LockVault()
    {
        isVaultUnlocked = false;
        unlockPinInput = string.Empty;
        isChangingPin = false;
        showSqlModal = false;
        RefreshStatus();
        ShowFeedback("Bóveda bloqueada.", true);
    }

    private void ChangePinAsync()
    {
        if (!IsValidPin(oldPinChangeInput) || !IsValidPin(newPinChangeInput))
        {
            ShowFeedback("Ambos PINs deben contener exactamente 4 números.", false);
            return;
        }

        try
        {
            var storedHash = SecretVault.GetSecret(SecretKeys.MasterSecurityPin);
            var oldHash = ComputeHash(oldPinChangeInput);

            if (storedHash != oldHash)
            {
                ShowFeedback("El PIN actual es incorrecto.", false);
                return;
            }

            var newHash = ComputeHash(newPinChangeInput);
            SecretVault.SetSecret(SecretKeys.MasterSecurityPin, newHash);
            oldPinChangeInput = string.Empty;
            newPinChangeInput = string.Empty;
            isChangingPin = false;
            ShowFeedback("✓ PIN actualizado con éxito.", true);
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al cambiar PIN: {ex.Message}", false);
        }
    }

    // Supabase Handlers
    private void SaveSupabaseKeysAsync()
    {
        if (string.IsNullOrWhiteSpace(supabaseUrlInput) || string.IsNullOrWhiteSpace(supabaseKeyInput) || supabaseUrlInput.Contains("•••"))
        {
            ShowFeedback("Por favor completá la URL y la Anon Key de Supabase.", false);
            return;
        }
        try
        {
            SecretVault.SetSecret(SecretKeys.SupabaseUrl, supabaseUrlInput.Trim());
            SecretVault.SetSecret(SecretKeys.SupabaseAnonKey, supabaseKeyInput.Trim());
            RefreshStatus();
            ShowFeedback("✓ Credenciales de Supabase guardadas exitosamente.", true);
        }
        catch (Exception ex) { ShowFeedback(ex.Message, false); }
    }

    private void DeleteSupabaseKeysAsync()
    {
        try
        {
            SecretVault.DeleteSecret(SecretKeys.SupabaseUrl);
            SecretVault.DeleteSecret(SecretKeys.SupabaseAnonKey);
            SupabaseAuth.SignOut();
            supabaseUrlInput = string.Empty;
            supabaseKeyInput = string.Empty;
            loginEmailInput = string.Empty;
            loginPasswordInput = string.Empty;
            RefreshStatus();
            ShowFeedback("Credenciales y sesión de Supabase eliminadas.", true);
        }
        catch (Exception ex) { ShowFeedback(ex.Message, false); }
    }

    private async Task SignInSupabaseAsync()
    {
        if (string.IsNullOrWhiteSpace(loginEmailInput) || string.IsNullOrWhiteSpace(loginPasswordInput))
        {
            ShowFeedback("Ingresá tu email y contraseña de Supabase.", false);
            return;
        }

        if (!hasSupabaseConfigured)
        {
            ShowFeedback("Primero guardá la URL y la Anon Key de Supabase arriba.", false);
            return;
        }

        isSigningIn = true;
        try
        {
            var result = await SupabaseAuth.SignInWithPasswordAsync(loginEmailInput, loginPasswordInput);
            if (result.IsSuccess)
            {
                loginPasswordInput = string.Empty;
                RefreshStatus();
                ShowFeedback("✓ Sesión iniciada con éxito en Supabase Auth.", true);
            }
            else
            {
                ShowFeedback(result.Message, false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error: {ex.Message}", false);
        }
        finally
        {
            isSigningIn = false;
        }
    }

    private void SignOutSupabase()
    {
        SupabaseAuth.SignOut();
        loginEmailInput = string.Empty;
        loginPasswordInput = string.Empty;
        RefreshStatus();
        ShowFeedback("Sesión de Supabase cerrada.", true);
    }

    private async Task SyncSupabaseAsync()
    {
        isSyncingSupabase = true;
        try
        {
            var result = await CommandRegistry.ExecuteAsync(SupabaseSyncCommand.CommandId);
            if (result.IsSuccess)
            {
                ShowFeedback($"✓ {result.Data}", true);
            }
            else
            {
                ShowFeedback(result.ErrorMessage ?? "Error al sincronizar con Supabase.", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error: {ex.Message}", false);
        }
        finally
        {
            isSyncingSupabase = false;
        }
    }

