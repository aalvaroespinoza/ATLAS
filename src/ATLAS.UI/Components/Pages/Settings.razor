    }

    private static bool IsValidPin(string? pin)
    {
        return !string.IsNullOrWhiteSpace(pin) && Regex.IsMatch(pin, @"^\d{4}$");
    }

    private static string ComputeHash(string input)
    {
        var bytes = SHA256.HashData(Encoding.UTF8.GetBytes("ATLAS_SALT_" + input));
        return Convert.ToHexString(bytes);
    }

    private void ShowFeedback(string message, bool isSuccess)
    {
        feedbackMessage = message;
        isFeedbackSuccess = isSuccess;
        _ = Task.Delay(4000).ContinueWith(_ => { feedbackMessage = null; InvokeAsync(StateHasChanged); });
    }
