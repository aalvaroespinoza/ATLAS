@page "/habits-goals"

<div class="space-y-8">
    <!-- Header -->
    <div class="space-y-1.5">
        <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400"></span>
            Hábitos y Goals
        </h1>
        <p class="text-sm text-slate-400">
            Gestioná tu constancia diaria y el avance de tus metas personales.
        </p>
    </div>

    <!-- Placeholder Section Card -->
    <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl space-y-4">
        <div class="flex items-center gap-3 text-amber-400">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138z" />
            </svg>
            <h2 class="text-base font-semibold text-slate-200">Constancia y Progreso</h2>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed max-w-2xl">
            Próximamente acá vas a contar con el panel paralelo de Hábitos diarios (<code class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">habit.complete</code>, <code class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">habit.create</code>) y Metas activas con barras de avance (<code class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">goal.update_progress</code>).
        </p>
    </div>
</div>
