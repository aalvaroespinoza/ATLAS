@page "/habits-goals"
@inject IHabitRepository HabitRepository
@inject IGoalRepository GoalRepository
@inject IRoadmapRepository RoadmapRepository
@inject ICommandRegistry CommandRegistry

<div class="space-y-6 max-w-4xl pb-16">
    
    <!-- Page Header & Tab Navigation -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/[0.06] pb-4">
        <div class="space-y-1">
            <h1 class="text-base font-semibold tracking-tight text-white">
                Hábitos, Metas & Roadmaps
            </h1>
            <p class="text-xs text-slate-400">
                Constancia cotidiana, objetivos a largo plazo y planificación secuencial en etapas.
            </p>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex items-center p-1 rounded-lg bg-white/[0.03] border border-white/[0.06]">
            <button 
                type="button"
                @onclick="@(() => activeTab = "habits")"
                class="px-3 py-1 rounded-md text-xs font-medium transition-all cursor-pointer @(activeTab == "habits" ? "bg-white/[0.08] text-white font-semibold" : "text-slate-400 hover:text-slate-200")">
                Hábitos Diarios
            </button>
            <button 
                type="button"
                @onclick="@(() => activeTab = "roadmaps")"
                class="px-3 py-1 rounded-md text-xs font-medium transition-all cursor-pointer @(activeTab == "roadmaps" ? "bg-white/[0.08] text-white font-semibold" : "text-slate-400 hover:text-slate-200")">
                Metas & Roadmaps
            </button>
        </div>
    </div>

    <!-- Notification / Status Banner -->
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="px-4 py-2.5 rounded-lg border flex items-center justify-between transition-all text-xs @(isSuccess ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-300" : "bg-rose-500/10 border-rose-500/20 text-rose-300")">
            <span>@(isSuccess ? "✓ " : "✕ ") @statusMessage</span>
            <button @onclick="() => statusMessage = null" class="text-slate-400 hover:text-white text-xs">✕</button>
        </div>
    }

    <!-- ======================================================================= -->
    <!-- TAB 1: HÁBITOS DIARIOS -->
    <!-- ======================================================================= -->
    @if (activeTab == "habits")
    {
        <div class="space-y-4">
            
            <!-- Quick New Habit Form Bar -->
            <div class="p-3.5 rounded-lg bg-white/[0.02] border border-white/[0.06] flex flex-col sm:flex-row items-center gap-2.5">
                <input 
                    type="text" 
                    @bind="newHabitName" 
                    placeholder="Nuevo hábito (ej: Leer 20 min, Meditar, Ejercicio)..." 
                    class="w-full px-3.5 py-1.5 rounded-md bg-white/[0.03] border border-white/[0.08] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-white/20 font-sans" />
                
                <button 
                    type="button"
                    @onclick="CreateHabitAsync"
                    disabled="@string.IsNullOrWhiteSpace(newHabitName)"
                    class="w-full sm:w-auto px-4 py-1.5 rounded-md bg-white/[0.08] hover:bg-white/[0.14] disabled:opacity-50 text-white font-medium text-xs border border-white/[0.1] transition-all shrink-0 cursor-pointer disabled:cursor-not-allowed">
                    + Crear Hábito
                </button>
            </div>

            <!-- Habits Checklist Grid -->
            @if (isLoading)
            {
                <div class="p-6 text-center text-xs font-mono text-slate-600">Cargando hábitos...</div>
            }
            else if (habits.Count == 0)
            {
                <div class="p-6 text-center rounded-lg bg-white/[0.02] border border-white/[0.04] text-xs text-slate-500">
                    No tenés hábitos registrados todavía. Creá el primero arriba para empezar.
                </div>
            }
            else
            {
                <div class="divide-y divide-white/[0.04] rounded-lg bg-white/[0.02] border border-white/[0.06] overflow-hidden">
                    @foreach (var habit in habits)
                    {
                        var isDoneToday = completedHabitIds.Contains(habit.Id);
                        <div class="px-4 py-3 flex items-center justify-between gap-4 hover:bg-white/[0.02] transition-colors">
                            <label class="flex items-center gap-3 cursor-pointer select-none flex-1 min-w-0">
                                <input 
                                    type="checkbox" 
                                    checked="@isDoneToday"
                                    @onchange="() => ToggleHabitTodayAsync(habit)"
                                    class="w-3.5 h-3.5 rounded text-sky-500 bg-slate-900 border-slate-700 focus:ring-sky-500/30 cursor-pointer" />
                                <span class="text-xs @(isDoneToday ? "line-through text-slate-400" : "text-slate-200 font-medium") truncate">
                                    @habit.Name
                                </span>
                            </label>
                            <span class="text-[10px] font-mono text-slate-400 shrink-0">@habit.Frequency</span>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- ======================================================================= -->
    <!-- TAB 2: METAS & ROADMAPS (ETAPA 6) -->
    <!-- ======================================================================= -->
    @if (activeTab == "roadmaps")
    {
        <div class="space-y-6">
            
            <!-- Quick New Roadmap Bar -->
            <div class="p-4 rounded-lg bg-white/[0.02] border border-white/[0.06] space-y-2.5">
                <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold">
                    Nuevo Roadmap Estratégico
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                    <input 
                        type="text" 
                        @bind="newRoadmapTitle" 
                        placeholder="Título del Roadmap (ej: Aprender Rust, Lanzar MVP)..." 
                        class="sm:col-span-2 px-3.5 py-1.5 rounded-md bg-white/[0.03] border border-white/[0.08] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-white/20 font-sans" />
                    
                    <button 
                        type="button"
                        @onclick="CreateRoadmapAsync"
                        disabled="@string.IsNullOrWhiteSpace(newRoadmapTitle)"
                        class="px-4 py-1.5 rounded-md bg-white/[0.08] hover:bg-white/[0.14] disabled:opacity-50 text-white font-medium text-xs border border-white/[0.1] transition-all cursor-pointer disabled:cursor-not-allowed">
                        + Crear Roadmap
                    </button>
                </div>
                
                <input 
                    type="text" 
                    @bind="newRoadmapSteps" 
                    placeholder="Hitos iniciales separados por coma (ej: Fundamentos, Proyecto Básico, Despliegue)..." 
                    class="w-full px-3.5 py-1.5 rounded-md bg-white/[0.03] border border-white/[0.08] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-white/20 font-sans" />
            </div>

            <!-- Roadmaps List -->
            @if (isLoading)
            {
                <div class="p-6 text-center text-xs font-mono text-slate-600">Cargando roadmaps...</div>
            }
            else if (roadmaps.Count == 0)
            {
                <div class="p-6 text-center rounded-lg bg-white/[0.02] border border-white/[0.04] text-xs text-slate-500">
                    No tenés roadmaps registrados todavía. Creá un roadmap arriba para descomponer cualquier objetivo.
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var roadmap in roadmaps)
                    {
                        var isCompleted = roadmap.ProgressPercentage >= 100;
                        <div class="p-4 rounded-lg bg-white/[0.02] border border-white/[0.06] space-y-3">
                            
                            <!-- Header & Progress -->
                            <div class="flex items-center justify-between text-xs gap-3">
                                <div class="space-y-0.5 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <h3 class="font-medium text-white truncate">@roadmap.Title</h3>
                                        <span class="px-1.5 py-0.2 rounded text-[9px] font-mono uppercase @(isCompleted ? "bg-emerald-500/10 text-emerald-300" : "bg-white/[0.06] text-slate-400")">
                                            @(isCompleted ? "Completado" : "En Curso")
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(roadmap.Description))
                                    {
                                        <p class="text-[11px] text-slate-400 truncate">@roadmap.Description</p>
                                    }
                                </div>

                                <div class="text-right shrink-0 font-mono text-[11px]">
                                    <span class="text-white font-semibold">@roadmap.ProgressPercentage%</span>
                                    <span class="text-slate-400 block text-[10px]">@roadmap.Milestones.Count(m => m.Status == "completed")/@roadmap.Milestones.Count hitos</span>
                                </div>
                            </div>

                            <!-- Slim Hairline Progress Track -->
                            <div class="w-full h-1 rounded-full bg-white/[0.06] overflow-hidden">
                                <div class="h-full bg-sky-400 rounded-full transition-all duration-300" style="width: @(roadmap.ProgressPercentage)%"></div>
                            </div>

                            <!-- Milestones Stepper Checklist -->
                            <div class="pt-2 space-y-1.5 border-t border-white/[0.04]">
                                @if (roadmap.Milestones.Count == 0)
                                {
                                    <p class="text-[11px] text-slate-500 italic">No hay hitos en esta ruta.</p>
                                }
                                else
                                {
                                    <div class="divide-y divide-white/[0.03]">
                                        @foreach (var milestone in roadmap.Milestones.OrderBy(m => m.OrderIndex))
                                        {
                                            var mDone = milestone.Status.Equals("completed", StringComparison.OrdinalIgnoreCase);
                                            <div class="py-1.5 flex items-center justify-between text-xs gap-3">
                                                <label class="flex items-center gap-2.5 cursor-pointer select-none flex-1 min-w-0">
                                                    <input 
                                                        type="checkbox" 
                                                        checked="@mDone"
                                                        @onchange="(e) => ToggleMilestoneAsync(milestone, e)"
                                                        class="w-3.5 h-3.5 rounded text-sky-500 bg-slate-900 border-slate-700 focus:ring-sky-500/30 cursor-pointer" />
                                                    <span class="@(mDone ? "line-through text-slate-400" : "text-slate-200") truncate">
                                                        @milestone.Title
                                                    </span>
                                                </label>
                                                @if (milestone.CompletedAt.HasValue)
                                                {
                                                    <span class="text-[10px] font-mono text-slate-400 shrink-0">@milestone.CompletedAt.Value.ToLocalTime().ToString("dd MMM")</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Fast Add Milestone Row -->
                                <div class="flex items-center gap-2 pt-1.5">
                                    <input 
                                        type="text" 
                                        @bind="newMilestoneTitles[roadmap.Id]" 
                                        placeholder="Agregar siguiente hito..." 
                                        class="flex-1 px-3 py-1 rounded-md bg-white/[0.03] border border-white/[0.06] text-slate-100 text-xs placeholder-slate-500 focus:outline-none focus:border-white/20 font-sans" />
                                    
                                    <button 
                                        type="button"
                                        @onclick="() => AddMilestoneToRoadmapAsync(roadmap.Id)"
                                        class="px-2.5 py-1 rounded-md bg-white/[0.06] hover:bg-white/[0.12] text-slate-300 hover:text-white text-xs transition-all cursor-pointer">
                                        + Paso
                                    </button>
                                </div>

                            </div>

                        </div>
                    }
                </div>
            }

        </div>
    }

</div>

@code {
    private string activeTab = "habits";
    private bool isLoading = true;
    private string? statusMessage;
    private bool isSuccess;

    // Habits state
    private List<Habit> habits = [];
    private HashSet<string> completedHabitIds = [];
    private string newHabitName = string.Empty;

    // Roadmaps state
    private List<Roadmap> roadmaps = [];
    private string newRoadmapTitle = string.Empty;
    private string newRoadmapSteps = string.Empty;
    private Dictionary<string, string> newMilestoneTitles = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            // 1. Load Habits
            var allHabits = await HabitRepository.GetAllAsync();
            habits = allHabits.ToList();

            var todayEvents = await HabitRepository.GetEventsAsync(since: DateTimeOffset.UtcNow.Date);
            completedHabitIds = todayEvents.Select(e => e.HabitId).ToHashSet();

            // 2. Load Roadmaps
            var allRoadmaps = await RoadmapRepository.GetAllAsync();
            roadmaps = allRoadmaps.ToList();

            foreach (var r in roadmaps)
            {
                if (!newMilestoneTitles.ContainsKey(r.Id))
                {
                    newMilestoneTitles[r.Id] = string.Empty;
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error al cargar datos: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateHabitAsync()
    {
        if (string.IsNullOrWhiteSpace(newHabitName)) return;

        try
        {
            var result = await CommandRegistry.ExecuteAsync(HabitCreateCommand.CommandId, new Dictionary<string, object?>
            {
                ["name"] = newHabitName.Trim(),
                ["frequency"] = "daily"
            });

            if (result.IsSuccess)
            {
                newHabitName = string.Empty;
                statusMessage = "✓ Hábito creado exitosamente.";
                isSuccess = true;
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al crear el hábito.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task ToggleHabitTodayAsync(Habit habit)
    {
        try
        {
            var result = await CommandRegistry.ExecuteAsync(HabitCompleteCommand.CommandId, new Dictionary<string, object?>
            {
                ["habit_id"] = habit.Id
            });

            if (result.IsSuccess)
            {
                statusMessage = $"✓ Hábito '{habit.Name}' completado hoy.";
                isSuccess = true;
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al registrar hábito.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task CreateRoadmapAsync()
    {
        if (string.IsNullOrWhiteSpace(newRoadmapTitle)) return;

        try
        {
            var milestones = string.IsNullOrWhiteSpace(newRoadmapSteps)
                ? new List<string>()
                : newRoadmapSteps.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

            var result = await CommandRegistry.ExecuteAsync(RoadmapCreateCommand.CommandId, new Dictionary<string, object?>
            {
                ["title"] = newRoadmapTitle.Trim(),
                ["milestones"] = milestones
            });

            if (result.IsSuccess)
            {
                newRoadmapTitle = string.Empty;
                newRoadmapSteps = string.Empty;
                statusMessage = "✓ Roadmap estratégico creado exitosamente.";
                isSuccess = true;
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al crear el roadmap.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task AddMilestoneToRoadmapAsync(string roadmapId)
    {
        if (!newMilestoneTitles.TryGetValue(roadmapId, out var title) || string.IsNullOrWhiteSpace(title))
            return;

        try
        {
            var result = await CommandRegistry.ExecuteAsync(RoadmapAddMilestoneCommand.CommandId, new Dictionary<string, object?>
            {
                ["roadmap_id"] = roadmapId,
                ["title"] = title.Trim()
            });

            if (result.IsSuccess)
            {
                newMilestoneTitles[roadmapId] = string.Empty;
                statusMessage = "✓ Hito añadido al roadmap.";
                isSuccess = true;
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al agregar hito.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task ToggleMilestoneAsync(RoadmapMilestone milestone, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;

        try
        {
            var result = await CommandRegistry.ExecuteAsync(RoadmapCompleteMilestoneCommand.CommandId, new Dictionary<string, object?>
            {
                ["milestone_id"] = milestone.Id,
                ["completed"] = isChecked
            });

            if (result.IsSuccess)
            {
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al actualizar hito.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }
}
