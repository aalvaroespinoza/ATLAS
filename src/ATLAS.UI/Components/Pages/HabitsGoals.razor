@page "/habits-goals"
@inject IHabitRepository HabitRepository
@inject IGoalRepository GoalRepository
@inject IRoadmapRepository RoadmapRepository
@inject ICommandRegistry CommandRegistry

<div class="space-y-6 max-w-3xl pb-16 animate-atlas-in">
    
    <!-- Page Header & Clean Segmented Switcher -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/[0.08] pb-4">
        <h1 class="text-lg font-bold tracking-tight text-white">
            Hábitos & Roadmaps
        </h1>

        <!-- Segmented Tab Switcher -->
        <div class="flex items-center p-1 rounded-xl bg-white/[0.04] border border-white/[0.06] select-none">
            <button 
                type="button"
                @onclick="@(() => activeTab = "habits")"
                class="px-3.5 py-1.5 rounded-lg text-xs transition-all cursor-pointer @(activeTab == "habits" ? "bg-indigo-600 text-white font-semibold shadow-sm shadow-indigo-500/25" : "text-slate-400 hover:text-slate-200")">
                Hábitos (@habits.Count)
            </button>
            <button 
                type="button"
                @onclick="@(() => activeTab = "roadmaps")"
                class="px-3.5 py-1.5 rounded-lg text-xs transition-all cursor-pointer @(activeTab == "roadmaps" ? "bg-indigo-600 text-white font-semibold shadow-sm shadow-indigo-500/25" : "text-slate-400 hover:text-slate-200")">
                Roadmaps (@roadmaps.Count)
            </button>
        </div>
    </div>

    <!-- Status Message Indicator -->
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="px-3.5 py-2 rounded-xl text-xs font-medium flex items-center justify-between animate-atlas-in @(isSuccess ? "bg-emerald-500/10 border border-emerald-500/20 text-emerald-300" : "bg-rose-500/10 border border-rose-500/20 text-rose-300")">
            <span>@(isSuccess ? "✓ " : "✕ ") @statusMessage</span>
            <button @onclick="() => statusMessage = null" class="text-slate-400 hover:text-white text-xs">✕</button>
        </div>
    }

    <!-- TAB 1: HÁBITOS DIARIOS -->
    @if (activeTab == "habits")
    {
        <div class="space-y-4">
            
            <!-- Quick New Habit Row -->
            <div class="atlas-surface rounded-2xl p-3 flex flex-col sm:flex-row items-center gap-2.5">
                <div class="flex-1 w-full">
                    <AtlasInput 
                        @bind-Value="newHabitName" 
                        Placeholder="Nuevo hábito (ej: Leer 20 min, Meditar, Gimnasio)..." />
                </div>
                
                <AtlasButton 
                    Variant="primary" 
                    Size="md" 
                    OnClick="CreateHabitAsync"
                    IsDisabled="@string.IsNullOrWhiteSpace(newHabitName)">
                    + Crear Hábito
                </AtlasButton>
            </div>

            <!-- Habits Checklist -->
            @if (isLoading)
            {
                <AtlasLoadingState Message="Cargando hábitos..." />
            }
            else if (habits.Count == 0)
            {
                <AtlasEmptyState 
                    Title="Sin hábitos registrados" 
                    Description="Creá tu primer hábito diario arriba para empezar a construir constancia." />
            }
            else
            {
                <div class="atlas-surface rounded-2xl divide-y divide-white/[0.04] overflow-hidden">
                    @foreach (var habit in habits)
                    {
                        var isDoneToday = completedHabitIds.Contains(habit.Id);
                        <AtlasListItem 
                            Title="@habit.Name" 
                            Subtitle="@($"Frecuencia: {habit.Frequency}")" 
                            MetaText="@(isDoneToday ? "COMPLETADO" : "PENDIENTE")">
                            <PrefixContent>
                                <input 
                                    type="checkbox" 
                                    checked="@isDoneToday"
                                    @onchange="() => ToggleHabitTodayAsync(habit)"
                                    class="w-4 h-4 rounded text-indigo-500 bg-slate-900 border-slate-700 focus:ring-indigo-500/30 cursor-pointer" />
                            </PrefixContent>
                            <SuffixContent>
                                <AtlasBadge Variant="@(isDoneToday ? "success" : "neutral")">
                                    @(isDoneToday ? "✓ Hecho hoy" : "Pendiente")
                                </AtlasBadge>
                            </SuffixContent>
                        </AtlasListItem>
                    }
                </div>
            }
        </div>
    }

    <!-- TAB 2: ROADMAPS ESTRATÉGICOS -->
    @if (activeTab == "roadmaps")
    {
        <div class="space-y-5">
            
            <!-- Quick New Roadmap Row -->
            <div class="atlas-surface rounded-2xl p-3.5 space-y-2.5">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                    <div class="sm:col-span-2">
                        <AtlasInput 
                            @bind-Value="newRoadmapTitle" 
                            Placeholder="Título de la meta o roadmap (ej: Lanzar MVP)..." />
                    </div>
                    
                    <AtlasButton 
                        Variant="primary" 
                        Size="md" 
                        OnClick="CreateRoadmapAsync"
                        IsDisabled="@string.IsNullOrWhiteSpace(newRoadmapTitle)">
                        + Crear Roadmap
                    </AtlasButton>
                </div>
                
                <AtlasInput 
                    @bind-Value="newRoadmapSteps" 
                    Placeholder="Hitos iniciales separados por coma (ej: Fundamentos, Prototipo, Lanzamiento)..." />
            </div>

            <!-- Roadmaps List -->
            @if (isLoading)
            {
                <AtlasLoadingState Message="Cargando roadmaps..." />
            }
            else if (roadmaps.Count == 0)
            {
                <AtlasEmptyState 
                    Title="Sin roadmaps activos" 
                    Description="Creá un roadmap arriba para descomponer objetivos complejos en etapas." />
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var roadmap in roadmaps)
                    {
                        var isCompleted = roadmap.ProgressPercentage >= 100;
                        <div class="atlas-surface rounded-2xl p-5 space-y-3.5 shadow-md">
                            
                            <!-- Header & Progress -->
                            <div class="flex items-center justify-between text-xs gap-3">
                                <div class="space-y-1 min-w-0">
                                    <div class="flex items-center gap-2.5">
                                        <h3 class="text-sm font-semibold text-white truncate">@roadmap.Title</h3>
                                        <AtlasBadge Variant="@(isCompleted ? "success" : "accent")">
                                            @(isCompleted ? "Completado" : "En Curso")
                                        </AtlasBadge>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(roadmap.Description))
                                    {
                                        <p class="text-xs text-slate-400 truncate">@roadmap.Description</p>
                                    }
                                </div>

                                <div class="text-right shrink-0 font-mono text-xs">
                                    <span class="text-indigo-300 font-bold">@roadmap.ProgressPercentage%</span>
                                    <span class="text-slate-500 block text-[10px]">
                                        @roadmap.Milestones.Count(m => m.Status == "completed")/@roadmap.Milestones.Count hitos
                                    </span>
                                </div>
                            </div>

                            <!-- Progress Track -->
                            <AtlasProgress Value="@roadmap.ProgressPercentage" Variant="accent" />

                            <!-- Milestones Checklist -->
                            <div class="pt-2 space-y-2 border-t border-white/[0.04]">
                                @if (roadmap.Milestones.Count > 0)
                                {
                                    <div class="divide-y divide-white/[0.03]">
                                        @foreach (var milestone in roadmap.Milestones.OrderBy(m => m.OrderIndex))
                                        {
                                            var mDone = milestone.Status.Equals("completed", StringComparison.OrdinalIgnoreCase);
                                            <div class="py-2 flex items-center justify-between text-xs gap-3">
                                                <label class="flex items-center gap-2.5 cursor-pointer select-none flex-1 min-w-0">
                                                    <input 
                                                        type="checkbox" 
                                                        checked="@mDone"
                                                        @onchange="(e) => ToggleMilestoneAsync(milestone, e)"
                                                        class="w-4 h-4 rounded text-indigo-500 bg-slate-900 border-slate-700 focus:ring-indigo-500/30 cursor-pointer" />
                                                    <span class="@(mDone ? "line-through text-slate-500" : "text-slate-200 font-medium") truncate">
                                                        Paso @(milestone.OrderIndex + 1): @milestone.Title
                                                    </span>
                                                </label>
                                                @if (milestone.CompletedAt.HasValue)
                                                {
                                                    <span class="text-[10px] font-mono text-slate-500 shrink-0">
                                                        @milestone.CompletedAt.Value.ToLocalTime().ToString("dd MMM")
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Fast Add Milestone -->
                                <div class="flex items-center gap-2 pt-2">
                                    <div class="flex-1">
                                        <AtlasInput 
                                            @bind-Value="newMilestoneTitles[roadmap.Id]" 
                                            Placeholder="Agregar siguiente hito a esta ruta..." />
                                    </div>
                                    
                                    <AtlasButton 
                                        Variant="secondary" 
                                        Size="sm" 
                                        OnClick="() => AddMilestoneToRoadmapAsync(roadmap.Id)">
                                        + Paso
                                    </AtlasButton>
                                </div>

                            </div>

                        </div>
                    }
                </div>
            }

        </div>
    }

</div>

@code {
    private string activeTab = "habits";
    private bool isLoading = true;
    private string? statusMessage;
    private bool isSuccess;

    // Habits state
    private List<Habit> habits = [];
    private HashSet<string> completedHabitIds = [];
    private string newHabitName = string.Empty;

    // Roadmaps state
    private List<Roadmap> roadmaps = [];
    private string newRoadmapTitle = string.Empty;
    private string newRoadmapSteps = string.Empty;
    private Dictionary<string, string> newMilestoneTitles = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            // 1. Load Habits
            var allHabits = await HabitRepository.GetAllAsync();
            habits = allHabits.ToList();

            var todayEvents = await HabitRepository.GetEventsAsync(since: DateTimeOffset.UtcNow.Date);
            completedHabitIds = todayEvents.Select(e => e.HabitId).ToHashSet();

            // 2. Load Roadmaps
            var allRoadmaps = await RoadmapRepository.GetAllAsync();
            roadmaps = allRoadmaps.ToList();

            foreach (var r in roadmaps)
            {
                if (!newMilestoneTitles.ContainsKey(r.Id))
                {
                    newMilestoneTitles[r.Id] = string.Empty;
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error al cargar datos: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateHabitAsync()
    {
        if (string.IsNullOrWhiteSpace(newHabitName)) return;

        try
        {
            var result = await CommandRegistry.ExecuteAsync(HabitCreateCommand.CommandId, new Dictionary<string, object?>
            {
                ["name"] = newHabitName.Trim(),
                ["frequency"] = "daily"
            });

            if (result.IsSuccess)
            {
                newHabitName = string.Empty;
                statusMessage = "Hábito creado exitosamente.";
                isSuccess = true;
                _ = Task.Delay(2500).ContinueWith(_ => { statusMessage = null; InvokeAsync(StateHasChanged); });
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al crear el hábito.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task ToggleHabitTodayAsync(Habit habit)
    {
        try
        {
            var result = await CommandRegistry.ExecuteAsync(HabitCompleteCommand.CommandId, new Dictionary<string, object?>
            {
                ["habit_id"] = habit.Id
            });

            if (result.IsSuccess)
            {
                statusMessage = $"Hábito '{habit.Name}' registrado hoy.";
                isSuccess = true;
                _ = Task.Delay(2500).ContinueWith(_ => { statusMessage = null; InvokeAsync(StateHasChanged); });
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al registrar hábito.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task CreateRoadmapAsync()
    {
        if (string.IsNullOrWhiteSpace(newRoadmapTitle)) return;

        try
        {
            var milestones = string.IsNullOrWhiteSpace(newRoadmapSteps)
                ? new List<string>()
                : newRoadmapSteps.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

            var result = await CommandRegistry.ExecuteAsync(RoadmapCreateCommand.CommandId, new Dictionary<string, object?>
            {
                ["title"] = newRoadmapTitle.Trim(),
                ["milestones"] = milestones
            });

            if (result.IsSuccess)
            {
                newRoadmapTitle = string.Empty;
                newRoadmapSteps = string.Empty;
                statusMessage = "Roadmap estratégico creado exitosamente.";
                isSuccess = true;
                _ = Task.Delay(2500).ContinueWith(_ => { statusMessage = null; InvokeAsync(StateHasChanged); });
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al crear el roadmap.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task AddMilestoneToRoadmapAsync(string roadmapId)
    {
        if (!newMilestoneTitles.TryGetValue(roadmapId, out var title) || string.IsNullOrWhiteSpace(title))
            return;

        try
        {
            var result = await CommandRegistry.ExecuteAsync(RoadmapAddMilestoneCommand.CommandId, new Dictionary<string, object?>
            {
                ["roadmap_id"] = roadmapId,
                ["title"] = title.Trim()
            });

            if (result.IsSuccess)
            {
                newMilestoneTitles[roadmapId] = string.Empty;
                statusMessage = "Hito añadido al roadmap.";
                isSuccess = true;
                _ = Task.Delay(2500).ContinueWith(_ => { statusMessage = null; InvokeAsync(StateHasChanged); });
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al agregar hito.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task ToggleMilestoneAsync(RoadmapMilestone milestone, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;

        try
        {
            var result = await CommandRegistry.ExecuteAsync(RoadmapCompleteMilestoneCommand.CommandId, new Dictionary<string, object?>
            {
                ["milestone_id"] = milestone.Id,
                ["completed"] = isChecked
            });

            if (result.IsSuccess)
            {
                await LoadDataAsync();
            }
            else
            {
                statusMessage = result.ErrorMessage ?? "Error al actualizar hito.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }
}
