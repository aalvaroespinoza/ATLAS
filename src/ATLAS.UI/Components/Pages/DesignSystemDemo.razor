@page "/design-system"

<div class="space-y-12 max-w-4xl pb-24 animate-atlas-in">
    
    <!-- Demo Header -->
    <div class="space-y-1.5 border-b border-white/[0.08] pb-5">
        <div class="flex items-center gap-3">
            <h1 class="text-lg font-bold tracking-tight text-white flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 shadow-sm shadow-indigo-500/50"></span>
                ATLAS Design System — Fuente Única de Verdad
            </h1>
            <AtlasBadge Variant="accent">Indigo / Obsidiana</AtlasBadge>
        </div>
        <p class="text-xs text-slate-400">
            Identidad visual personal, moderna y táctil. Centralización de componentes, tokens y estados del sistema.
        </p>
    </div>

    <!-- ======================================================================= -->
    <!-- 1. IDENTIDAD DE COLOR & SUPERFICIES -->
    <!-- ======================================================================= -->
    <section class="space-y-3">
        <AtlasSectionHeader Title="1. Superficies & Paleta Obsidiana" />

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="p-3.5 rounded-xl bg-[#090b10] border border-white/[0.08] space-y-1">
                <span class="text-[10px] font-mono text-slate-400 block">Canvas</span>
                <span class="text-xs font-mono font-semibold text-white">#090B10</span>
            </div>
            <div class="p-3.5 rounded-xl bg-[#10141e] border border-white/[0.08] space-y-1">
                <span class="text-[10px] font-mono text-slate-400 block">Personal Dock</span>
                <span class="text-xs font-mono font-semibold text-white">#10141E</span>
            </div>
            <div class="p-3.5 rounded-xl bg-[#121724] border border-white/[0.08] space-y-1">
                <span class="text-[10px] font-mono text-slate-400 block">Surface Panel</span>
                <span class="text-xs font-mono font-semibold text-white">#121724</span>
            </div>
            <div class="p-3.5 rounded-xl bg-[#171e2e] border border-white/[0.08] space-y-1">
                <span class="text-[10px] font-mono text-slate-400 block">Elevated Modal</span>
                <span class="text-xs font-mono font-semibold text-white">#171E2E</span>
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
            <div class="p-3 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-between">
                <span class="text-xs font-medium text-indigo-300">Indigo Hero</span>
                <span class="w-3 h-3 rounded-full bg-indigo-500 shadow-sm shadow-indigo-500/50"></span>
            </div>
            <div class="p-3 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-between">
                <span class="text-xs font-medium text-emerald-300">Success</span>
                <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
            </div>
            <div class="p-3 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-between">
                <span class="text-xs font-medium text-amber-300">Warning</span>
                <span class="w-3 h-3 rounded-full bg-amber-400"></span>
            </div>
            <div class="p-3 rounded-xl bg-rose-500/15 border border-rose-500/30 flex items-center justify-between">
                <span class="text-xs font-medium text-rose-300">Danger</span>
                <span class="w-3 h-3 rounded-full bg-rose-400"></span>
            </div>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 2. TIPOGRAFÍA & RITMO -->
    <!-- ======================================================================= -->
    <section class="space-y-3">
        <AtlasSectionHeader Title="2. Jerarquía Tipográfica" />

        <div class="atlas-surface rounded-2xl p-6 space-y-4">
            <div>
                <span class="text-[10px] font-mono text-indigo-400 uppercase tracking-wider block">Hero Title (18px Bold)</span>
                <h1 class="text-lg font-bold text-slate-100">Hoy: Avanzar en el capítulo de Rust & 2 hábitos pendientes</h1>
            </div>

            <AtlasDivider />

            <div>
                <span class="text-[10px] font-mono text-indigo-400 uppercase tracking-wider block">Body Reading (13.5px Regular)</span>
                <p class="text-[13.5px] text-slate-300 leading-relaxed max-w-2xl">
                    ATLAS centraliza captura, memoria y rutinas personales. El diseño privilegia la respiración visual y la acción inmediata sobre cualquier métrica decorativa.
                </p>
            </div>

            <AtlasDivider />

            <div class="flex flex-wrap items-center gap-6">
                <div>
                    <span class="text-[10px] font-mono text-slate-400 uppercase block">Data/Money Mono</span>
                    <span class="text-xs font-mono text-slate-200">+$184.200 ARS</span>
                </div>
                <div>
                    <span class="text-[10px] font-mono text-slate-400 uppercase block">Timestamp</span>
                    <span class="text-xs font-mono text-slate-400">hace 14m • Telegram</span>
                </div>
                <div>
                    <span class="text-[10px] font-mono text-slate-400 uppercase block">Command Badge</span>
                    <kbd class="px-1.5 py-0.5 rounded-md bg-white/[0.06] border border-white/[0.08] text-[10px] font-mono text-slate-300">Ctrl+Space</kbd>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 3. BOTONES, ICONOS & AVATARES -->
    <!-- ======================================================================= -->
    <section class="space-y-3">
        <AtlasSectionHeader Title="3. Botones, Iconos & Avatares" />

        <div class="atlas-surface rounded-2xl p-6 space-y-5">
            <div class="flex flex-wrap items-center gap-3">
                <AtlasButton Variant="primary" ShortcutText="↵">Primary Action</AtlasButton>
                <AtlasButton Variant="secondary" ShortcutText="⌘S">Secondary Action</AtlasButton>
                <AtlasButton Variant="ghost">Ghost Button</AtlasButton>
                <AtlasButton Variant="danger">Eliminar</AtlasButton>
                <AtlasButton Variant="primary" IsLoading="true">Guardando</AtlasButton>
                <AtlasButton Variant="secondary" IsDisabled="true">Deshabilitado</AtlasButton>
            </div>

            <AtlasDivider />

            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] font-mono text-slate-400">Icon Buttons:</span>
                    <AtlasIconButton Title="Buscar ⌘K">
                        <svg class="w-4 h-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </AtlasIconButton>
                    <AtlasIconButton Title="Captura Rápida ⚡" Variant="accent">
                        <svg class="w-4 h-4 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </AtlasIconButton>
                </div>

                <div class="flex items-center gap-3 pl-4 border-l border-white/[0.08]">
                    <span class="text-[11px] font-mono text-slate-400">Avatares:</span>
                    <AtlasAvatar Initials="A" Size="sm" />
                    <AtlasAvatar Initials="ÁE" Size="md" />
                </div>
            </div>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 4. INPUTS & HERO COMMAND INPUT -->
    <!-- ======================================================================= -->
    <section class="space-y-3">
        <AtlasSectionHeader Title="4. Entradas & Formularios" />

        <div class="atlas-surface rounded-2xl p-6 space-y-4">
            <AtlasCommandInput 
                @bind-Value="demoCommandText" 
                Placeholder="¿Qué tenés en mente o qué necesitás hacer?... (Escribí o usá '?')" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
                <AtlasInput 
                    Label="Título del Hábito" 
                    @bind-Value="demoInputText" 
                    Placeholder="Ej: Meditar 10 minutos..." 
                    IsRequired="true" />

                <AtlasSearchInput 
                    @bind-Value="demoSearchText" 
                    Placeholder="Buscar notas o comandos..." />
            </div>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 5. LISTAS UNIVERSALES (UNIVERSAL LIST ITEM) -->
    <!-- ======================================================================= -->
    <section class="space-y-3">
        <AtlasSectionHeader Title="5. Filas Universales (ListItem)" Count="3" />

        <div class="atlas-surface rounded-2xl divide-y divide-white/[0.04] overflow-hidden">
            <AtlasListItem 
                Title="Lectura de documentación de WebAssembly" 
                Subtitle="Hábito diario • Racha actual: 12 días" 
                MetaText="HOY">
                <PrefixContent>
                    <input type="checkbox" class="w-4 h-4 rounded text-indigo-500 bg-slate-900 border-slate-700 cursor-pointer" />
                </PrefixContent>
                <SuffixContent>
                    <AtlasBadge Variant="accent">En curso</AtlasBadge>
                </SuffixContent>
            </AtlasListItem>

            <AtlasListItem 
                Title="Supermercado Coto — Compra mensual" 
                Subtitle="Registrado vía Telegram /expense" 
                MetaText="-$48.200"
                IsSelected="true">
                <PrefixContent>
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                </PrefixContent>
                <SuffixContent>
                    <span class="text-[10px] font-mono text-slate-400">ayer</span>
                </SuffixContent>
            </AtlasListItem>

            <AtlasListItem 
                Title="Meditar 10 minutos" 
                Subtitle="Completado a las 08:30" 
                MetaText="HECHO"
                IsCompleted="true">
                <PrefixContent>
                    <input type="checkbox" checked class="w-4 h-4 rounded text-indigo-500 bg-slate-900 border-slate-700 cursor-pointer" />
                </PrefixContent>
                <SuffixContent>
                    <AtlasBadge Variant="success">✓ Hecho</AtlasBadge>
                </SuffixContent>
            </AtlasListItem>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 6. PROGRESO, BADGES & ESTADOS -->
    <!-- ======================================================================= -->
    <section class="space-y-3">
        <AtlasSectionHeader Title="6. Progreso, Badges & Empty States" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="atlas-surface rounded-2xl p-5 space-y-4">
                <span class="text-[11px] font-mono text-slate-400 uppercase">Barras de Progreso:</span>
                <AtlasProgress Value="75" Label="Roadmap: Aprender Rust (Etapa 3/4)" ShowLabel="true" Variant="accent" />
                <AtlasProgress Value="100" Label="Meta de Ahorro" ShowLabel="true" Variant="success" />

                <AtlasDivider />

                <span class="text-[11px] font-mono text-slate-400 uppercase block">Badges Dot+Label:</span>
                <div class="flex flex-wrap gap-2">
                    <AtlasBadge Variant="accent">Activo</AtlasBadge>
                    <AtlasBadge Variant="success">Completado</AtlasBadge>
                    <AtlasBadge Variant="warning">Pendiente</AtlasBadge>
                    <AtlasBadge Variant="danger">Alerta</AtlasBadge>
                    <AtlasBadge Variant="mono">#ID-49F</AtlasBadge>
                </div>
            </div>

            <AtlasEmptyState 
                Title="Tu mente está despejada" 
                Description="No hay tareas pendientes por hoy. Presioná Ctrl+Space para capturar una idea o relajate.">
                <ActionContent>
                    <AtlasButton Variant="primary" Size="sm" ShortcutText="Ctrl+Space">+ Capturar Idea</AtlasButton>
                </ActionContent>
            </AtlasEmptyState>
        </div>
    </section>

</div>

@code {
    private string? demoCommandText;
    private string? demoInputText;
    private string? demoSearchText;
}
