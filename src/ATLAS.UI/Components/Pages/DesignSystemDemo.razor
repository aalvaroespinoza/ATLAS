@page "/design-system"

<div class="space-y-12 max-w-4xl pb-24">
    
    <!-- Demo Page Header -->
    <div class="space-y-1 border-b border-white/[0.06] pb-4">
        <div class="flex items-center gap-2">
            <h1 class="text-base font-semibold tracking-tight text-white">
                ATLAS Design System — Referencia Visual
            </h1>
            <AtlasBadge Variant="mono">Internal / Demo</AtlasBadge>
        </div>
        <p class="text-xs text-slate-400">
            Catálogo y fuente de verdad de componentes, tokens y estados del sistema "Menos interfaz, más capacidad".
        </p>
    </div>

    <!-- ======================================================================= -->
    <!-- 1. TIPOGRAFÍA & ESCALAS -->
    <!-- ======================================================================= -->
    <section class="space-y-4">
        <AtlasSectionHeader Title="1. Tipografía & Jerarquías" />

        <div class="atlas-surface p-5 space-y-4">
            <div class="space-y-1">
                <span class="text-[10px] font-mono text-slate-500 uppercase">Page Title (16px SemiBold)</span>
                <h1 class="text-base font-semibold text-white">El conocimiento personal estructurado en acciones</h1>
            </div>

            <AtlasDivider />

            <div class="space-y-1">
                <span class="text-[10px] font-mono text-slate-500 uppercase">Section Title (13px Medium)</span>
                <h2 class="text-[13px] font-medium text-slate-200">Acción Inmediata — Tareas & Hábitos</h2>
            </div>

            <AtlasDivider />

            <div class="space-y-1">
                <span class="text-[10px] font-mono text-slate-500 uppercase">Body Regular (13px Regular - Slate 400)</span>
                <p class="text-[13px] text-slate-400 leading-relaxed">
                    ATLAS centraliza notas, eventos y sincronización sin intermediarios en la nube. La interfaz debe sentirse rápida, silenciosa y libre de adornos decorativos superfluos.
                </p>
            </div>

            <AtlasDivider />

            <div class="flex items-center gap-6">
                <div>
                    <span class="text-[10px] font-mono text-slate-500 uppercase block">Mono Header</span>
                    <span class="text-[10px] font-mono uppercase tracking-widest text-slate-500 font-semibold">EN PROGRESO</span>
                </div>
                <div>
                    <span class="text-[10px] font-mono text-slate-500 uppercase block">Mono Data</span>
                    <span class="text-xs font-mono text-slate-300">+$124.500 ARS • 14:32</span>
                </div>
                <div>
                    <span class="text-[10px] font-mono text-slate-500 uppercase block">Keyboard Kbd</span>
                    <kbd class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[10px] font-mono text-slate-300">Ctrl+Space</kbd>
                </div>
            </div>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 2. BOTONES & ACCIONES -->
    <!-- ======================================================================= -->
    <section class="space-y-4">
        <AtlasSectionHeader Title="2. Botones & Acciones" />

        <div class="atlas-surface p-5 space-y-4">
            <div class="flex flex-wrap items-center gap-3">
                <AtlasButton Variant="primary">Primary Action</AtlasButton>
                <AtlasButton Variant="secondary">Secondary Action</AtlasButton>
                <AtlasButton Variant="ghost">Ghost Button</AtlasButton>
                <AtlasButton Variant="danger">Danger Action</AtlasButton>
                <AtlasButton Variant="secondary" IsLoading="true">Procesando</AtlasButton>
                <AtlasButton Variant="secondary" IsDisabled="true">Deshabilitado</AtlasButton>
            </div>

            <AtlasDivider />

            <div class="flex items-center gap-4">
                <span class="text-[10px] font-mono text-slate-500 uppercase">Icon Buttons:</span>
                <AtlasIconButton Title="Buscar">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </AtlasIconButton>
                <AtlasIconButton Title="Ajustes" Variant="secondary">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    </svg>
                </AtlasIconButton>
            </div>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 3. INPUTS & CONTROLES DE FORMULARIO -->
    <!-- ======================================================================= -->
    <section class="space-y-4">
        <AtlasSectionHeader Title="3. Inputs & Formularios" />

        <div class="atlas-surface p-5 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <AtlasInput 
                    Label="Título de la Nota" 
                    @bind-Value="demoInputText" 
                    Placeholder="Ej: Resumen semanal de arquitectura..." 
                    IsRequired="true" />

                <AtlasInput 
                    Label="Token / Clave Secreta" 
                    @bind-Value="demoTokenText" 
                    Placeholder="Ingresá credencial..." 
                    IsMono="true"
                    RightLabel="Windows Vault" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <AtlasSearchInput @bind-Value="demoSearchQuery" Placeholder="Búsqueda instantánea..." />
                
                <AtlasInput 
                    Label="Input con Error" 
                    Value="monto_invalido" 
                    HasError="true" 
                    ErrorMessage="El formato numérico es incorrecto." />
            </div>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 4. FILAS DE LISTAS & DENSIDAD INFORMATIVA -->
    <!-- ======================================================================= -->
    <section class="space-y-4">
        <AtlasSectionHeader Title="4. Filas de Lista (Universal ListItem)" Count="3" />

        <div class="atlas-surface divide-y divide-white/[0.04] overflow-hidden">
            <AtlasListItem 
                Title="Lectura de documentación de WebAssembly" 
                Subtitle="Hábito diario • Racha actual: 12 días" 
                MetaText="HOY"
                IsCompleted="false">
                <PrefixContent>
                    <input type="checkbox" class="w-3.5 h-3.5 rounded text-sky-500 bg-slate-900 border-slate-700 cursor-pointer" />
                </PrefixContent>
                <SuffixContent>
                    <AtlasBadge Variant="accent">En curso</AtlasBadge>
                </SuffixContent>
            </AtlasListItem>

            <AtlasListItem 
                Title="Supermercado Coto — Compra mensual" 
                Subtitle="Registrado vía Telegram /expense" 
                MetaText="-$48.200"
                IsSelected="true">
                <PrefixContent>
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                </PrefixContent>
                <SuffixContent>
                    <span class="text-[10px] font-mono text-slate-500">ayer</span>
                </SuffixContent>
            </AtlasListItem>

            <AtlasListItem 
                Title="Meditar 10 minutos" 
                Subtitle="Completado a las 08:30" 
                MetaText="HECHO"
                IsCompleted="true">
                <PrefixContent>
                    <input type="checkbox" checked class="w-3.5 h-3.5 rounded text-sky-500 bg-slate-900 border-slate-700 cursor-pointer" />
                </PrefixContent>
                <SuffixContent>
                    <AtlasBadge Variant="success">✓ Hecho</AtlasBadge>
                </SuffixContent>
            </AtlasListItem>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 5. BARRAS DE PROGRESO & BADGES -->
    <!-- ======================================================================= -->
    <section class="space-y-4">
        <AtlasSectionHeader Title="5. Progreso & Badges Semánticos" />

        <div class="atlas-surface p-5 space-y-5">
            <div class="space-y-3">
                <AtlasProgress Value="75" Label="Roadmap: Aprender Rust (Etapa 3/4)" ShowLabel="true" Variant="accent" />
                <AtlasProgress Value="100" Label="Meta de Ahorro Fondo de Emergencia" ShowLabel="true" Variant="success" />
                <AtlasProgress Value="40" Label="Hábitos Diarios de Hoy" ShowLabel="true" Variant="neutral" />
            </div>

            <AtlasDivider />

            <div class="flex flex-wrap items-center gap-2.5">
                <AtlasBadge Variant="neutral">Neutral</AtlasBadge>
                <AtlasBadge Variant="accent">Accent / Focus</AtlasBadge>
                <AtlasBadge Variant="success">Success State</AtlasBadge>
                <AtlasBadge Variant="warning">Warning Alert</AtlasBadge>
                <AtlasBadge Variant="danger">Error / Overdue</AtlasBadge>
                <AtlasBadge Variant="mono">ID: #89FA3</AtlasBadge>
            </div>
        </div>
    </section>

    <!-- ======================================================================= -->
    <!-- 6. ESTADO VACÍO & SUPERFICIE ELEVADA -->
    <!-- ======================================================================= -->
    <section class="space-y-4">
        <AtlasSectionHeader Title="6. Empty State & Superficie Elevada" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <AtlasEmptyState 
                Title="Sin notas capturadas" 
                Description="Presioná Ctrl+Space para redactar tu primera nota en el sistema.">
                <ActionContent>
                    <AtlasButton Variant="secondary" Size="sm">+ Nueva Nota</AtlasButton>
                </ActionContent>
            </AtlasEmptyState>

            <div class="atlas-surface-elevated p-5 space-y-3 flex flex-col justify-between">
                <div class="space-y-1">
                    <span class="text-[10px] font-mono text-sky-400 uppercase font-semibold">Superficie Elevada (Modal/Overlay)</span>
                    <p class="text-xs text-slate-300">
                        Diseñada para capas flotantes que requieren contraste directo y sombra difusa sin recargar la pantalla.
                    </p>
                </div>
                <div class="flex justify-end">
                    <AtlasButton Variant="primary" Size="sm">Aceptar</AtlasButton>
                </div>
            </div>
        </div>
    </section>

</div>

@code {
    private string? demoInputText;
    private string? demoTokenText = "sk-gemini-live-token-49f";
    private string? demoSearchQuery;
}
