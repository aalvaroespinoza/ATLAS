<Window
    x:Class="ATLAS.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ATLAS.UI.ViewModels"
    mc:Ignorable="d"
    Title="Configuración — ATLAS">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock
                Text="Configuración de IA"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock
                Text="Guardá tu API key de Google Gemini de forma local y segura en Windows Credential Locker."
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Body Form Card -->
        <StackPanel Grid.Row="1" Spacing="16">
            
            <!-- Status Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Google Gemini API Key" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock
                            Text="{x:Bind ViewModel.MaskedKeyDisplay, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    
                    <Button
                        Grid.Column="1"
                        Content="Eliminar"
                        FontSize="12"
                        Command="{x:Bind ViewModel.DeleteKeyCommand}"
                        Visibility="{x:Bind ViewModel.HasConfiguredKey, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- Input & Save -->
            <StackPanel Spacing="8">
                <TextBlock Text="Nueva API Key" FontSize="13" FontWeight="SemiBold" />
                <PasswordBox
                    Password="{x:Bind ViewModel.ApiKeyInput, Mode=TwoWay}"
                    PlaceholderText="Pegá tu API key acá (AIza...)"
                    PasswordChar="•" />
                <TextBlock
                    Text="Podés obtener una clave gratuita en Google AI Studio (aistudio.google.com)."
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <Button
                Content="Guardar en Windows Vault"
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.SaveKeyCommand}"
                Margin="0,4,0,0" />

            <!-- Status Banner -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                IsClosable="False"
                Margin="0,8,0,0" />

        </StackPanel>
    </Grid>
</Window>
