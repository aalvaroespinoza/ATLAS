<Window
    x:Class="ATLAS.UI.Views.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ATLAS.UI.ViewModels"
    mc:Ignorable="d"
    Title="ATLAS Launcher">

    <Grid Background="Transparent">
        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="0"
            Padding="16,12">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Input Box -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE70F;"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,0,12,0" />
                    
                    <TextBox
                        x:Name="InputTextBox"
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="¿Qué querés capturar? (Enter para guardar, Esc para cancelar)"
                        FontSize="16"
                        BorderThickness="0"
                        Background="Transparent"
                        KeyDown="OnInputKeyDown" />

                    <ProgressRing
                        Grid.Column="2"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Width="20"
                        Height="20"
                        Margin="8,0,0,0" />
                </Grid>

                <!-- Error Message Banner -->
                <InfoBar
                    Grid.Row="1"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Margin="0,8,0,0"
                    IsClosable="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
