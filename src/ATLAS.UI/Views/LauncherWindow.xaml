<Window
    x:Class="ATLAS.UI.Views.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ATLAS.UI.ViewModels"
    mc:Ignorable="d"
    Title="ATLAS Launcher">

    <Grid Background="Transparent">
        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="0"
            Padding="16,14">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                
                <!-- Row 0: Input Box -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE70F;"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,0,12,0" />
                    
                    <TextBox
                        x:Name="InputTextBox"
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Buscar notas o escribir para capturar... (Enter para guardar/abrir)"
                        FontSize="16"
                        BorderThickness="0"
                        Background="Transparent"
                        KeyDown="OnInputKeyDown" />

                    <ProgressRing
                        Grid.Column="2"
                        IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                        Width="18"
                        Height="18"
                        Margin="8,0,0,0" />
                </Grid>

                <!-- Row 1: Error Message Banner -->
                <InfoBar
                    Grid.Row="1"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Margin="0,8,0,0"
                    IsClosable="False" />

                <!-- Row 2: Live Search Results List -->
                <ListView
                    x:Name="SearchResultsListView"
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.HasSearchResults, Mode=OneWay}"
                    MaxHeight="260"
                    Margin="0,12,0,0"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnSearchResultItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:NoteItemViewModel">
                            <Grid Padding="8,6" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <!-- Title or Content Preview -->
                                    <TextBlock
                                        Text="{x:Bind DisplayTitle}"
                                        FontWeight="SemiBold"
                                        FontSize="14"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />

                                    <!-- Content Preview (if title exists) -->
                                    <TextBlock
                                        Text="{x:Bind ContentSnippet}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        Visibility="{x:Bind ContentSnippetVisibility}" />

                                    <!-- Tags -->
                                    <TextBlock
                                        Text="{x:Bind Tags}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Visibility="{x:Bind TagsVisibility}" />
                                </StackPanel>

                                <!-- Type badge & Date -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Right">
                                        <TextBlock
                                            Text="{x:Bind Type}"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind FormattedDate}"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Row 3: Expanded Note Detail View -->
                <Grid
                    Grid.Row="3"
                    Visibility="{x:Bind ViewModel.IsExpanded, Mode=OneWay}"
                    Margin="0,12,0,0">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- Note Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ExpandedItem.DisplayTitle, Mode=OneWay}"
                                        FontWeight="Bold"
                                        FontSize="15" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ExpandedItem.Tags, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Visibility="{x:Bind ViewModel.ExpandedItem.TagsVisibility, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="4">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Right">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.ExpandedItem.Type, Mode=OneWay}"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ExpandedItem.FormattedDate, Mode=OneWay}"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <!-- Note Content Body -->
                            <ScrollViewer Grid.Row="1" MaxHeight="160" Margin="0,0,0,8">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ExpandedItem.Note.Content, Mode=OneWay}"
                                    FontSize="13"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </ScrollViewer>

                            <!-- Actions -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    Text="[Esc] Volver a la lista"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    Content="Cerrar"
                                    FontSize="12"
                                    Padding="10,4"
                                    Command="{x:Bind ViewModel.CloseExpandedCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 4: Subtle Bottom Footer Bar -->
                <Grid
                    Grid.Row="4"
                    Visibility="{x:Bind ViewModel.ShowFooterHint, Mode=OneWay}"
                    Margin="0,10,0,0">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="↵ Enter: Capturar nota o abrir seleccionada  •  ↑↓: Navegar  •  Esc: Salir / Volver" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
