<Window
    x:Class="ATLAS.UI.Views.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ATLAS.UI.ViewModels"
    mc:Ignorable="d"
    Title="ATLAS Launcher">

    <Grid Background="Transparent">
        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="0"
            Padding="16,14">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                
                <!-- Row 0: Input Box -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE70F;"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,0,12,0" />
                    
                    <TextBox
                        x:Name="InputTextBox"
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Buscar notas, '? pregunta' a la IA, o escribir para capturar..."
                        FontSize="16"
                        BorderThickness="0"
                        Background="Transparent"
                        KeyDown="OnInputKeyDown" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                            Width="18"
                            Height="18" />
                        <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            Visibility="{x:Bind ViewModel.IsAskMode, Mode=OneWay}">
                            <TextBlock Text="IA Mode (?)" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Error Message Banner -->
                <InfoBar
                    Grid.Row="1"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Margin="0,8,0,0"
                    IsClosable="False" />

                <!-- Row 2: Live Search Results List -->
                <ListView
                    x:Name="SearchResultsListView"
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.HasSearchResults, Mode=OneWay}"
                    MaxHeight="260"
                    Margin="0,12,0,0"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnSearchResultItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:NoteItemViewModel">
                            <Grid Padding="8,6" ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <!-- Title or Content Preview -->
                                    <TextBlock
                                        Text="{x:Bind DisplayTitle}"
                                        FontWeight="SemiBold"
                                        FontSize="14"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />

                                    <!-- Content Preview (if title exists) -->
                                    <TextBlock
                                        Text="{x:Bind ContentSnippet}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        Visibility="{x:Bind ContentSnippetVisibility}" />

                                    <!-- Tags -->
                                    <TextBlock
                                        Text="{x:Bind Tags}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Visibility="{x:Bind TagsVisibility}" />
                                </StackPanel>

                                <!-- Type badge & Date -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Right">
                                        <TextBlock
                                            Text="{x:Bind Type}"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind FormattedDate}"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Row 3: Expanded Note Detail View -->
                <Grid
                    Grid.Row="3"
                    Visibility="{x:Bind ViewModel.IsExpanded, Mode=OneWay}"
                    Margin="0,12,0,0">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- Note Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ExpandedItem.DisplayTitle, Mode=OneWay}"
                                        FontWeight="Bold"
                                        FontSize="15" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ExpandedItem.Tags, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Visibility="{x:Bind ViewModel.ExpandedItem.TagsVisibility, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="4">
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Right">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.ExpandedItem.Type, Mode=OneWay}"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ExpandedItem.FormattedDate, Mode=OneWay}"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <!-- Note Content Body -->
                            <ScrollViewer Grid.Row="1" MaxHeight="140" Margin="0,0,0,10">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ExpandedItem.Note.Content, Mode=OneWay}"
                                    FontSize="13"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </ScrollViewer>

                            <!-- Actions Bar inside Expanded View -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                                <Button
                                    Grid.Column="0"
                                    Command="{x:Bind ViewModel.SummarizeExpandedNoteCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    FontSize="12"
                                    Padding="10,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE946;" FontSize="13" />
                                        <TextBlock Text="Resumir con IA" />
                                    </StackPanel>
                                </Button>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="[Esc] Volver"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center"
                                    Margin="14,0,0,0" />

                                <Button
                                    Grid.Column="2"
                                    Content="Cerrar"
                                    FontSize="12"
                                    Padding="10,4"
                                    Command="{x:Bind ViewModel.CloseExpandedCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 4: AI Thinking / AI Result View -->
                <Grid
                    Grid.Row="4"
                    Visibility="{x:Bind ViewModel.IsShowingAiResult, Mode=OneWay}"
                    Margin="0,12,0,0">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                        <Grid RowDefinitions="Auto,*,Auto">
                            
                            <!-- Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind ViewModel.AiModeTitle, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    TextTrimming="CharacterEllipsis" />
                                
                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="6,2">
                                    <TextBlock Text="Gemini 1.5 Flash" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <!-- Thinking Indicator -->
                            <StackPanel
                                Grid.Row="1"
                                Visibility="{x:Bind ViewModel.IsAiThinking, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="10"
                                Padding="8,16"
                                HorizontalAlignment="Center">
                                <ProgressRing IsActive="True" Width="20" Height="20" />
                                <TextBlock Text="Pensando con Google Gemini..." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Generated Content Body -->
                            <ScrollViewer
                                Grid.Row="1"
                                MaxHeight="160"
                                Margin="0,0,0,8"
                                Visibility="{x:Bind ViewModel.IsAiResultReady, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.AiResponse, Mode=OneWay}"
                                    FontSize="13"
                                    LineHeight="20"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </ScrollViewer>

                            <!-- Footer Actions -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock
                                    Grid.Column="0"
                                    Text="[Enter / Esc] Cerrar respuesta"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    Content="Listo"
                                    FontSize="12"
                                    Padding="12,4"
                                    Command="{x:Bind ViewModel.CloseAiResultCommand}" />
                            </Grid>

                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 5: Subtle Bottom Footer Bar -->
                <Grid
                    Grid.Row="5"
                    Visibility="{x:Bind ViewModel.ShowFooterHint, Mode=OneWay}"
                    Margin="0,10,0,0"
                    ColumnDefinitions="*,Auto">
                    <TextBlock
                        Grid.Column="0"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center"
                        Text="↵ Enter: Guardar / Abrir / Preguntar  •  ? Preguntar a IA  •  Esc: Salir" />
                    
                    <HyperlinkButton
                        Grid.Column="1"
                        FontSize="11"
                        Padding="4,0"
                        Command="{x:Bind ViewModel.OpenActivityCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE81C;" FontSize="11" />
                            <TextBlock Text="Actividad (Ctrl+Shift+Space)" />
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
