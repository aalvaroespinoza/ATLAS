<Window
    x:Class="ATLAS.UI.Views.ActivityWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ATLAS.UI.ViewModels"
    mc:Ignorable="d"
    Title="Actividad — ATLAS">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid
            Grid.Row="0"
            Padding="24,18,24,14"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    Text="Actividad"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="{x:Bind ViewModel.NotesCountText, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Width="18"
                    Height="18" />
                <Button
                    Command="{x:Bind ViewModel.LoadNotesCommand}"
                    ToolTipService.ToolTip="Actualizar notas">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Actualizar" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    ToolTipService.ToolTip="Configuración de IA">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="Ajustes" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            
            <!-- Empty State -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.HasNoNotes, Mode=OneWay}">
                <FontIcon
                    Glyph="&#xE70F;"
                    FontSize="42"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Text="No hay notas guardadas todavía"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Presioná Ctrl + Space en cualquier momento para capturar una nota rápida."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Notes Split View (List + Detail) -->
            <Grid
                Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}"
                ColumnDefinitions="360,*">
                
                <!-- Left: Notes List -->
                <Border
                    Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                    <ListView
                        ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                        SelectionMode="Single"
                        Padding="8">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:NoteItemViewModel">
                                <Grid Padding="10,8" Margin="0,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Title -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{x:Bind DisplayTitle}"
                                        FontWeight="SemiBold"
                                        FontSize="14"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />

                                    <!-- Date -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{x:Bind FormattedDate}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Right" />

                                    <!-- Content snippet -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Text="{x:Bind ContentSnippet}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2"
                                        Margin="0,3,0,0"
                                        Visibility="{x:Bind ContentSnippetVisibility}" />

                                    <!-- Tags & Type -->
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,4,0,0">
                                        <Border
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="6,1">
                                            <TextBlock
                                                Text="{x:Bind Type}"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                        <TextBlock
                                            Text="{x:Bind Tags}"
                                            FontSize="11"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Visibility="{x:Bind TagsVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- Right: Selected Note Detail -->
                <Grid Grid.Column="1" Padding="28,20">
                    <Grid RowDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">
                        
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind ViewModel.SelectedNote.DisplayTitle, Mode=OneWay}"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap" />
                                
                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    VerticalAlignment="Top">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedNote.Type, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedNote.FormattedDate, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedNote.Tags, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Visibility="{x:Bind ViewModel.SelectedNote.TagsVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Body Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedNote.Note.Content, Mode=OneWay}"
                                FontSize="14"
                                LineHeight="22"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </ScrollViewer>

                        <!-- Footer Info -->
                        <Grid Grid.Row="2" Margin="0,16,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <TextBlock
                                Text="Solo lectura  •  ATLAS Knowledge"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>

                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
