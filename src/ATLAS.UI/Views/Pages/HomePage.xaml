<Page
    x:Class="ATLAS.UI.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ATLAS.UI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock
                    Text="{x:Bind ViewModel.GreetingText, Mode=OneWay}"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="Tu resumen personal de hoy en ATLAS OS."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 2x2 Interactive Cards Grid -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20">

                <!-- CARD 1: HÁBITOS DE HOY -->
                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="0"
                    CornerRadius="8"
                    Command="{x:Bind ViewModel.NavigateToSectionCommand}"
                    CommandParameter="habits_goals">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="HÁBITOS DE HOY" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <SymbolIcon Grid.Column="1" Symbol="Calendar" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <TextBlock Text="{x:Bind ViewModel.HabitsProgressText, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                            <ProgressBar Value="{x:Bind ViewModel.HabitsProgressPercent, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" />

                            <TextBlock Text="{x:Bind ViewModel.NextPendingHabitText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- CARD 2: METAS ACTIVAS -->
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="0"
                    CornerRadius="8"
                    Command="{x:Bind ViewModel.NavigateToSectionCommand}"
                    CommandParameter="habits_goals">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="METAS EN FOCO" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <SymbolIcon Grid.Column="1" Symbol="Target" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <ListView ItemsSource="{x:Bind ViewModel.ActiveGoals}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:GoalActiveItemViewModel">
                                        <Grid Padding="0,4" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ProgressText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                Text="Sin metas activas registradas."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind ViewModel.HasNoGoalsVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Button>

                <!-- CARD 3: BALANCE FINANCIERO -->
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="0"
                    CornerRadius="8"
                    Command="{x:Bind ViewModel.NavigateToSectionCommand}"
                    CommandParameter="finance">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="BALANCE (ÚLTIMOS 30 DÍAS)" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <SymbolIcon Grid.Column="1" Symbol="Shop" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <TextBlock Text="{x:Bind ViewModel.NetBalanceText, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.FinanceDetailsText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- Native 7-Day Bar Chart -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FinanceDailyBars}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom" Height="58" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:DailyFinanceBarItem">
                                        <StackPanel Spacing="3" VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind ToolTipText}">
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                                                <!-- Expense Bar -->
                                                <Rectangle
                                                    Width="7"
                                                    Height="{x:Bind ExpenseHeightPx}"
                                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                                <!-- Income Bar -->
                                                <Rectangle
                                                    Width="7"
                                                    Height="{x:Bind IncomeHeightPx}"
                                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind DayLabel}" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- CARD 4: SEGUNDO CEREBRO (CAPTURAS) -->
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="0"
                    CornerRadius="8"
                    Command="{x:Bind ViewModel.NavigateToSectionCommand}"
                    CommandParameter="search">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="CAPTURAS RECIENTES" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <SymbolIcon Grid.Column="1" Symbol="Find" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <ListView ItemsSource="{x:Bind ViewModel.RecentNotes}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:NoteItemViewModel">
                                        <Grid Padding="0,3" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedDate}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                Text="No hay notas capturadas todavía."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind ViewModel.HasNoNotesVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Button>

            </Grid>

            <!-- Quick Action Bar -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="ACCIONES RÁPIDAS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                    <Button
                        Grid.Column="2"
                        Content="+ Capturar Nota"
                        Command="{x:Bind ViewModel.NavigateToSectionCommand}"
                        CommandParameter="capture" />

                    <Button
                        Grid.Column="3"
                        Content="-$ Registrar Gasto"
                        Command="{x:Bind ViewModel.NavigateToSectionCommand}"
                        CommandParameter="finance" />

                    <Button
                        Grid.Column="4"
                        Content="Ctrl+Space Launcher"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnOpenLauncherClicked" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
