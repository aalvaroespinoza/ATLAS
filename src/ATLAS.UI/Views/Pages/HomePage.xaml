<Page
    x:Class="ATLAS.UI.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Inicio" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Resumen de hoy en ATLAS Personal OS." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Bienvenido a ATLAS" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Tu sistema operativo personal centralizado, local-first y privado."
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Presioná Ctrl+Space en cualquier momento para abrir el Launcher de captura rápida y comandos."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
