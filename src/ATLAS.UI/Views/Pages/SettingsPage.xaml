<Page
    x:Class="ATLAS.UI.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ATLAS.UI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="600" HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock
                    Text="Configuración e Integraciones"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="Tus credenciales se almacenan de forma local y segura en Windows Credential Locker (DPAPI)."
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Feedback InfoBar -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                IsClosable="False" />

            <!-- SECTION 1: Google Gemini API -->
            <StackPanel Spacing="12">
                <TextBlock
                    Text="GOOGLE GEMINI (IA CLOUD)"
                    FontSize="11"
                    FontWeight="SemiBold"
                    CharacterSpacing="60"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <!-- Status Display -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="API Key actual" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock
                                Text="{x:Bind ViewModel.MaskedGeminiKeyDisplay, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        
                        <Button
                            Grid.Column="1"
                            Content="Eliminar"
                            FontSize="12"
                            Command="{x:Bind ViewModel.DeleteGeminiKeyCommand}"
                            Visibility="{x:Bind ViewModel.DeleteGeminiButtonVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- Input & Save -->
                <StackPanel Spacing="6">
                    <PasswordBox
                        Password="{x:Bind ViewModel.GeminiApiKeyInput, Mode=TwoWay}"
                        PlaceholderText="Pegá tu API key acá (AIza...)"
                        PasswordChar="•" />
                    <TextBlock
                        Text="Podés obtener una clave gratuita en Google AI Studio (aistudio.google.com)."
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <Button
                    Content="Guardar Gemini Key"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.SaveGeminiKeyCommand}" />
            </StackPanel>

            <MenuFlyoutSeparator />

            <!-- SECTION 2: Telegram Bot -->
            <StackPanel Spacing="12">
                <TextBlock
                    Text="TELEGRAM BOT"
                    FontSize="11"
                    FontWeight="SemiBold"
                    CharacterSpacing="60"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <!-- Status Display -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Bot Token actual" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock
                                Text="{x:Bind ViewModel.MaskedTelegramTokenDisplay, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        
                        <Button
                            Grid.Column="1"
                            Content="Eliminar"
                            FontSize="12"
                            Command="{x:Bind ViewModel.DeleteTelegramTokenCommand}"
                            Visibility="{x:Bind ViewModel.DeleteTelegramButtonVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- Input & Save -->
                <StackPanel Spacing="6">
                    <PasswordBox
                        Password="{x:Bind ViewModel.TelegramTokenInput, Mode=TwoWay}"
                        PlaceholderText="Pegá el token de tu bot acá (123456:ABC...)"
                        PasswordChar="•" />
                    <TextBlock
                        Text="Creá tu bot en Telegram con @BotFather (/newbot) y pegá el HTTP API Token resultante."
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <Button
                    Content="Guardar Telegram Token"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.SaveTelegramTokenCommand}" />
            </StackPanel>

            <MenuFlyoutSeparator />

            <!-- SECTION 3: Mercado Pago -->
            <StackPanel Spacing="12">
                <TextBlock
                    Text="MERCADO PAGO"
                    FontSize="11"
                    FontWeight="SemiBold"
                    CharacterSpacing="60"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <!-- Status Display -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Access Token actual" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock
                                Text="{x:Bind ViewModel.MaskedMercadoPagoTokenDisplay, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        
                        <Button
                            Grid.Column="1"
                            Content="Eliminar"
                            FontSize="12"
                            Command="{x:Bind ViewModel.DeleteMercadoPagoTokenCommand}"
                            Visibility="{x:Bind ViewModel.DeleteMercadoPagoButtonVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- Input & Save -->
                <StackPanel Spacing="6">
                    <PasswordBox
                        Password="{x:Bind ViewModel.MercadoPagoTokenInput, Mode=TwoWay}"
                        PlaceholderText="Pegá tu Personal Access Token (APP_USR-...)"
                        PasswordChar="•" />
                    <TextBlock
                        Text="Obtené tu Access Token de producción en el panel de desarrolladores de Mercado Pago."
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <Button
                    Content="Guardar Mercado Pago Token"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.SaveMercadoPagoTokenCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
