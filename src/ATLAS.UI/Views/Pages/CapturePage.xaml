<Page
    x:Class="ATLAS.UI.Views.Pages.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ATLAS.UI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="750" HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Capturar" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Redactá y guardá notas, ideas o conocimiento en tu Second Brain." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Feedback InfoBar -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                IsClosable="False" />

            <!-- Input Form -->
            <StackPanel Spacing="16">
                <!-- Title (Optional) -->
                <TextBox
                    Header="Título (opcional)"
                    PlaceholderText="Ej: Resumen reunión semanal, Idea de proyecto..."
                    Text="{x:Bind ViewModel.TitleInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Content (Required) -->
                <TextBox
                    Header="Contenido"
                    PlaceholderText="Escribí tu nota o pensamiento acá..."
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="180"
                    MaxHeight="360"
                    Text="{x:Bind ViewModel.ContentInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Tags (Optional) -->
                <TextBox
                    Header="Tags (opcional, separados por coma o espacio)"
                    PlaceholderText="Ej: trabajo, ideas, lectura"
                    Text="{x:Bind ViewModel.TagsInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Action Bar -->
                <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*">
                    <Button
                        Grid.Column="0"
                        Content="Guardar Nota"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveNoteCommand}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="1"
                        Text="Tip: También podés capturar desde cualquier lugar presionando Ctrl+Space."
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
