<Page
    x:Class="ATLAS.UI.Views.Pages.FinancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ATLAS.UI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="24" MaxWidth="850" HorizontalAlignment="Left">

            <!-- Header & Sync Action -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Finanzas" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Control de movimientos, gastos y sincronización con Mercado Pago." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="Sincronizar Mercado Pago"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SyncMercadoPagoCommand}" />
            </Grid>

            <!-- Feedback InfoBar -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                IsClosable="False" />

            <!-- Sync Loading Indicator -->
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsSyncingVisibility, Mode=OneWay}" />

            <!-- Summary Metric Cards -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <!-- Card 1: Balance Neto -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="BALANCE NETO" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.NetBalanceFormatted, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Total Gastos -->
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL GASTOS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalExpensesFormatted, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Total Ingresos -->
                <Border
                    Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL INGRESOS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalIncomeFormatted, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 14-Day Visual Breakdown Chart -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="TENDENCIA DE MOVIMIENTOS (ÚLTIMOS 14 DÍAS)" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Gastos" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Ingresos" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FinanceDailyBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom" Height="80" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:DailyFinanceBarItem">
                                    <StackPanel Spacing="4" VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind ToolTipText}">
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom">
                                            <Rectangle
                                                Width="9"
                                                Height="{x:Bind ExpenseHeightPx}"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                RadiusX="2"
                                                RadiusY="2" />
                                            <Rectangle
                                                Width="9"
                                                Height="{x:Bind IncomeHeightPx}"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                RadiusX="2"
                                                RadiusY="2" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind DayLabel}" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Quick Add Expense -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="REGISTRAR NUEVO GASTO" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                    <Grid ColumnDefinitions="140,*,180,Auto" ColumnSpacing="10">
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="Monto ($)"
                            Text="{x:Bind ViewModel.NewExpenseAmountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            Grid.Column="1"
                            PlaceholderText="Descripción (ej: Supermercado, Nafta)..."
                            Text="{x:Bind ViewModel.NewExpenseDescriptionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            Grid.Column="2"
                            PlaceholderText="Categoría (opcional)"
                            Text="{x:Bind ViewModel.NewExpenseCategoryInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            Grid.Column="3"
                            Content="Registrar"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.AddExpenseCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recent Transactions List -->
            <StackPanel Spacing="12">
                <TextBlock Text="MOVIMIENTOS RECIENTES" FontSize="11" FontWeight="SemiBold" CharacterSpacing="50" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                    <StackPanel Spacing="8">
                        <ListView
                            ItemsSource="{x:Bind ViewModel.Transactions}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:TransactionItemViewModel">
                                    <Grid Padding="4,8" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Description}" FontWeight="SemiBold" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind FormattedDate}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind OriginBadge}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind CategoryDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind FormattedAmount}"
                                            FontWeight="Bold"
                                            FontSize="14"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Text="No hay transacciones registradas todavía."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            Padding="0,16"
                            Visibility="{x:Bind ViewModel.HasNoTransactionsVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
